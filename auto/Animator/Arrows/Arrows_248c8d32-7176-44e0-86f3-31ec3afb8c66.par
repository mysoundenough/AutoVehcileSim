ADD_REFERENCE_FRAME wheel L1 indicator: Paint Tire Path (Black)
SET_RUN_COLOR black
PARSFILE Animator\STL\Shape_cbeb61e2-0787-4c7e-b4d8-b6e0b7f413d9.par
SET_EULER_ANGLES yaw_pitch_roll
