PARSFILE
#FullDataName Animator: Wheel Arrows and Other Indicators`Paint Tire Path (Black)`Tire Paths
#CheckBox0 0    
#CheckBox1 1    
#CheckBox4 0    

#RingCtrl0 2
#RingCtrl1 T
#RingCtrl2 B
#RingCtrl3 1
*OFFSET_Z 0
*COLOR_1 black
*ID_AXLE 1

#MiscYellow0
default_ghost off ! disable ghosts for vehicle
ghost_count 250 ! number of markers
ghost_period -0.05
#ENDMYellow

#MiscYellow1
#reference_frame_ghosts on
#DEFINE_OUTPUT VYaw_? =  IF(VxCen? > 0, Yaw_? + Alpha_?, pi + Yaw_? -Alpha_?); deg ; Tire mark ? yaw
#SET_YAW_NAME VYaw_?
#WRT_VYaw_?
#ANI_VYaw_?
#ENDMYellow

