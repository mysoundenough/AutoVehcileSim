DEFINE_OUTPUT VYaw_L1 =  IF(VxCenL1 > 0, Yaw_L1 + Alpha_L1, pi + Yaw_L1 -Alpha_L1); deg ; Tire mark L1 yaw
SET_YAW_NAME VYaw_L1
