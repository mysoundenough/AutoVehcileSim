#Selection_2 Title: Vehicle In-Lane Detected: AlX 0 AlY 0
#Selection_3 Scale 1.000000 locX 16 locY 56
#Selection_4 Fixed: 1 VarName:   ColorStr: 0.8 1 1
#Selection_5 ImgName: 
ANI_
WRT_
ADD_ENTITY hud_text Text Output
location 16 56 18 18
align_x left
align_y top
size_mode absolute
place_mode absolute
# var name is 
prefix Vehicle In-Lane Detected:
min_width_prefix 20
color 0.8 1 1 1.0
END_ENTITY hud_text Text Output
#Selection 9 for Icon 1
