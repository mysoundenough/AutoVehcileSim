#Selection_4 Fixed: 1 VarName: if(vehObjInLane, 0, 1)  ColorStr: 0 0 0
#Selection_5 ImgName: Animator\2D_HUD_Icons\Indicator_Lamp\RectangleLIGHT_OFF.dds
! General Icon
ANI_if(vehObjInLane, 0, 1)
WRT_if(vehObjInLane, 0, 1)
ADD_ENTITY hud_image General Icon
location 304 32 128 128
align_x left
align_y top
size_mode absolute
place_mode absolute
opacity if(vehObjInLane, 0, 1)
image_file Animator\2D_HUD_Icons\Indicator_Lamp\RectangleLIGHT_OFF.dds
END_ENTITY hud_image General Icon
