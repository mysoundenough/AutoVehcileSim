#Selection_5 ImgName: Animator\2D_HUD_Icons\Indicator_Lamp\RectangleLIGHT_ON.dds
! General Icon
ANI_vehObjInLane*1.5
WRT_vehObjInLane*1.5
ADD_ENTITY hud_image General Icon
location 304 32 128 128
align_x left
align_y top
size_mode absolute
place_mode absolute
opacity vehObjInLane*1.5
image_file Animator\2D_HUD_Icons\Indicator_Lamp\RectangleLIGHT_ON.dds
END_ENTITY hud_image General Icon
#Selection 9 for Icon 2
