PARSFILE
#FullDataName Events`A. Bode Analysis for Steer Torque Input`Linearization
#CheckBox1 0    
#CheckBox6 0    
#CheckBox7 0    
#CheckBox9 0    
#CheckBox10 0    

#RingCtrl0 >
#RingCtrl10 1
#RingCtrl11 4
*NAME1 t
*VALUE1 10
#MiscYellow0
linear_control IMP_STEER_T_IN
linear_output EXP_AVz
linear_output EXP_AY
#ENDMYellow

MAKE_EVENT t > 10 ; Events\Events_5a16f785-db71-4d8f-a0e2-b8efa57d1ff2.par
#BlueLink0 Events`B. Linearize (Steer Torque Input)` Linearization` , Events`Events_5a16f785-db71-4d8f-a0e2-b8efa57d1ff2

SET_EVENT_ID 0 ! reset to default

#EMBEDDED_NOTES
#This dataset specifies that the input for the model will be steering wheel torque.
#
#The linearization is applied after 10 seconds from the simulation started in order to wait for the vehicle to come to a steady-state condition after the math model initialization.
#END_EMBEDDED_NOTES

