PARSFILE
#FullDataName Events`CCRm,s F2. Reset Veh. and Targets, ACC`Euro NCAP ACC Testing
#CheckBox1 1    
*CLEAR
#CheckBox2 1    
#CheckBox3 0    
#CheckBox4 1    
#CheckBox5 1    
#CheckBox6 1    
#CheckBox7 0    
#CheckBox9 0    
#CheckBox10 0    

#RingCtrl0 ZERO ~=
#RingCtrl10 1
#RingCtrl11 4
RESET_EVENTS
*NAME1 Event
*VALUE1 1
*VALUE2 1
*SPEED VUT_START
OPT_INIT_CONFIG 1
OPT_INIT_PATH 0
OPT_INIT_SPEED 1
#MiscYellow0
SPEED_TARGET_GAIN(1) = 1
Contact = 0
! Unchecked box for "reset vehicle x,y,yaw"
! Locate vehicle 2m to the left of the road center
Xo  = VUT_START_STATION
Yo = -2
Yaw = 0
#ENDMYellow

#BlueLink10 ` , Miscellaneous` , Miscellaneous` , Miscellaneous`


! Reset all open-loop control clocks by setting parameters to current time
TSTART_T_EVENT = T ;
TSTART_STEER_TQ = T ;
TSTART_F_BRAKE_PEDAL = T ;
TSTART_PBK_CON = T ;
TSTART_CLUTCH = T ;
TSTART_GEAR = T ;
TSTART_SPEED_TARGET = T ;
TSTART_STEER = T ;
TSTART_THROTTLE = T ;
TSTART_TRANS = T ;
TSTART_WIND = T ;
#MiscYellow1
! The location of the obstacles need to be reset after each run
! This needs to occur, AFTER all of the Event resets are complete
! Note: the object numbers should match the two vehicle and GVT in the 
! Echo file
S_OBJ_38 = SSTART_GVT
#ENDMYellow

DEFINE_EVENT 1 ; Events\Events_2486a61d-9c0d-48f6-aad6-9bf4343dec69.par
#BlueLink0 Events`CCRm,s A. Wait for ACC to Intervene` Euro NCAP ACC Testing` , Events`Events_2486a61d-9c0d-48f6-aad6-9bf4343dec69

SET_EVENT_ID 0 ! reset to default

#EMBEDDED_NOTES
#The initialization options are checked for speed, springs, and control clocks
#- Vehicle position is reset manually because:
#   - The VUT start station is a paramter could change by user setting
#   - The vehicle is using a lane-keeping assistance system (LKAS) to maintain its lane position without a driver model, so the lateral position of the vehicle at the start of the test must be manually set
#
#
#
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Events; { Euro NCAP ACC Testing } CCRm,s F2. Reset Veh. and Targets, ACC
#Library : Events
#DataSet : CCRm,s F2. Reset Veh. and Targets, ACC
#Category: Euro NCAP ACC Testing
