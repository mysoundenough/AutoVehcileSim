PARSFILE
#FullDataName Events`AEB CCRm,s E. New Test, Increase Speed`Euro NCAP AEB Testing
#CheckBox1 1    
*CLEAR
#CheckBox6 0    
#CheckBox7 0    
#CheckBox9 0    
#CheckBox10 0    

#RingCtrl0 <=
#RingCtrl1 >
#RingCtrl10 2
#RingCtrl11 4
RESET_EVENTS
*NAME1 VUT_START
*NAME2 VUT_START
*VALUE1 MAX_TEST_SPD+MIN_THRESH
*VALUE2 MAX_TEST_SPD+MIN_THRESH
#MiscYellow0
VUT_START = VUT_START + (10/3.6);
! increase score, one full point
SCORE_NEW = SCORE_OLD + 1
SCORE_OLD = SCORE_NEW
#ENDMYellow

#BlueLink10 ` , Miscellaneous` , Miscellaneous` , Miscellaneous`

MAKE_EVENT VUT_START <= MAX_TEST_SPD+MIN_THRESH ; Events\Events_f6e68474-72ca-4764-aea1-3503b932a712.par
#BlueLink0 Events`AEB CCRm,s F2. Reset Veh. and Targets` Euro NCAP AEB Testing` , Events`Events_f6e68474-72ca-4764-aea1-3503b932a712

MAKE_EVENT VUT_START > MAX_TEST_SPD+MIN_THRESH ; Events\Events_850c1411-e276-4b75-a833-0b8e200f164c.par
#BlueLink1 Events`AEB CCRm,s D. Pause before ending` Euro NCAP AEB Testing` , Events`Events_850c1411-e276-4b75-a833-0b8e200f164c

SET_EVENT_ID 0 ! reset to default

#EMBEDDED_NOTES
#Reset VUT_START to 10 km/h higher than previous initial speed.
#Reset target vehicle starting location.
#
#If The final run has been completed already, end the test
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Events; { Euro NCAP AEB Testing } AEB CCRm,s E. New Test, Increase Speed
