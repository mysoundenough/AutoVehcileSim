PARSFILE
#FullDataName Events`Check AEB Final Run Coll., 50%, Bicyclist`Pedestrian Euro NCAP
#CheckBox1 1    
*CLEAR
#CheckBox6 0    
#CheckBox7 0    
#CheckBox9 0    
#CheckBox10 0    

#RingCtrl0 >=
#RingCtrl1 <
#RingCtrl10 2
#RingCtrl11 4
RESET_EVENTS
*NAME1 END_FINAL_RUN
*NAME2 END_FINAL_RUN
*VALUE1 1
*VALUE2 1
#MiscYellow0
AEB_ON_COLLIDE = 1 
END_FINAL_RUN = if ( (FINAL_AEB_TEST & AEB_OnTestSuccess) | (FINAL_AEB_TEST & AEB_ON_COLLIDE ), 1, 0)
#ENDMYellow

MAKE_EVENT END_FINAL_RUN >= 1 ; Events\Events_ea969e12-443d-4590-84d1-e4d34c5706fc.par
#BlueLink0 Events`End Last Run` Pedestrian Euro NCAP` , Events`Events_ea969e12-443d-4590-84d1-e4d34c5706fc

MAKE_EVENT END_FINAL_RUN < 1 ; Events\Events_d4fd4281-766f-4cff-804f-82bcda0ce0e8.par
#BlueLink1 Events`Note Collision, 50%, Bicyclist` Pedestrian Euro NCAP` , Events`Events_d4fd4281-766f-4cff-804f-82bcda0ce0e8

SET_EVENT_ID 0 ! reset to default

#EMBEDDED_NOTES
#Clear existing events here, so that Check AEB Final Run isn't triggered twice at the end of the entire test
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Events; { Pedestrian Euro NCAP } Check AEB Final Run Coll., 50%, Bicyclist
