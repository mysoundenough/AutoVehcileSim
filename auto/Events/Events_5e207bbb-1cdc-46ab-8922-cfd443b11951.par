#CheckBox10 0    

#RingCtrl0 >=
#RingCtrl10 1
#RingCtrl11 4
RESET_EVENTS
*NAME1 t_event
*VALUE1 T_WAIT
#MiscYellow0
TSTART_T_EVENT = T
DEFINE_PARAMETER T_WAIT = 0.5; s; wait a ...
a little before moving to the next event
COL_TEST_DONE = 1
INITIAL_COL = if(StrikePercentDiff < STRIKE_THRESH ,1, 0);
#ENDMYellow

MAKE_EVENT t_event >= T_WAIT ; Events\Events_886becbd-a639-4985-9d83-96f37bd887a6.par
#BlueLink0 Events`Check 50% Collision, Child` Pedestrian Euro NCAP` , Events`Events_886becbd-a639-4985-9d83-96f37bd887a6

