PARSFILE
#FullDataName Events`Start AEB Run, 25%, Adult`Pedestrian Euro NCAP
#CheckBox1 1    
*CLEAR
#CheckBox6 0    
#CheckBox7 0    
#CheckBox9 0    
#CheckBox10 0    

#RingCtrl0 >=
#RingCtrl1 >=
#RingCtrl10 2
#RingCtrl11 4
RESET_EVENTS
*NAME1 AEB_OnTestSuccess
*NAME2 Collided
*VALUE1 1
*VALUE2 1
#MiscYellow1
RESET_COMPLETE = 0

FINAL_AEB_TEST = if(VEH_SPD_INIT >= 60/3.6, 1, 0)
END_FINAL_RUN = if ( (FINAL_AEB_TEST & AEB_OnTestSuccess) | (FINAL_AEB_TEST & AEB_ON_COLLIDE), 1, 0)
#ENDMYellow

MAKE_EVENT AEB_OnTestSuccess >= 1 ; Events\Events_b95515ff-4746-4b3e-8242-a447587f9404.par
#BlueLink0 Events`Check AEB Final Run, 25%, Adult` Pedestrian Euro NCAP` , Events`Events_b95515ff-4746-4b3e-8242-a447587f9404

MAKE_EVENT Collided >= 1 ; Events\Events_a3ca5cc5-55bc-4293-8130-f1bad5dc221b.par
#BlueLink1 Events`Check AEB Final Run Collide, 25%, Adult` Pedestrian Euro NCAP` , Events`Events_a3ca5cc5-55bc-4293-8130-f1bad5dc221b

SET_EVENT_ID 0 ! reset to default

#EMBEDDED_NOTES
#Start test run with AEB On
#END_EMBEDDED_NOTES

