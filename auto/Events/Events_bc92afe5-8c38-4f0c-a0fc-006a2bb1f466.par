PARSFILE
#FullDataName Events`B. Initialize AEB On Test, 50%, Child`Pedestrian Euro NCAP
#CheckBox1 1    
*CLEAR
#CheckBox6 0    
#CheckBox7 0    
#CheckBox9 0    
#CheckBox10 0    

#RingCtrl0 >=
#RingCtrl10 1
#RingCtrl11 4
RESET_EVENTS
*NAME1 READY_FOR_AEB_TEST
*VALUE1 1
#MiscYellow0
READY_FOR_AEB_TEST = ...
if(RESET_COMPLETE & AEB_On, 1, 0)
END_FINAL_RUN = if ( (FINAL_AEB_TEST & AEB_OnTestSuccess) | (FINAL_AEB_TEST & AEB_ON_COLLIDE), 1, 0)
#ENDMYellow

MAKE_EVENT READY_FOR_AEB_TEST >= 1 ; Events\Events_90e98a22-aa1d-4879-b46e-8c0db865525f.par
#BlueLink0 Events`Start AEB Run, 50%, Child` Pedestrian Euro NCAP` , Events`Events_90e98a22-aa1d-4879-b46e-8c0db865525f

SET_EVENT_ID 0 ! reset to default

#EMBEDDED_NOTES
#The initial vehicle-to-pedestrian collision test has completed
#- A final check should occur to determine if it is okay to proceed with the first AEB on test
#- The event flag indicating whether the final run has ended, should also be updated
#END_EMBEDDED_NOTES

