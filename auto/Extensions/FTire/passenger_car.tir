$---------------------------------------------------------------------MDI_HEADER
[MDI_HEADER]
 FILE_TYPE =                'tir'
 FILE_VERSION =             7.0
 FILE_FORMAT =              'ASCII'                            $ TeimOrbit
 WRITTEN_BY_COSIN_VERSION = '2023-4-28834-1'

(COMMENTS)
{comment_string}
 'Tire Manufacturer         n/a'
 'Tire Type                 n/a'
 'Tire Dimension            205/55R16 90T 6.5J'
 'Pressure                  2.50 & 3.75 bar'
 'Generation Date           2022-11-30'
 'Last Modification Date    2024-03-26 11:33:52'

$--------------------------------------------------------------------------UNITS
[UNITS]
 FORCE =                    'newton'
 MASS =                     'kg'
 LENGTH =                   'mm'
 TIME =                     'sec'
 ANGLE =                    'deg'

$----------------------------------------------------------------------DOE_PARAM
[DOE_PARAM]
$use up to 20 factors p1, p2, p3,.. to modify parameters in [FTIRE_DATA]
$these values might be overwritten, depending on environment
 p1 =                              1                      $ -
 p2 =                              1                      $ -
 p3 =                              1                      $ -
 p4 =                              1                      $ -
$etc.

$--------------------------------------------------------------------------SHAPE
[SHAPE]
$these data are not used by FTire, but only by some 3rd-party solvers
{radial width}
  1.0    0.0
  1.0    0.4
  1.0    0.9
  0.9    1.0

$----------------------------------------------------------------------DIMENSION
[DIMENSION]
$these data are not used by FTire, but only by some 3rd-party solvers
 unloaded_radius =                 315.949                $ mm
 width =                           205                    $ mm
 aspect_ratio =                    0.55                   $ -
 rim_radius =                      203.2                  $ mm
 rim_width =                       165.1                  $ mm

$-----------------------------------------------------------------------VERTICAL
[VERTICAL]
$these data are not used by FTire, but only by some 3rd-party solvers
 vertical_stiffness =              218.212                $ N/mm
 vertical_damping =                0                      $ Ns/mm

$--------------------------------------------------------------------------MODEL
[MODEL]
 property_file_format =            'FTIRE'
