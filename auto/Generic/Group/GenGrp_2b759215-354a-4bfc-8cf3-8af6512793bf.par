#MiscYellow5
define_output LxBumperRadar =  LX_F_SM - X_SENSOR ; ...
  m; Bumper dist from camera
#ENDMYellow

PARSFILE Sensors_Traffic\Type_Map\TypeMap_8f925db1-d08f-44ac-b963-a832ea28e916.par
#BlueLink5 Sensor Reflectiveness Map`2 Sensor Types, 2 Material Types` ` , Link 6`TypeMap_8f925db1-d08f-44ac-b963-a832ea28e916


#MiscYellow6
!Set ACC desired speed
DEFINE_PARAMETER SPEED_LIMIT = 55; km/h ; Top speed limit for ACC
EQ_INIT SPEED_LIMIT = speed_target(station,t,1);
define_output speedLimitOut = SPEED_LIMIT; km/h; ACC set speed

DEFINE_PARAMETER LANE_WIDTH = 4; m; defined lane width
#ENDMYellow

