#BlueLink1 ADAS Sensors for Range and Tracking`Pedestrian Camera General AEB` Forward Facing Sensors: FCW and ACC` , Link 2`Radar_2ed5a2e9-17eb-462a-a97d-4068ea6f56a6


#MiscYellow2
! the first sensor is the vehicle camera
DEFINE_PARAMETER ID_CAM = ISENSOR; - ; ...
number assigned to the camera sensor
define_output LxBumper =  LX_F_SM - X_SENSOR ; ...
  m; Bumper dist from camera
#ENDMYellow

PARSFILE Generic\VS_commands\GenVS_fc2fda9a-48af-44b2-9dc7-303db24ac864.par
