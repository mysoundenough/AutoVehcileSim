PARSFILE
#FullDataName Generic VS Commands`03 - Roll - Move to max roll`K&C Test Sequence
#VehCode VS Commands

#MiscYellow0
! Reverse direction of roll
JNC_RATE = -JNC_RATE

! reset the limit switches
at_min_1 = 0
at_min_2 = 0
at_max_1 = 0
at_max_2 = 0

! Calculate error to the minimum roll target for each axle.
! Minimum (negative) roll is left wheel up, right wheel down
EQ_OUT roll_err_1 = Roll_A1r - ROLL_MAX_1;
EQ_OUT roll_err_2 = Roll_A2r - ROLL_MAX_2;

! Roll is at maximum if target is reached or the left tire load is zero 
! or the right jounce stop is contacted
EQ_OUT at_max_1 = ABS(roll_err_1)<=ROLL_TOL | fz_l1<0.001 | fjst_r1>0.0;
EQ_OUT at_max_2 = ABS(roll_err_2)<=ROLL_TOL | fz_l2<0.001 | fjst_r2>0.0;

! Front
! left front wheel is going down
EQ_IN imp_zgnd_l1 = IF(fz_l1, ...
                       IF(z_targ_l1 < zgnd_l1, ...
                          IF(ABS(roll_err_1) > ROLL_TOL, ...
                             z_targ_l1, ...
                             zgnd_l1), ...
                          zgnd_l1), ...
                       zgnd_l1);
! right front wheel is going up
EQ_IN imp_zgnd_r1 = IF(fjst_r1, ...
                       zgnd_r1, ...
                       IF(z_targ_r1 > zgnd_r1, ...
                          IF(ABS(roll_err_1) > ROLL_TOL, ...
                             z_targ_r1, ...
                             zgnd_r1), ...
                          zgnd_r1));
! Rear
! left rear wheel is going down
EQ_IN imp_zgnd_l2 = IF(fz_l2, ...
                       IF(z_targ_l2 < zgnd_l2, ...
                          IF(ABS(roll_err_2) > ROLL_TOL, ...
                             z_targ_l2, ...
                             zgnd_l2), ...
                          zgnd_l2), ...
                       zgnd_l2);
! right rear wheel is going up
EQ_IN imp_zgnd_r2 = IF(fjst_r2, ...
                       zgnd_r2, ...
                       IF(z_targ_r2 > zgnd_r2, ...
                          IF(ABS(roll_err_2) > ROLL_TOL, ...
                                 z_targ_r2, ...
                                 zgnd_r2), ...
                          zgnd_r2));
#ENDMYellow


LOG_ENTRY Used Dataset: Generic VS Commands; { K&C Test Sequence } 03 - Roll - Move to max roll
