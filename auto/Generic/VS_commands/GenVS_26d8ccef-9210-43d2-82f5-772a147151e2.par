PARSFILE
#FullDataName Generic VS Commands`06d - RWD Lock trans, apply Fx`K&C Test Sequence
#VehCode VS Commands

#MiscYellow0
! Capture the transmission output angle at the beginning of the test.
A_PARK = rottrans;

! A spring and damper lock the transmission output shaft
EQ_IN imp_m_out_tr = -1 * (rottrans - A_PARK) * K_PARK - av_trans * C_PARK

! Enable or disable Fx according to powertrain and test configuration
SWITCH_L1 = 0
SWITCH_R1 = 0
SWITCH_L2 = 1
SWITCH_R2 = 1
#ENDMYellow


LOG_ENTRY Used Dataset: Generic VS Commands; { K&C Test Sequence } 06d - RWD Lock trans, apply Fx
