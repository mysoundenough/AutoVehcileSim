PARSFILE
#FullDataName Generic VS Commands`02 - Jounce - Move to full rebound`K&C Test Sequence
#VehCode VS Commands

#MiscYellow0
! Moving in rebound direction
JNC_RATE = - JNC_RATE

! Calculate error to the rebound target for each wheel
EQ_OUT jnc_err_l1 = jnc_l1 - JNC_MIN_L1;
EQ_OUT jnc_err_r1 = jnc_r1 - JNC_MIN_R1;
EQ_OUT jnc_err_l2 = jnc_l2 - JNC_MIN_L2;
EQ_OUT jnc_err_r2 = jnc_r2 - JNC_MIN_R2;

! Apply control to Z_Gnd to bring the wheel center to target, within the specified tolerance
! Stop if the tire force goes to zero
EQ_DIFFERENTIAL z_targ_l1 = jnc_rate;
EQ_DIFFERENTIAL z_targ_r1 = jnc_rate;
EQ_DIFFERENTIAL z_targ_l2 = jnc_rate;
EQ_DIFFERENTIAL z_targ_r2 = jnc_rate;

EQ_IN imp_zgnd_l1 = IF(fz_l1, ...
                       IF(abs(jnc_err_l1) > JNC_TOL, ...
                          z_targ_l1, ...
                          zgnd_l1), ...
                       zgnd_l1);
EQ_IN imp_zgnd_r1 = IF(fz_r1, ...
                       IF(abs(jnc_err_r1) > JNC_TOL, ...
                          z_targ_r1, ...
                          zgnd_r1), ...
                       zgnd_r1);
EQ_IN imp_zgnd_l2 = IF(fz_l2, ...
                       IF(abs(jnc_err_l2) > JNC_TOL, ...
                          z_targ_l2, ...
                          zgnd_l2), ...
                       zgnd_l2);
EQ_IN imp_zgnd_r2 = IF(fz_r2, ...
                       IF(abs(jnc_err_r2) > JNC_TOL, ...
                          z_targ_r2, ...
                          zgnd_r2), ...
                       zgnd_r2);
#ENDMYellow


LOG_ENTRY Used Dataset: Generic VS Commands; { K&C Test Sequence } 02 - Jounce - Move to full rebound
#Library : Generic VS Commands
