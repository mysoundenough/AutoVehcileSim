PARSFILE
#FullDataName Generic VS Commands`02 - Jounce - Move to full jounce`K&C Test Sequence
#VehCode VS Commands

#MiscYellow0
! Change direction of motion
JNC_RATE = -JNC_RATE

! reset the min limit switches
at_min_l1 = 0
at_min_r1 = 0
at_min_l2 = 0
at_min_r2 = 0

! Calculate error to the max jounce target for each wheel
EQ_OUT jnc_err_l1 = jnc_l1 - JNC_MAX_L1;
EQ_OUT jnc_err_r1 = jnc_r1 - JNC_MAX_R1;
EQ_OUT jnc_err_l2 = jnc_l2 - JNC_MAX_L2;
EQ_OUT jnc_err_r2 = jnc_r2 - JNC_MAX_R2;

EQ_IN imp_zgnd_l1 = IF(fjst_l1, ...
                       zgnd_l1, ...
                       IF(z_targ_l1 > zgnd_l1, ...
                          if(ABS(jnc_err_l1) > JNC_TOL, ...
                             z_targ_l1, ...
                             zgnd_l1), ...
                          zgnd_l1) ...
                       );
EQ_IN imp_zgnd_r1 = IF(fjst_r1, ...
                       zgnd_r1, ...
                       IF(z_targ_r1 > zgnd_r1, ...
                          if(ABS(jnc_err_r1) > JNC_TOL, ...
                             z_targ_r1, ...
                             zgnd_r1), ...
                          zgnd_r1) ...
                       );
EQ_IN imp_zgnd_l2 = IF(fjst_l2, ...
                       zgnd_l2, ...
                       IF(z_targ_l2 > zgnd_l2, ...
                          if(ABS(jnc_err_l2) > JNC_TOL, ...
                             z_targ_l2, ...
                             zgnd_l2), ...
                          zgnd_l2) ...
                       );
EQ_IN imp_zgnd_r2 = IF(fjst_r2, ...
                       zgnd_r2, ...
                       IF(z_targ_r2 > zgnd_r2, ...
                          IF(ABS(jnc_err_r2) > JNC_TOL, ...
                             z_targ_r2, ...
                             zgnd_r2), ...
                          zgnd_r2) ...
                       );
#ENDMYellow


LOG_ENTRY Used Dataset: Generic VS Commands; { K&C Test Sequence } 02 - Jounce - Move to full jounce
