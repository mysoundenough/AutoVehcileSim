PARSFILE
#FullDataName Generic VS Commands`PARTIAL`Miscellaneous VS Commands
#VehCode Miscellaneous VS Commands

#MiscYellow0
! Take partial derivative of long. tire force (F_x) with respect to long. slip (kappa) on tire L1
! PARTIAL takes the partial derivative of a configurable function w.r.t the column variable
! at a specified value for the row variable
define_output fx_par_k = partial(fx_tire, fz_l1, kappa_l1, 1);; Partial Kappa derivative of Fx

! Take partial derivative of long. tire force (F_x) with respect to vertical force (F_z) on tire L1
! PARTIAL2 takes the partial derivative of a configurable function w.r.t the row variable
! at a specified value for the column variable
define_output fx_par_fz = partial2(fx_tire, fz_l1, kappa_l1, 1);; Partial Fz derivative of Fx

! PARTIAL2 can be used to take the derivative of configurable functions with only 1
! independent variable. In general, this is a row variable.
! Take derivative of Road Wheel Steer with respect to Rack and Pinion displacement
define_output d_kin_l1_par2 = partial2(rack_kin, 0, Y_Rack1, 1);
#ENDMYellow

*MODELCODE Miscellaneous VS Commands
PARSFILE Plot\Setup\Plot_6668b8f6-f7d6-401a-bc0d-2d29d8c48ef4.par
#BlueLink3 Plot: Setup`PARTIAL: Kappa deriv. of Fx` User-Defined Variables` , Plot`Plot_6668b8f6-f7d6-401a-bc0d-2d29d8c48ef4

