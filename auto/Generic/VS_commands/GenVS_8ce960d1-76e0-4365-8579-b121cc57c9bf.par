PARSFILE
#FullDataName Generic VS Commands`Measured Aero Coefficients`Virtual Wind Tunnel
#VehCode VS Commands

#MiscYellow0
define_output Cd_VWT = -Fx_Air/(AREA_AERO*D_AIR*Vwind^2/2); -; Drag coefficient
define_output Cs_VWT = -Fy_Air/(AREA_AERO*D_AIR*Vwind^2/2); -; Side coefficient
define_output Cl_VWT = Fz_Air/(AREA_AERO*D_AIR*Vwind^2/2); -; Lift coefficient
define_output Cr_VWT = Mx_Air/(AREA_AERO*L_REF_AERO*D_AIR*Vwind^2/2); -; Roll coefficient
define_output Cp_VWT = -My_Air/(AREA_AERO*L_REF_AERO*D_AIR*Vwind^2/2); -; Pitch coefficient
define_output Cy_VWT = -Mz_Air/(AREA_AERO*L_REF_AERO*D_AIR*Vwind^2/2); -; Yaw coefficient

define_output Cd_Input = FX_AERO_SHAPING(0, BetaAir, 1); -; Drag coefficient
define_output Cs_Input = FY_AERO_SHAPING(0, BetaAir, 1); -; Side coefficient
define_output Cl_Input = FZ_AERO_SHAPING(0, BetaAir, 1); -; Lift coefficient
define_output Cr_Input = MX_AERO_SHAPING(0, BetaAir, 1); -; Roll coefficient
define_output Cp_Input = MY_AERO_SHAPING(0, BetaAir, 1); -; Pitch coefficient
define_output Cy_Input = Mz_AERO_SHAPING(0, BetaAir, 1); -; Yaw coefficient
#ENDMYellow

