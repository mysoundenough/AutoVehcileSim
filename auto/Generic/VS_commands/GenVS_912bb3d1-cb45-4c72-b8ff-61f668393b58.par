PARSFILE
#FullDataName Generic VS Commands`ACC, CCRs-Straight, VUT and GVT Setup`Safety Assist Euro NCAP
#VehCode AEB, ACC Euro NCAP Setup

#MiscYellow0
******************************** VUT SETUP ********************************
DEFINE_PARAMETER VUT_INIT_SPD = 70; km/h; Start speed of driven vehicle (VUT)
! This gap distance should allow the initial time-to-collsion to be above 4.0s
DEFINE_PARAMETER INIT_TTC = 4.1; s; target TTC at start of test
DEFINE_PARAMETER VUT_GVT_GAP = VUT_INIT_SPD*INIT_TTC; m; gap dist. btw. vut and gvt


******************************** GVT SETUP ********************************
DEFINE_PARAMETER SSTART_GVT = -300; m ; Starting station of GVT
DEFINE_PARAMETER LAT_GVT = -1.65; m ; Starting LTARG of GVT
DEFINE_PARAMETER LEN_GVT = 4.1; m ; Length of GVT
DEFINE_OUTPUT Vx_GVT = 0; km/h; GVT Speed
#ENDMYellow

*MODELCODE AEB, ACC Euro NCAP Setup

#EMBEDDED_NOTES
#Location and speed setup for the Euro NCAP VUT and GVT, used in vehicle-to-vehicle tests
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Generic VS Commands; { Safety Assist Euro NCAP } ACC, CCRs-Straight, VUT and GVT Setup
