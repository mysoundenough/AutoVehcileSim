PARSFILE
#FullDataName Generic VS Commands`Ignition Switch and Transmission Park`Miscellaneous Vehicle Model Extensions
#VehCode VS Commands

#MiscYellow0
! Overview of operation - park position
! Park may be selected at any time
! when Park is selected the transmission is internally in neutral,
! and the parking pawl is engaged on the output shaft
! This model doesn't reproduce a parking pawl that can ratchet out when overloaded.

! parameters for the torsional stiffness and damping of the park mechanism
define_parameter k_park 10; N-m/deg; Torsional stiffness of the park mechanism
define_parameter c_park 1; N-m-s/deg; Damping of the park mechanism

! variable to select transmission Park (this is set with events)
define_parameter mode_trans_override 0; -; Transmission park: -2 is park

! variable to hold the rotation angle of the trans output shaft when park is selected
define_variable a_park 0; -; hold the rotation angle of the trans output shaft when park is selected

! Operation of park:
! At the moment park is selected:
! mode_trans_override = -2
! a_park = 0;
eq_in a_park = if((mode_trans_override == -2) * (~a_park), rottrans, a_park);

! Once park is selected,
! mode_trans_override = -2
! a_park <> 0

! At the moment park is deselected
! mode_trans_override <> -2
! a_park <> 0
eq_in a_park = if((mode_trans_override ~= -2) * a_park, 0, a_park);

! Once park is deselected
! mode_trans_override <> -2
! a_park = 0

! force the trans to be in neutral internally when in park or neutral
eq_in mode_trans_gain = if(((mode_trans_override == -2) | (mode_trans_override == 0)), 0, 1);

! when in park apply a moment to the driveshaft
eq_in imp_m_out_tr = (-(rottrans - a_park) * k_park - av_trans * c_park) * (mode_trans_override == -2);
import imp_m_out_tr add 0

! ---------------------------------------------------------------------------------------------------------
! Overview of operation - ignition
! The key position "key_pos_ask" as treated as a request by the driver to select a key position
! key position parameter is set with events
! A key position is returned "key_pos" depending on meeting various conditions
define_output Key_Pos_Ask 0; -; Key position request: 0 - 3 ! 0 -> off, 1 -> acc, 2 -> run 3 -> start
define_output Key_Pos 0; -; Current key position
define_output Ign_OnOff 0; -; Ignition state (0 or 1)
define_output Key_Warn 0; -; 1 if Key_Pos_Ask not allowed

! intermediate variables
define_variable key_pos_temp 0; -; place holder
define_variable ign_onoff_temp 0; -; ignition state 0 -> off, 1 -> on
define_variable kp_0 0 ;-; replace (key_pos == 0)
eq_in kp_0 = (key_pos == 0);
define_variable kp_1 0 ;-; replace (key_pos == 1)
eq_in kp_1 = (key_pos == 1);
define_variable kp_2 0 ;-; replace (key_pos == 2)
eq_in kp_2 = (key_pos == 2);
define_variable kp_3 0 ;-; replace (key_pos == 3)
eq_in kp_3 = (key_pos == 3);

define_variable kpa_0 0;-; replace (key_pos_ask == 0)
eq_in kpa_0 = (key_pos_ask == 0);
define_variable kpa_1 0;-; replace (key_pos_ask == 1)
eq_in kpa_1 = (key_pos_ask == 1);
define_variable kpa_2 0;-; replace (key_pos_ask == 2)
eq_in kpa_2 = (key_pos_ask == 2);
define_variable kpa_3 0;-; replace (key_pos_ask == 3)
eq_in kpa_3 = (key_pos_ask == 3);

define_variable mt_0 0;-; replace (modetran == 0)
eq_in mt_0 = (modetran == 0);

! figure out the key position based on current position and request, and other requirements

! Key is OFF
! switching to ACC
eq_in key_pos_temp   = if(kp_0 & kpa_1, key_pos_ask, key_pos);
eq_in ign_onoff_temp = if(kp_0 & kpa_1, 0, ign_onoff);
! switching to RUN (requires trans in park or neutral to change)
eq_in key_pos_temp   = if(kp_0 & kpa_2 & mt_0, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_0 & kpa_2 & mt_0, 0, ign_onoff_temp);
! switching to START (requires trans in park or neutral to change)
eq_in key_pos_temp   = if(kp_0 & kpa_3 & mt_0, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_0 & kpa_3 & mt_0, 1, ign_onoff_temp);

! Key is ACC
! switching to OFF (requires trans in park or neutral to change)
eq_in key_pos_temp   = if(kp_1 & kpa_0 & mt_0, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_1 & kpa_0 & mt_0, 0, ign_onoff_temp);
! switching to RUN (requires trans in park or neutral to change)
eq_in key_pos_temp   = if(kp_1 & kpa_2 & mt_0, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_1 & kpa_2 & mt_0, 0, ign_onoff_temp);
! switching to START (requires trans in park or neutral to change)
eq_in key_pos_temp   = if(kp_1 & kpa_3 & mt_0, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_1 & kpa_3 & mt_0, 1, ign_onoff_temp);

! Key is RUN
! switching to OFF (requires trans in park or neutral to change)
eq_in key_pos_temp   = if(kp_2 & kpa_0 & mt_0, key_pos_ask, key_pos_temp);
! if not neutral or park and OFF is selected, set to ACC
eq_in key_pos_temp   = if(kp_2 & kpa_0 & modetran, 1, key_pos_temp);
eq_in ign_onoff_temp = if(kp_2 & kpa_0 & mt_0, 0, ign_onoff_temp);
! switching to ACC (requires trans in park or neutral to change)
eq_in key_pos_temp   = if(kp_2 & kpa_1 & mt_0, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_2 & kpa_1 & mt_0, 0, ign_onoff_temp);
! switching to START  (requires trans in park or neutral and ignition OFF to change)
eq_in key_pos_temp   = if(kp_2 & kpa_3 & mt_0 & ~ign_onoff, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_2 & kpa_3 & mt_0 & ~ign_onoff, 1, ign_onoff_temp);

! Key is START (operation allows user to hold key in START as long as he wants to)
! switching to OFF (requires trans in park neutral to change)
eq_in key_pos_temp   = if(kp_3 & kpa_0 & mt_0, key_pos_ask, key_pos_temp);
!           if not neutral or park and OFF is selected, set to ACC
eq_in key_pos_temp   = if(kp_3 & kpa_0 & modetran, 1, key_pos_temp);
eq_in ign_onoff_temp = if(kp_3 & kpa_0 & mt_0, 0, ign_onoff_temp);
! switching to ACC (requires trans in park or neutral to change)
eq_in key_pos_temp   = if(kp_3 & kpa_1 & mt_0, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_3 & kpa_1 & mt_0, 0, ign_onoff_temp);
! switching to RUN (valid in any gear)
eq_in key_pos_temp   = if(kp_3 & kpa_2, key_pos_ask, key_pos_temp);
eq_in ign_onoff_temp = if(kp_3 & kpa_2, 1, ign_onoff_temp);

! set the final key position and ignition state
eq_in key_pos   = key_pos_temp;
eq_in ign_onoff = ign_onoff_temp;
! set warning if requested key position wasn't allowed
eq_in key_warn  = if(key_pos == key_pos_ask, 0, 1);
#ENDMYellow


#EMBEDDED_NOTES
#The comments in the parsfile describe the implementation of an ignition switch and automatic transmission park mechanism. Their operation is controlled via Events on the Procedures screen linked to this run.
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Generic VS Commands; { Miscellaneous Vehicle Model Extensions } Ignition Switch and Transmission Park
