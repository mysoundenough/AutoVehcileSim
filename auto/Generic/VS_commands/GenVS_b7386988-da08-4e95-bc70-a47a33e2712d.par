PARSFILE
#FullDataName Generic VS Commands`ACC, CCRb-40m, VUT and GVT Setup`Safety Assist Euro NCAP
#VehCode AEB, ACC Euro NCAP Setup

#MiscYellow0
******************************** VUT SETUP ********************************
DEFINE_PARAMETER VUT_INIT_SPD = 55; km/h; Start speed of driven vehicle (VUT)
DEFINE_PARAMETER VUT_GVT_GAP = 40; m; gap dist. btw. vut and gvt

******************************** GVT SETUP ********************************
DEFINE_PARAMETER SSTART_GVT = -400; m ; Starting station of GVT
DEFINE_PARAMETER LAT_GVT = -1.65; m ; Starting LTARG of GVT
DEFINE_PARAMETER LEN_GVT = 4.1; m ; Length of GVT
DEFINE_OUTPUT Vx_GVT = 0; km/h; GVT Speed
#ENDMYellow

*MODELCODE AEB, ACC Euro NCAP Setup

#EMBEDDED_NOTES
#Location and speed setup for the Euro NCAP VUT and GVT, used in vehicle-to-vehicle tests
#END_EMBEDDED_NOTES

