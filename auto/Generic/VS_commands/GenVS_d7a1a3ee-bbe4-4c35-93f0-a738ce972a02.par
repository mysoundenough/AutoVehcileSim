PARSFILE
#FullDataName Generic VS Commands`02 - Jounce - Return to full rebound`K&C Test Sequence
#VehCode VS Commands

#MiscYellow0
! Change direction of motion
jnc_rate = -jnc_rate

! Calculate error to the rebound target for each wheel
eq_out jnc_err_l1 = jnc_l1 - jnc_min_l1;
eq_out jnc_err_r1 = jnc_r1 - jnc_min_r1;
eq_out jnc_err_l2 = jnc_l2 - jnc_min_l2;
eq_out jnc_err_r2 = jnc_r2 - jnc_min_r2;

eq_out at_min_l1 = abs(jnc_err_l1)<=jnc_tol | fz_l1<0.001;
eq_out at_min_r1 = abs(jnc_err_r1)<=jnc_tol | fz_r1<0.001;
eq_out at_min_l2 = abs(jnc_err_l2)<=jnc_tol | fz_l2<0.001;
eq_out at_min_r2 = abs(jnc_err_r2)<=jnc_tol | fz_r2<0.001;

! Apply control to Z_Gnd to bring the wheel center to target, within the specified tolerance
! Stop if the tire force goes to zero

! Front
eq_in imp_zgnd_l1 = if(zgnd_l1 > z_targ_l1, ...
                       if(fz_l1, ...
                          if(abs(jnc_err_l1) > jnc_tol, ...
                                 z_targ_l1, ...
                                 zgnd_l1), ...
                          zgnd_l1), ...
                       zgnd_l1);
eq_in imp_zgnd_r1 = if(zgnd_r1 > z_targ_r1, ...
                       if(fz_r1, ...
                          if(abs(jnc_err_r1) > jnc_tol, ...
                                 z_targ_r1, ...
                                 zgnd_r1), ...
                          zgnd_r1), ...
                       zgnd_r1);
! Rear
eq_in imp_zgnd_l2 = if(zgnd_l2 > z_targ_l2, ...
                       if(fz_l2, ...
                          if(abs(jnc_err_l2) > jnc_tol, ...
                             z_targ_l2, ...
                             zgnd_l2), ...
                          zgnd_l2), ...
                       zgnd_l2);
eq_in imp_zgnd_r2 = if(zgnd_r2 > z_targ_r2, ...
                       if(fz_r2, ...
                          if(abs(jnc_err_r2) > jnc_tol, ...
                             z_targ_r2, ...
                             zgnd_r2), ...
                          zgnd_r2), ...
                       zgnd_r2);
#ENDMYellow


LOG_ENTRY Used Dataset: Generic VS Commands; { K&C Test Sequence } 02 - Jounce - Return to full rebound
