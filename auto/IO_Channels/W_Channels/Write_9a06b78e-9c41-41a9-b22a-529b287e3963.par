#MiscYellow1
SPEED_AX_BRAKE_CONSTANT 0.15
SPEED_AX_THROTTLE_CONSTANT 0.12
SPEED_AY_LEFT_CONSTANT 0.15
SPEED_AY_RIGHT_CONSTANT 0.15
speed_preview 150
#ENDMYellow

