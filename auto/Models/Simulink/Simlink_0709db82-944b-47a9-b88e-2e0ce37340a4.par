PARSFILE
#FullDataName Models: Simulink`Differential Controller - EV`External Powertrain
#RunMdlFile Extensions\Simulink\Differential_CS9.mdl
SIMULINK_MODEL_FILE Extensions\Simulink\Differential_CS9.mdl
#RingCtrl0 -1
#RingCtrl2 0
*MULTI_SOLVERS 0
*MULTI_S_WRAPPER 0
#CheckBox0 0    
*USE_ALT_DIR 0
#CheckBox1 0    
*USE_DIFF_SOLVERS 0
#CheckBox3 1    
#CheckBox5 0    
#RingCtrl1 0
OPT_INT_METHOD 0
#CheckBox4 1    
OPT_IO_SYNC_FM 1
*TSTEP 0.0005
*FREQ_MODEL 2000
*TSTEP_OUT 0.025
*FREQ_OUT 40
tstep 0.0005
iprint 50
PARSFILE IO_Channels\I_Channels\Import_80e1efd8-fd7a-4d60-9a92-8db55ee8f193.par
