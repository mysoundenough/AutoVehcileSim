PARSFILE
#FullDataName Models: Simulink`Vehicle Hauling - Car 1`Parallel Solvers
#RunMdlFile Extensions\Simulink\Parallel_Solver\Vehicle_Hauling.mdl
SIMULINK_MODEL_FILE Extensions\Simulink\Parallel_Solver\Vehicle_Hauling.mdl
#RingCtrl0 -1
#RingCtrl2 1
*MULTI_SOLVERS 1
*MULTI_S_WRAPPER 0
#CheckBox0 1    
*USE_ALT_DIR 1
#CheckBox1 0    
*USE_DIFF_SOLVERS 0
#CheckBox3 1    
#CheckBox5 0    
#RingCtrl1 2
OPT_INT_METHOD 2
#CheckBox2 0    
OPT_IO_UPDATE 0
*TSTEP 0.001
*FREQ_MODEL 1000
*TSTEP_OUT 0.025
*FREQ_OUT 40
tstep 0.001
iprint 25
#AltPath Extensions\Simulink\Parallel_Solver
*ALTERNATE_PATH Extensions\Simulink\Parallel_Solver
PARSFILE IO_Channels\I_Channels\Import_012cd409-820d-4620-9406-0f28a4f4d21f.par
