PARSFILE
#FullDataName Models: Simulink`External EV Battery`External Powertrain
#RunMdlFile Extensions\Simulink\ev_battery\ev_battery.mdl
SIMULINK_MODEL_FILE Extensions\Simulink\ev_battery\ev_battery.mdl
#RingCtrl0 -1
#RingCtrl2 0
*MULTI_SOLVERS 0
*MULTI_S_WRAPPER 0
#CheckBox0 0    
*USE_ALT_DIR 0
#CheckBox1 0    
*USE_DIFF_SOLVERS 0
#CheckBox3 1    
#CheckBox5 0    
#RingCtrl1 0
OPT_INT_METHOD 0
#CheckBox4 1    
OPT_IO_SYNC_FM 1
*TSTEP 0.0005
*FREQ_MODEL 2000
*TSTEP_OUT 0.025
*FREQ_OUT 40
tstep 0.0005
iprint 50
*ALTERNATE_PATH Programs\Simulink_MDL
PARSFILE IO_Channels\Ports\Port_b91084f5-b117-45cb-8a08-7c6cf0348553.par
#BlueLink0 I/O Channels: Ports`External EV Battery` Powertrain` , Import`Port_b91084f5-b117-45cb-8a08-7c6cf0348553

