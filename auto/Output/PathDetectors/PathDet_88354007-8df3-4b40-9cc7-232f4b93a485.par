PARSFILE
#FullDataName Path Detectors for External Driver Control`Three Detected Paths Pls. Curvature Est.`
#RingCtrl0 4
INSTALL_PATH_DETECTOR 4

IDETECTOR 1
symbol_push  <<detector>> 1
X_DETECTOR_SM(1) 0
Y_DETECTOR_SM(1) 0
#CheckBox0 0    
OPT_PATH_PD(1) 1
PATH_ID_PD(1) 1
PARSFILE Control\Driver\StrDM_bce87a0c-a0d2-4ca7-bc14-bc36a25c4a46.par
#BlueLink0 Control: Steering by the Closed-loop Driver Model`Left Lane Marking LKAS, Rt. Lane` Path Detections` , lateral target`StrDM_bce87a0c-a0d2-4ca7-bc14-bc36a25c4a46

LTARG_ID_PD(1) = LTARG_ID
PARSFILE Sensors_Traffic\Traffic\TMotion_523c3271-260f-415d-95af-efbcee2dd9db.par
#BlueLink5 Multiple Moving Objects`Detected Path Visual` Path Detection` , multiple moving objects`TMotion_523c3271-260f-415d-95af-efbcee2dd9db


IDETECTOR 2
symbol_add  <<detector>> 1
X_DETECTOR_SM(2) 0
Y_DETECTOR_SM(2) 0
#CheckBox1 0    
OPT_PATH_PD(2) 1
PATH_ID_PD(2) 1
PARSFILE Control\Driver\StrDM_06bbf592-3b23-498b-bc33-4f74bc8280d4.par
#BlueLink1 Control: Steering by the Closed-loop Driver Model`Right Lane Marking LKAS, Rt. Lane` Path Detections` , lateral target`StrDM_06bbf592-3b23-498b-bc33-4f74bc8280d4

LTARG_ID_PD(2) = LTARG_ID
PARSFILE Sensors_Traffic\Traffic\TMotion_523c3271-260f-415d-95af-efbcee2dd9db.par
#BlueLink6 Multiple Moving Objects`Detected Path Visual` Path Detection` , multiple moving objects`TMotion_523c3271-260f-415d-95af-efbcee2dd9db


IDETECTOR 3
symbol_add  <<detector>> 1
X_DETECTOR_SM(3) 0
Y_DETECTOR_SM(3) 0
#CheckBox2 0    
OPT_PATH_PD(3) 1
PATH_ID_PD(3) 1
PARSFILE Control\Driver\StrDM_40b29862-3e2e-4e61-9367-a252856fa452.par
#BlueLink2 Control: Steering by the Closed-loop Driver Model`Center of Lane, Rt. Lane` Path Detections` , lateral target`StrDM_40b29862-3e2e-4e61-9367-a252856fa452

LTARG_ID_PD(3) = LTARG_ID

IDETECTOR 4
symbol_add  <<detector>> 1
X_DETECTOR_SM(4) 0
Y_DETECTOR_SM(4) 0
#CheckBox3 0    
OPT_PATH_PD(4) 1
PATH_ID_PD(4) 1
PARSFILE Control\Driver\StrDM_40b29862-3e2e-4e61-9367-a252856fa452.par
#BlueLink3 Control: Steering by the Closed-loop Driver Model`Center of Lane, Rt. Lane` Path Detections` , lateral target`StrDM_40b29862-3e2e-4e61-9367-a252856fa452

LTARG_ID_PD(4) = LTARG_ID
PARSFILE Sensors_Traffic\Traffic\TMotion_9e2b27ed-6a5a-454f-bd3f-78755d115310.par
#BlueLink8 Multiple Moving Objects`Detected Path Visual (Green)` Path Detection` , multiple moving objects`TMotion_9e2b27ed-6a5a-454f-bd3f-78755d115310

#MiscYellow0
EQ_IN L_PVW_PD(1) = Vxz_Fwd*1.5 ! Left Lane Marker Path Detector Preview Distance, based on speed
EQ_IN L_PVW_PD(2) = Vxz_Fwd*1.5 ! Right Lane Marker Path Detector Preview Distance, based on speed
EQ_IN L_PVW_PD(3) = Vxz_Fwd*1.5 ! Center Lane Marker Path Detector Preview Distance, based on speed
EQ_IN L_PVW_PD(4) = Vxz_Fwd*3 ! Center Lane Marker Path Detector Long Preview Distance, based on speed
#ENDMYellow

PARSFILE Generic\Links\GenLink_4eb631ef-eb7d-4e2c-bbbb-d636fba151dc.par
#BlueLink16 Generic Group of Links`Path Detector Plots, Four` Path Detectors` , Miscellaneous`GenLink_4eb631ef-eb7d-4e2c-bbbb-d636fba151dc


#EMBEDDED_NOTES
#Three instances of the Path Detector are installed
#
#All instances refer to the same Path ID, but each has a unique LTARG specification, allowing one to represent the left lane marking (detected curve), right lane marking (detected curve), and center of the two lane markings.
#
#The calculated preview distances are proportional to the vehicle speed
#END_EMBEDDED_NOTES

