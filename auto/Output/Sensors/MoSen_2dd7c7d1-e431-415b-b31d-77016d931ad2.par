PARSFILE
#FullDataName Positions, Velocities, and Accelerations`Aero Reference Point (Incl. Trailer)`
#RingCtrl0 0
#RingCtrl2 2
#RingCtrl3 1
#RingCtrl4 1
#RingCtrl5 1
#RingCtrl6 1
#RingCtrl7 1
*BODY_ID_1 1
*X_S1 X_REF_AERO(1)
*Y_S1 Y_REF_AERO(1)
*Z_S1 H_REF_AERO(1)
*A_ROLL_S1 0
*A_PITCH_S1 0
*A_YAW_S1 0
*BODY_ID_2 2
*X_S2 X_REF_AERO(2)
*Y_S2 Y_REF_AERO(2)
*Z_S2 H_REF_AERO(2)

ISENSOR_M = 1
DEFINE_MOTION_SENSORS 2 + ISENSOR_M -1 -NSENSOR_M

OPT_S_BODY_TYPE 1
OPT_S_OUTPUT 1
OPT_S_BODY_ID 1
X_S X_REF_AERO(1)
Y_S Y_REF_AERO(1)
Z_S H_REF_AERO(1)
A_ROLL_S 0
A_PITCH_S 0
A_YAW_S 0
SET_DESCRIPTION MOTION_SENSOR_NAME Sensor 1: Aero Reference Point (Incl. Trailer)

ISENSOR_M = ISENSOR_M + 1
OPT_S_BODY_TYPE 1
OPT_S_OUTPUT 1
OPT_S_BODY_ID 2
X_S X_REF_AERO(2)
Y_S Y_REF_AERO(2)
Z_S H_REF_AERO(2)
SET_DESCRIPTION MOTION_SENSOR_NAME Sensor 2: Aero Reference Point (Incl. Trailer)

MAKE_MOTION_SENSOR_OUTPUTS

#EMBEDDED_NOTES
#This dataset adds output variables for the global position of the aerodynamic reference point.
#END_EMBEDDED_NOTES

