X_S -LX_H
Y_S Y_H
Z_S H_H
SET_DESCRIPTION MOTION_SENSOR_NAME Hitch Point (Lead)

MAKE_MOTION_SENSOR_OUTPUTS

#EMBEDDED_NOTES
#Position motion sensor at hitch point for unit 1.
#END_EMBEDDED_NOTES

