define_output Toe_L2 = - Steer_L2;deg; Left rear toe
define_output Toe_R2 = Steer_R2;deg; Right rear toe
#ENDMYellow

#MiscYellow0
PLOTCHANNELS Toe_L2, Jnc_L2
PLOTCHANNELS Toe_R2, Jnc_R2

#ENDMYellow


#RingCtrl2 Auto
YMaxmin Auto
#RingCtrl3 Auto
XMaxmin Auto
#RingCtrl8 1


PTITLE Toe vs. Jounce - Rear

END_ENTITY Plot


