OPT_INIT_PATH 1
#CheckBox4 0    

#RingCtrl0 1
#RingCtrl1 0
#RingCtrl2 0
OPT_STOP 0
SSTART 5
TSTART 0
TSTART_WRITE = 0;
TSTOP 8
SSTOP = SSTART + 1 ;
OPT_DIRECTION 1
*SPEED 100
*TSTOP 8
*TSTART 0
*SSTART 5
*SSTOP 210

