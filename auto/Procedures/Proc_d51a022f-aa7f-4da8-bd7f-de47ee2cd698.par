PARSFILE
#FullDataName Procedures`ACC: Slow Down Test`ACC: Automatic Cruise Control
#CheckBox1 0    
OPT_INIT_PATH 0

#RingCtrl0 2
#RingCtrl1 1
OPT_STOP 1
SSTART -400
TSTART 0
TSTART_WRITE = 0;
TSTOP 15
SSTOP 900
OPT_DIRECTION 0
*SPEED 120
*TSTOP 15
*TSTART 0
*SSTART -400
*SSTOP 900

OPT_SC 2
PARSFILE Control\Gear_at\GearCL_3f60e7d2-b8c4-4d68-a9c4-d897bb3e2a86.par
#BlueLink30 Control: Shifting (Closed Loop)`AT (All Available Gears)` Closed-Loop Shifting` , Shifting Control`GearCL_3f60e7d2-b8c4-4d68-a9c4-d897bb3e2a86

PARSFILE Control\Speed_t\SpdTime_9c8429af-3d89-4f4c-986b-90deb4e2777b.par
#BlueLink31 Control: Speed (Closed Loop) Using Target Speed`Constant: 120 km/h` Constant` , Speed vs. time`SpdTime_9c8429af-3d89-4f4c-986b-90deb4e2777b

#MiscYellow0
define_output laneWidth = 4.0 ; m ; lane width of road
define_output vehWidth = WID_SM; m; vehicle width
DEFINE_PARAMETER VUT_START_STATION = -400; m; VUT start station
#ENDMYellow

PARSFILE Generic\Links\GenLink_c7add83a-53dc-442d-b7fb-24d2b8014a3f.par
#BlueLink0 Generic Group of Links`PG: Straight Road, Two Lanes` Generic Proving Ground` , Miscellaneous`GenLink_c7add83a-53dc-442d-b7fb-24d2b8014a3f

PARSFILE Generic\Group\GenGrp_c11e4bbe-5e3a-4498-91a5-6c42d1db378a.par
#BlueLink1 Generic Data Group`2 Axle - Fx, Fy, Fz` Tire Force Arrows` , Miscellaneous`GenGrp_c11e4bbe-5e3a-4498-91a5-6c42d1db378a

PARSFILE Generic\Group\GenGrp_e873d0e1-c102-4857-b3c2-d6b1ad91e811.par
#BlueLink2 Generic Data Group`Traffic: ACC, Slow Down Test` ADAS: Traffic for ACC & FCW` , Miscellaneous`GenGrp_e873d0e1-c102-4857-b3c2-d6b1ad91e811

#MiscYellow1
! Unchecked box for "Set vehicle x,y,&yaw based on path?
! Locate vehicle 2m to the right of the road center
Xo  = VUT_START_STATION
Yo = -2
Yaw = 0
#ENDMYellow

