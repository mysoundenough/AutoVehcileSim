TSTOP 60
SSTOP = SSTART + 1 ;
OPT_DIRECTION 1
*SPEED 0
*TSTOP 60
*TSTART 0
*SSTART 0
*SSTOP 210

INSTALL_SPEED_CONTROLLER
OPT_SC 3
