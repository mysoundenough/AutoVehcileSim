 1.3, 9.8
 1.4, 7.2
 1.5, 5
 1.6, 3.2
 1.7, 1.8
 1.8, 0.8
 1.9, 0.2
 2, 0
ENDTABLE
MZ_PARKING_STEER_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get steering
                             ! torque at kingpin
MZ_PARKING_STEER_OFFSET(1,2) 0 ; N-m ! [D] Added (after gain) to get steering torque
                               ! at kingpin
VX_START_MZ_PARKING_STEER(1,2) 0 ; km/h ! [D] Subtracted from vehicle speed
VX_SCALE_MZ_PARKING_STEER(1,2) 1 ! [D] Divided into (vehicle speed -
                                 ! VX_START_MZ_PARKING_STEER)
MZ_PARKING_STEER_COMBINE(1,2) MULTIPLY ! [D] How to combine the two components
MZ_PARKING_STEER_FZ_CONSTANT(1,2) 1 ; - ! [D] Steering torque at kingpin component
                                    ! due to vertical load, axle 1, right side

