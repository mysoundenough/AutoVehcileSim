! RTIME      0.121298 ; - ! CALC -- Computational efficiency (sec/sim. sec)
TSTART          6.313 ; s ! Starting time for the simulation clock
TSTART_T_EVENT      0 ; s ! [D] Event clock reset time: T_EVENT = T - TSTART_T_EVENT
