! FZA_L(2)    5309.05 ; N ! CALC -- Static ground load, laden, axle 2
! FZA_UL(2)   5309.05 ; N ! CALC -- Static ground load, unladen, axle 2
! FZ_STATIC(2,1) 2654.53 ; N ! CALC -- Static ground force, laden, wheel L2
! FZ_STATIC(2,2) 2654.53 ; N ! CALC -- Static ground force, laden, wheel R2
