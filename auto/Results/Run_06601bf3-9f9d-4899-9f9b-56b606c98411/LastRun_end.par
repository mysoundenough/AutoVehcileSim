F_START_C_LONG(1,1) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(1,1) 1 ! [D] Divided into (force - F_START_C_LONG)

C_LONG_COEFFICIENT(1,2) 5e-05 ! X displacement per unit force (mm/N), axle 1, right
                              ! side
C_LONG_GAIN(1,2)    1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(1,2)  0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(1,2) 1 ! [D] Divided into (force - F_START_C_LONG)

C_LONG_COEFFICIENT(2,1) 7e-05 ! X displacement per unit force (mm/N), axle 2, left
                              ! side
C_LONG_GAIN(2,1)    1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(2,1)  0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(2,1) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(2,1) 1 ! [D] Divided into (force - F_START_C_LONG)

C_LONG_COEFFICIENT(2,2) 7e-05 ! X displacement per unit force (mm/N), axle 2, right
                              ! side
C_LONG_GAIN(2,2)    1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(2,2)  0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(2,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(2,2) 1 ! [D] Divided into (force - F_START_C_LONG)

! DOWNSHIFT_TRANS: Transmission speed when downshift occurs. IGEAR specifies the
! lower gear for each table (e.g., IGEAR 2 means downshift from 3 to 2). Transmission
! speed is a function of throttle position (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. Transmission speed from
! the calculation can be adjusted with DOWNSHIFT_TRANS_GAIN and
! DOWNSHIFT_TRANS_OFFSET. Throttle position used in the calculation can be adjusted
! with THROTTLE_SCALE_DOWNSHIFT and THROTTLE_START_DOWNSHIFT. This configurable
! function supports 17 datasets; if indices shown below are not used, e.g., (2), the
! current value of the index IGEAR is used to identify the dataset when reading data.

