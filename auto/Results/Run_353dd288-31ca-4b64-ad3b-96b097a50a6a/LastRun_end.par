ENDTABLE
CAMBER_GAIN(2,2)    1 ! [D] Multiplied with calculated value to get camber
CAMBER_OFFSET(2,2)  0 ; deg ! [D] Added (after gain) to get camber
JNC_START_CAMBER(2,2) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_CAMBER(2,2) 1 ! [D] Divided into (jounce - JNC_START_CAMBER)
CAMBER_COMBINE(2,2) ADD ! How to combine the two components
SET_UNITS SUSP_CAMBER_JNC_OTHER_SIDE_TABLE(2,2) deg ;
SUSP_CAMBER_JNC_OTHER_SIDE_CONSTANT(2,2) 0 ; deg ! [D] Camber component due to
                                           ! jounce (other side), axle 2, right
                                           ! side

! CC_FX: Compliance: wheel camber due to in- and out-phase Fx. Camber displacement
! can be a nonlinear CARPET function of force (other side) and force or a function of
! force (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be
! defined at runtime. Camber displacement from the calculation can be adjusted with
! CC_FX_GAIN and CC_FX_OFFSET. Force used in the calculation can be adjusted with
! F_SCALE_CC_FX and F_START_CC_FX. Force (other side) used in the calculation can be
! adjusted with F2_SCALE_CC_FX and F2_START_CC_FX. This configurable function
! supports 4 datasets; if indices shown below are not used, e.g., (1,2), the current
! values of the indices IAXLE and ISIDE are used to identify the dataset when reading
! data.

CC_FX_COEFFICIENT(1,1) 5.9027e-05 ! Camber displacement per unit force (deg/N), axle
                                  ! 1, left side
CC_FX_GAIN(1,1)     1 ! [D] Multiplied with calculated value to get camber
                      ! displacement
CC_FX_OFFSET(1,1)   0 ; deg ! [D] Added (after gain) to get camber displacement
F_START_CC_FX(1,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CC_FX(1,1)  1 ! [D] Divided into (force - F_START_CC_FX)

CC_FX_COEFFICIENT(1,2) 5.9027e-05 ! Camber displacement per unit force (deg/N), axle
                                  ! 1, right side
CC_FX_GAIN(1,2)     1 ! [D] Multiplied with calculated value to get camber
                      ! displacement
CC_FX_OFFSET(1,2)   0 ; deg ! [D] Added (after gain) to get camber displacement
F_START_CC_FX(1,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CC_FX(1,2)  1 ! [D] Divided into (force - F_START_CC_FX)

CC_FX_COEFFICIENT(2,1) 6.74e-05 ! Camber displacement per unit force (deg/N), axle
                                ! 2, left side
CC_FX_GAIN(2,1)     1 ! [D] Multiplied with calculated value to get camber
                      ! displacement
CC_FX_OFFSET(2,1)   0 ; deg ! [D] Added (after gain) to get camber displacement
F_START_CC_FX(2,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CC_FX(2,1)  1 ! [D] Divided into (force - F_START_CC_FX)

CC_FX_COEFFICIENT(2,2) 6.74e-05 ! Camber displacement per unit force (deg/N), axle
                                ! 2, right side
CC_FX_GAIN(2,2)     1 ! [D] Multiplied with calculated value to get camber
                      ! displacement
CC_FX_OFFSET(2,2)   0 ; deg ! [D] Added (after gain) to get camber displacement
F_START_CC_FX(2,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CC_FX(2,2)  1 ! [D] Divided into (force - F_START_CC_FX)

! CD_MY: Compliance: suspension dive due to in- and out-phase My. Dive displacement
! can be a nonlinear CARPET function of moment (other side) and moment or a function
! of moment (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can
! be defined at runtime. Dive displacement from the calculation can be adjusted with
! CD_MY_GAIN and CD_MY_OFFSET. Moment used in the calculation can be adjusted with
! M_SCALE_CD_MY and M_START_CD_MY. Moment (other side) used in the calculation can be
! adjusted with M2_SCALE_CD_MY and M2_START_CD_MY. This configurable function
! supports 4 datasets; if indices shown below are not used, e.g., (1,2), the current
! values of the indices IAXLE and ISIDE are used to identify the dataset when reading
! data.

CD_MY_COEFFICIENT(1,1) 0 ! Dive displacement per unit moment (deg/N-m), axle 1, left
                         ! side
CD_MY_OFFSET(1,1)   0 ; deg ! [D] Added (after gain) to get dive displacement
M_START_CD_MY(1,1)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CD_MY(1,1)  1 ! [D] Divided into (moment - M_START_CD_MY)

CD_MY_COEFFICIENT(1,2) 0 ! Dive displacement per unit moment (deg/N-m), axle 1,
                         ! right side
CD_MY_OFFSET(1,2)   0 ; deg ! [D] Added (after gain) to get dive displacement
M_START_CD_MY(1,2)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CD_MY(1,2)  1 ! [D] Divided into (moment - M_START_CD_MY)

CD_MY_COEFFICIENT(2,1) 0 ! Dive displacement per unit moment (deg/N-m), axle 2, left
                         ! side
CD_MY_OFFSET(2,1)   0 ; deg ! [D] Added (after gain) to get dive displacement
M_START_CD_MY(2,1)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CD_MY(2,1)  1 ! [D] Divided into (moment - M_START_CD_MY)

CD_MY_COEFFICIENT(2,2) 0 ! Dive displacement per unit moment (deg/N-m), axle 2,
                         ! right side
CD_MY_OFFSET(2,2)   0 ; deg ! [D] Added (after gain) to get dive displacement
M_START_CD_MY(2,2)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CD_MY(2,2)  1 ! [D] Divided into (moment - M_START_CD_MY)

! CI_FY: Compliance: inclination of wheel due in- and out-phase Fy. Inclination
! displacement can be a nonlinear CARPET function of force (other side) and force or
! a function of force (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom
! equation can be defined at runtime. Inclination displacement from the calculation
! can be adjusted with CI_FY_GAIN and CI_FY_OFFSET. Force used in the calculation can
! be adjusted with F_SCALE_CI_FY and F_START_CI_FY. Force (other side) used in the
! calculation can be adjusted with F2_SCALE_CI_FY and F2_START_CI_FY. This
! configurable function supports 4 datasets; if indices shown below are not used,
! e.g., (1,2), the current values of the indices IAXLE and ISIDE are used to identify
! the dataset when reading data.

CI_FY_COEFFICIENT(1,1) 9.7878e-05 ! Inclination displacement per unit force (deg/N),
                                  ! axle 1, left side
CI_FY_GAIN(1,1)     1 ! [D] Multiplied with calculated value to get inclination
                      ! displacement
CI_FY_OFFSET(1,1)   0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(1,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(1,1)  1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(1,2) 9.7878e-05 ! Inclination displacement per unit force (deg/N),
                                  ! axle 1, right side
CI_FY_GAIN(1,2)     1 ! [D] Multiplied with calculated value to get inclination
                      ! displacement
CI_FY_OFFSET(1,2)   0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(1,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(1,2)  1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(2,1) 1.0497e-05 ! Inclination displacement per unit force (deg/N),
                                  ! axle 2, left side
CI_FY_GAIN(2,1)     1 ! [D] Multiplied with calculated value to get inclination
                      ! displacement
CI_FY_OFFSET(2,1)   0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(2,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(2,1)  1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(2,2) 1.0497e-05 ! Inclination displacement per unit force (deg/N),
                                  ! axle 2, right side
CI_FY_GAIN(2,2)     1 ! [D] Multiplied with calculated value to get inclination
                      ! displacement
CI_FY_OFFSET(2,2)   0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(2,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(2,2)  1 ! [D] Divided into (force - F_START_CI_FY)

! CI_MZ: Compliance: inclination of wheel due to in- and out-phase Mz. Inclination
! displacement can be a nonlinear CARPET function of moment (other side) and moment
! or a function of moment (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom
! equation can be defined at runtime. Inclination displacement from the calculation
! can be adjusted with CI_MZ_GAIN and CI_MZ_OFFSET. Moment used in the calculation
! can be adjusted with M_SCALE_CI_MZ and M_START_CI_MZ. Moment (other side) used in
! the calculation can be adjusted with M2_SCALE_CI_MZ and M2_START_CI_MZ. This
! configurable function supports 4 datasets; if indices shown below are not used,
! e.g., (1,2), the current values of the indices IAXLE and ISIDE are used to identify
! the dataset when reading data.

CI_MZ_COEFFICIENT(1,1) -5.3817e-05 ! Inclination displacement per unit moment
                                   ! (deg/N-m), axle 1, left side
CI_MZ_GAIN(1,1)     1 ! [D] Multiplied with calculated value to get inclination
                      ! displacement
CI_MZ_OFFSET(1,1)   0 ; deg ! [D] Added (after gain) to get inclination displacement
M_START_CI_MZ(1,1)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CI_MZ(1,1)  1 ! [D] Divided into (moment - M_START_CI_MZ)

CI_MZ_COEFFICIENT(1,2) -5.3817e-05 ! Inclination displacement per unit moment
                                   ! (deg/N-m), axle 1, right side
CI_MZ_GAIN(1,2)     1 ! [D] Multiplied with calculated value to get inclination
                      ! displacement
CI_MZ_OFFSET(1,2)   0 ; deg ! [D] Added (after gain) to get inclination displacement
M_START_CI_MZ(1,2)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CI_MZ(1,2)  1 ! [D] Divided into (moment - M_START_CI_MZ)

CI_MZ_COEFFICIENT(2,1) 2.5661e-05 ! Inclination displacement per unit moment
                                  ! (deg/N-m), axle 2, left side
CI_MZ_GAIN(2,1)     1 ! [D] Multiplied with calculated value to get inclination
                      ! displacement
CI_MZ_OFFSET(2,1)   0 ; deg ! [D] Added (after gain) to get inclination displacement
M_START_CI_MZ(2,1)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CI_MZ(2,1)  1 ! [D] Divided into (moment - M_START_CI_MZ)

CI_MZ_COEFFICIENT(2,2) 2.5661e-05 ! Inclination displacement per unit moment
                                  ! (deg/N-m), axle 2, right side
CI_MZ_GAIN(2,2)     1 ! [D] Multiplied with calculated value to get inclination
                      ! displacement
CI_MZ_OFFSET(2,2)   0 ; deg ! [D] Added (after gain) to get inclination displacement
M_START_CI_MZ(2,2)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CI_MZ(2,2)  1 ! [D] Divided into (moment - M_START_CI_MZ)

! CMP_DAMP: Damper compression. Damper compression can be a nonlinear CARPET
! function of jounce at wheel (other side) and jounce at wheel or a function of
! jounce at wheel (CONSTANT, COEFFICIENT, or TABLE). Damper compression from the
! calculation can be adjusted with CMP_DAMP_GAIN and CMP_DAMP_OFFSET. Jounce at wheel
! used in the calculation can be adjusted with JNC_SCALE_CMP_DAMP and
! JNC_START_CMP_DAMP. Jounce at wheel (other side) used in the calculation can be
! adjusted with JNC2_SCALE_CMP_DAMP and JNC2_START_CMP_DAMP. The derivative of this
! function is used internally. This configurable function supports 4 datasets; if
! indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

CMP_DAMP_COEFFICIENT(1,1) 0.606 ! Damper compression per unit jounce at wheel
                                ! (mm/mm), axle 1, left side
CMP_DAMP_GAIN(1,1)  1 ! [D] Multiplied with calculated value to get damper
                      ! compression
CMP_DAMP_OFFSET(1,1) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(1,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(1,1) 1 ! [D] Divided into (jounce at wheel - JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(1,2) 0.606 ! Damper compression per unit jounce at wheel
                                ! (mm/mm), axle 1, right side
CMP_DAMP_GAIN(1,2)  1 ! [D] Multiplied with calculated value to get damper
                      ! compression
CMP_DAMP_OFFSET(1,2) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(1,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(1,2) 1 ! [D] Divided into (jounce at wheel - JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(2,1) 0.801 ! Damper compression per unit jounce at wheel
                                ! (mm/mm), axle 2, left side
CMP_DAMP_GAIN(2,1)  1 ! [D] Multiplied with calculated value to get damper
                      ! compression
CMP_DAMP_OFFSET(2,1) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(2,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(2,1) 1 ! [D] Divided into (jounce at wheel - JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(2,2) 0.801 ! Damper compression per unit jounce at wheel
                                ! (mm/mm), axle 2, right side
CMP_DAMP_GAIN(2,2)  1 ! [D] Multiplied with calculated value to get damper
                      ! compression
CMP_DAMP_OFFSET(2,2) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(2,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(2,2) 1 ! [D] Divided into (jounce at wheel - JNC_START_CMP_DAMP)

! CMP_JSTOP: Jounce bumper deflection. Jounce stop deflection can be a nonlinear
! CARPET function of jounce at wheel (other side) and jounce at wheel or a function
! of jounce at wheel (CONSTANT, COEFFICIENT, or TABLE). Jounce stop deflection from
! the calculation can be adjusted with CMP_JSTOP_GAIN and CMP_JSTOP_OFFSET. Jounce at
! wheel used in the calculation can be adjusted with JNC_SCALE_CMP_JSTOP and
! JNC_START_CMP_JSTOP. Jounce at wheel (other side) used in the calculation can be
! adjusted with JNC2_SCALE_CMP_JSTOP and JNC2_START_CMP_JSTOP. The derivative of this
! function is used internally. This configurable function supports 4 datasets; if
! indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

CMP_JSTOP_COEFFICIENT(1,1) 0.606 ! Jounce stop deflection per unit jounce at wheel
                                 ! (mm/mm), axle 1, left side
CMP_JSTOP_GAIN(1,1) 1 ! [D] Multiplied with calculated value to get jounce stop
                      ! deflection
CMP_JSTOP_OFFSET(1,1) 0 ; mm ! [D] Added (after gain) to get jounce stop deflection
JNC_START_CMP_JSTOP(1,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_JSTOP(1,1) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_JSTOP)

CMP_JSTOP_COEFFICIENT(1,2) 0.606 ! Jounce stop deflection per unit jounce at wheel
                                 ! (mm/mm), axle 1, right side
CMP_JSTOP_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get jounce stop
                      ! deflection
CMP_JSTOP_OFFSET(1,2) 0 ; mm ! [D] Added (after gain) to get jounce stop deflection
JNC_START_CMP_JSTOP(1,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_JSTOP(1,2) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_JSTOP)

CMP_JSTOP_COEFFICIENT(2,1) 0.801 ! Jounce stop deflection per unit jounce at wheel
                                 ! (mm/mm), axle 2, left side
CMP_JSTOP_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get jounce stop
                      ! deflection
CMP_JSTOP_OFFSET(2,1) 0 ; mm ! [D] Added (after gain) to get jounce stop deflection
JNC_START_CMP_JSTOP(2,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_JSTOP(2,1) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_JSTOP)

CMP_JSTOP_COEFFICIENT(2,2) 0.801 ! Jounce stop deflection per unit jounce at wheel
                                 ! (mm/mm), axle 2, right side
CMP_JSTOP_GAIN(2,2) 1 ! [D] Multiplied with calculated value to get jounce stop
                      ! deflection
CMP_JSTOP_OFFSET(2,2) 0 ; mm ! [D] Added (after gain) to get jounce stop deflection
JNC_START_CMP_JSTOP(2,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_JSTOP(2,2) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_JSTOP)

! CMP_RSTOP: Rebound stop deflection. Rebound stop deflection can be a nonlinear
! CARPET function of jounce at wheel (other side) and jounce at wheel or a function
! of jounce at wheel (CONSTANT, COEFFICIENT, or TABLE). Rebound stop deflection from
! the calculation can be adjusted with CMP_RSTOP_GAIN and CMP_RSTOP_OFFSET. Jounce at
! wheel used in the calculation can be adjusted with JNC_SCALE_CMP_RSTOP and
! JNC_START_CMP_RSTOP. Jounce at wheel (other side) used in the calculation can be
! adjusted with JNC2_SCALE_CMP_RSTOP and JNC2_START_CMP_RSTOP. The derivative of this
! function is used internally. This configurable function supports 4 datasets; if
! indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

CMP_RSTOP_COEFFICIENT(1,1) 0.614 ! Rebound stop deflection per unit jounce at wheel
                                 ! (mm/mm), axle 1, left side
CMP_RSTOP_GAIN(1,1) 1 ! [D] Multiplied with calculated value to get rebound stop
                      ! deflection
CMP_RSTOP_OFFSET(1,1) 0 ; mm ! [D] Added (after gain) to get rebound stop deflection
JNC_START_CMP_RSTOP(1,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_RSTOP(1,1) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_RSTOP)

CMP_RSTOP_COEFFICIENT(1,2) 0.614 ! Rebound stop deflection per unit jounce at wheel
                                 ! (mm/mm), axle 1, right side
CMP_RSTOP_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get rebound stop
                      ! deflection
CMP_RSTOP_OFFSET(1,2) 0 ; mm ! [D] Added (after gain) to get rebound stop deflection
JNC_START_CMP_RSTOP(1,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_RSTOP(1,2) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_RSTOP)

CMP_RSTOP_COEFFICIENT(2,1) 60 ! Rebound stop deflection per unit jounce at wheel
                              ! (mm/mm), axle 2, left side
CMP_RSTOP_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get rebound stop
                      ! deflection
CMP_RSTOP_OFFSET(2,1) 0 ; mm ! [D] Added (after gain) to get rebound stop deflection
JNC_START_CMP_RSTOP(2,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_RSTOP(2,1) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_RSTOP)

CMP_RSTOP_COEFFICIENT(2,2) 60 ! Rebound stop deflection per unit jounce at wheel
                              ! (mm/mm), axle 2, right side
CMP_RSTOP_GAIN(2,2) 1 ! [D] Multiplied with calculated value to get rebound stop
                      ! deflection
CMP_RSTOP_OFFSET(2,2) 0 ; mm ! [D] Added (after gain) to get rebound stop deflection
JNC_START_CMP_RSTOP(2,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_RSTOP(2,2) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_RSTOP)

! CMP_SPR_SEAT: Lower spring seat movement. Lower spring seat movement can be a
! nonlinear CARPET function of jounce at wheel (other side) and jounce at wheel or a
! function of jounce at wheel (COEFFICIENT or TABLE). Lower spring seat movement from
! the calculation can be adjusted with CMP_SPR_SEAT_GAIN and CMP_SPR_SEAT_OFFSET.
! Jounce at wheel used in the calculation can be adjusted with JNC_SCALE_CMP_SPR_SEAT
! and JNC_START_CMP_SPR_SEAT. Jounce at wheel (other side) used in the calculation
! can be adjusted with JNC2_SCALE_CMP_SPR_SEAT and JNC2_START_CMP_SPR_SEAT. An
! inverse version of this function is used internally. The derivative of this
! function is used internally. This configurable function supports 4 datasets; if
! indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

CMP_SPR_SEAT_COEFFICIENT(1,1) 0.606 ! Lower spring seat movement per unit jounce at
                                    ! wheel (mm/mm), axle 1, left side
CMP_SPR_SEAT_GAIN(1,1) 1 ! [D] Multiplied with calculated value to get lower spring
                         ! seat movement
CMP_SPR_SEAT_OFFSET(1,1) 0 ; mm ! [D] Added (after gain) to get lower spring seat
                           ! movement
JNC_START_CMP_SPR_SEAT(1,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_SPR_SEAT(1,1) 1 ! [D] Divided into (jounce at wheel -
                              ! JNC_START_CMP_SPR_SEAT)

CMP_SPR_SEAT_COEFFICIENT(1,2) 0.606 ! Lower spring seat movement per unit jounce at
                                    ! wheel (mm/mm), axle 1, right side
CMP_SPR_SEAT_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get lower spring
                         ! seat movement
CMP_SPR_SEAT_OFFSET(1,2) 0 ; mm ! [D] Added (after gain) to get lower spring seat
                           ! movement
JNC_START_CMP_SPR_SEAT(1,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_SPR_SEAT(1,2) 1 ! [D] Divided into (jounce at wheel -
                              ! JNC_START_CMP_SPR_SEAT)

CMP_SPR_SEAT_COEFFICIENT(2,1) 0.406 ! Lower spring seat movement per unit jounce at
                                    ! wheel (mm/mm), axle 2, left side
CMP_SPR_SEAT_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get lower spring
                         ! seat movement
CMP_SPR_SEAT_OFFSET(2,1) 0 ; mm ! [D] Added (after gain) to get lower spring seat
                           ! movement
JNC_START_CMP_SPR_SEAT(2,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_SPR_SEAT(2,1) 1 ! [D] Divided into (jounce at wheel -
                              ! JNC_START_CMP_SPR_SEAT)

CMP_SPR_SEAT_COEFFICIENT(2,2) 0.406 ! Lower spring seat movement per unit jounce at
                                    ! wheel (mm/mm), axle 2, right side
CMP_SPR_SEAT_GAIN(2,2) 1 ! [D] Multiplied with calculated value to get lower spring
                         ! seat movement
CMP_SPR_SEAT_OFFSET(2,2) 0 ; mm ! [D] Added (after gain) to get lower spring seat
                           ! movement
JNC_START_CMP_SPR_SEAT(2,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_SPR_SEAT(2,2) 1 ! [D] Divided into (jounce at wheel -
                              ! JNC_START_CMP_SPR_SEAT)

! CS_FY: Compliance: steer due to in- and out-phase Fy. Steer displacement can be a
! nonlinear CARPET function of force (other side) and force or a function of force
! (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined
! at runtime. Steer displacement from the calculation can be adjusted with CS_FY_GAIN
! and CS_FY_OFFSET. Force used in the calculation can be adjusted with F_SCALE_CS_FY
! and F_START_CS_FY. Force (other side) used in the calculation can be adjusted with
! F2_SCALE_CS_FY and F2_START_CS_FY. This configurable function supports 4 datasets;
! if indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

CS_FY_COEFFICIENT(1,1) 7.4429e-06 ! Steer displacement per unit force (deg/N), axle
                                  ! 1, left side
CS_FY_GAIN(1,1)     1 ! [D] Multiplied with calculated value to get Steer
                      ! displacement
CS_FY_OFFSET(1,1)   0 ; deg ! [D] Added (after gain) to get Steer displacement
F_START_CS_FY(1,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CS_FY(1,1)  1 ! [D] Divided into (force - F_START_CS_FY)

CS_FY_COEFFICIENT(1,2) 7.4429e-06 ! Steer displacement per unit force (deg/N), axle
                                  ! 1, right side
CS_FY_GAIN(1,2)     1 ! [D] Multiplied with calculated value to get Steer
                      ! displacement
CS_FY_OFFSET(1,2)   0 ; deg ! [D] Added (after gain) to get Steer displacement
F_START_CS_FY(1,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CS_FY(1,2)  1 ! [D] Divided into (force - F_START_CS_FY)

CS_FY_COEFFICIENT(2,1) 1.3094e-06 ! Steer displacement per unit force (deg/N), axle
                                  ! 2, left side
CS_FY_GAIN(2,1)     1 ! [D] Multiplied with calculated value to get Steer
                      ! displacement
CS_FY_OFFSET(2,1)   0 ; deg ! [D] Added (after gain) to get Steer displacement
F_START_CS_FY(2,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CS_FY(2,1)  1 ! [D] Divided into (force - F_START_CS_FY)

CS_FY_COEFFICIENT(2,2) 1.3094e-06 ! Steer displacement per unit force (deg/N), axle
                                  ! 2, right side
CS_FY_GAIN(2,2)     1 ! [D] Multiplied with calculated value to get Steer
                      ! displacement
CS_FY_OFFSET(2,2)   0 ; deg ! [D] Added (after gain) to get Steer displacement
F_START_CS_FY(2,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CS_FY(2,2)  1 ! [D] Divided into (force - F_START_CS_FY)

! CS_MZ: Compliance: steer due to in- and out-phase Mz. Steer displacement can be a
! nonlinear CARPET function of moment and moment or a function of moment (CONSTANT,
! COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined at runtime.
! Steer displacement from the calculation can be adjusted with CS_MZ_GAIN and
! CS_MZ_OFFSET. Moment used in the calculation can be adjusted with M_SCALE_CS_MZ and
! M_START_CS_MZ. Moment used in the calculation can be adjusted with M2_SCALE_CS_MZ
! and M2_START_CS_MZ. This configurable function supports 4 datasets; if indices
! shown below are not used, e.g., (1,2), the current values of the indices IAXLE and
! ISIDE are used to identify the dataset when reading data.

CS_MZ_COEFFICIENT(1,1) 1.9755 ! Steer displacement per unit moment (deg/N-m), axle
                              ! 1, left side
CS_MZ_GAIN(1,1)     1 ! [D] Multiplied with calculated value to get steer
                      ! displacement
CS_MZ_OFFSET(1,1)   0 ; deg ! [D] Added (after gain) to get steer displacement
M_START_CS_MZ(1,1)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CS_MZ(1,1)  1 ! [D] Divided into (moment - M_START_CS_MZ)

CS_MZ_COEFFICIENT(1,2) 1.9755 ! Steer displacement per unit moment (deg/N-m), axle
                              ! 1, right side
CS_MZ_GAIN(1,2)     1 ! [D] Multiplied with calculated value to get steer
                      ! displacement
CS_MZ_OFFSET(1,2)   0 ; deg ! [D] Added (after gain) to get steer displacement
M_START_CS_MZ(1,2)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CS_MZ(1,2)  1 ! [D] Divided into (moment - M_START_CS_MZ)

CS_MZ_COEFFICIENT(2,1) 2.5834 ! Steer displacement per unit moment (deg/N-m), axle
                              ! 2, left side
CS_MZ_GAIN(2,1)     1 ! [D] Multiplied with calculated value to get steer
                      ! displacement
CS_MZ_OFFSET(2,1)   0 ; deg ! [D] Added (after gain) to get steer displacement
M_START_CS_MZ(2,1)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CS_MZ(2,1)  1 ! [D] Divided into (moment - M_START_CS_MZ)

CS_MZ_COEFFICIENT(2,2) 2.5834 ! Steer displacement per unit moment (deg/N-m), axle
                              ! 2, right side
CS_MZ_GAIN(2,2)     1 ! [D] Multiplied with calculated value to get steer
                      ! displacement
CS_MZ_OFFSET(2,2)   0 ; deg ! [D] Added (after gain) to get steer displacement
M_START_CS_MZ(2,2)  0 ; N-m ! [D] Subtracted from moment
M_SCALE_CS_MZ(2,2)  1 ! [D] Divided into (moment - M_START_CS_MZ)

! CT_FX: Compliance: wheel toe due to in- and out-phase Fx. Toe displacement can be
! a nonlinear CARPET function of force (other side) and force or a function of force
! (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined
! at runtime. Toe displacement from the calculation can be adjusted with CT_FX_GAIN
! and CT_FX_OFFSET. Force used in the calculation can be adjusted with F_SCALE_CT_FX
! and F_START_CT_FX. Force (other side) used in the calculation can be adjusted with
! F2_SCALE_CT_FX and F2_START_CT_FX. This configurable function supports 4 datasets;
! if indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

CT_FX_COEFFICIENT(1,1) -0.97083 ! Toe displacement per unit force (deg/N), axle 1,
                                ! left side
CT_FX_GAIN(1,1)     1 ! [D] Multiplied with calculated value to get toe displacement
CT_FX_OFFSET(1,1)   0 ; deg ! [D] Added (after gain) to get toe displacement
F_START_CT_FX(1,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CT_FX(1,1)  1 ! [D] Divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(1,2) -0.97083 ! Toe displacement per unit force (deg/N), axle 1,
                                ! right side
CT_FX_GAIN(1,2)     1 ! [D] Multiplied with calculated value to get toe displacement
CT_FX_OFFSET(1,2)   0 ; deg ! [D] Added (after gain) to get toe displacement
F_START_CT_FX(1,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CT_FX(1,2)  1 ! [D] Divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(2,1) -1.471e-05 ! Toe displacement per unit force (deg/N), axle 2,
                                  ! left side
CT_FX_GAIN(2,1)     1 ! [D] Multiplied with calculated value to get toe displacement
CT_FX_OFFSET(2,1)   0 ; deg ! [D] Added (after gain) to get toe displacement
F_START_CT_FX(2,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CT_FX(2,1)  1 ! [D] Divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(2,2) -1.471e-05 ! Toe displacement per unit force (deg/N), axle 2,
                                  ! right side
CT_FX_GAIN(2,2)     1 ! [D] Multiplied with calculated value to get toe displacement
CT_FX_OFFSET(2,2)   0 ; deg ! [D] Added (after gain) to get toe displacement
F_START_CT_FX(2,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CT_FX(2,2)  1 ! [D] Divided into (force - F_START_CT_FX)

! C_LAT: Compliance: lateral displacement of wheel due to in- and out-phase Fy .
! Lateral displacement can be a nonlinear CARPET function of force (other side) and
! force or a function of force (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a
! custom equation can be defined at runtime. Lateral displacement from the
! calculation can be adjusted with C_LAT_GAIN and C_LAT_OFFSET. Force used in the
! calculation can be adjusted with F_SCALE_C_LAT and F_START_C_LAT. Force (other
! side) used in the calculation can be adjusted with F2_SCALE_C_LAT and
! F2_START_C_LAT. This configurable function supports 4 datasets; if indices shown
! below are not used, e.g., (1,2), the current values of the indices IAXLE and ISIDE
! are used to identify the dataset when reading data.

C_LAT_COEFFICIENT(1,1) 7.37e-05 ! Lateral displacement per unit force (mm/N), axle
                                ! 1, left side
C_LAT_GAIN(1,1)     1 ! [D] Multiplied with calculated value to get lateral
                      ! displacement
C_LAT_OFFSET(1,1)   0 ; mm ! [D] Added (after gain) to get lateral displacement
F_START_C_LAT(1,1)  0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT(1,1)  1 ! [D] Divided into (force - F_START_C_LAT)

C_LAT_COEFFICIENT(1,2) 7.37e-05 ! Lateral displacement per unit force (mm/N), axle
                                ! 1, right side
C_LAT_GAIN(1,2)     1 ! [D] Multiplied with calculated value to get lateral
                      ! displacement
C_LAT_OFFSET(1,2)   0 ; mm ! [D] Added (after gain) to get lateral displacement
F_START_C_LAT(1,2)  0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT(1,2)  1 ! [D] Divided into (force - F_START_C_LAT)

C_LAT_COEFFICIENT(2,1) 4.6641e-05 ! Lateral displacement per unit force (mm/N), axle
                                  ! 2, left side
C_LAT_GAIN(2,1)     1 ! [D] Multiplied with calculated value to get lateral
                      ! displacement
C_LAT_OFFSET(2,1)   0 ; mm ! [D] Added (after gain) to get lateral displacement
F_START_C_LAT(2,1)  0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT(2,1)  1 ! [D] Divided into (force - F_START_C_LAT)

C_LAT_COEFFICIENT(2,2) 4.6641e-05 ! Lateral displacement per unit force (mm/N), axle
                                  ! 2, right side
C_LAT_GAIN(2,2)     1 ! [D] Multiplied with calculated value to get lateral
                      ! displacement
C_LAT_OFFSET(2,2)   0 ; mm ! [D] Added (after gain) to get lateral displacement
F_START_C_LAT(2,2)  0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT(2,2)  1 ! [D] Divided into (force - F_START_C_LAT)

! C_LONG: Compliance: wheel longitudinal displacement due to in- and out-phase Fx. X
! displacement can be a nonlinear CARPET function of force (other side) and force or
! a function of force (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom
! equation can be defined at runtime. X displacement from the calculation can be
! adjusted with C_LONG_GAIN and C_LONG_OFFSET. Force used in the calculation can be
! adjusted with F_SCALE_C_LONG and F_START_C_LONG. Force (other side) used in the
! calculation can be adjusted with F2_SCALE_C_LONG and F2_START_C_LONG. This
! configurable function supports 4 datasets; if indices shown below are not used,
! e.g., (1,2), the current values of the indices IAXLE and ISIDE are used to identify
! the dataset when reading data.

C_LONG_COEFFICIENT(1,1) 0.0041689 ! X displacement per unit force (mm/N), axle 1,
                                  ! left side
C_LONG_GAIN(1,1)    1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(1,1)  0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(1,1) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(1,1) 1 ! [D] Divided into (force - F_START_C_LONG)

C_LONG_COEFFICIENT(1,2) 0.0041689 ! X displacement per unit force (mm/N), axle 1,
                                  ! right side
C_LONG_GAIN(1,2)    1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(1,2)  0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(1,2) 1 ! [D] Divided into (force - F_START_C_LONG)

C_LONG_COEFFICIENT(2,1) 0.0014438 ! X displacement per unit force (mm/N), axle 2,
                                  ! left side
C_LONG_GAIN(2,1)    1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(2,1)  0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(2,1) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(2,1) 1 ! [D] Divided into (force - F_START_C_LONG)

C_LONG_COEFFICIENT(2,2) 0.0014438 ! X displacement per unit force (mm/N), axle 2,
                                  ! right side
C_LONG_GAIN(2,2)    1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(2,2)  0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(2,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(2,2) 1 ! [D] Divided into (force - F_START_C_LONG)

! FD: Suspension damper force (1 side). Damper force is a function of compression
! speed (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be
! defined at runtime. Damper force from the calculation can be adjusted with FD_GAIN
! and FD_OFFSET. Compression speed used in the calculation can be adjusted with
! CMP_R_SCALE_FD and CMP_R_START_FD. This configurable function supports 4 datasets;
! if indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

! Col 1 = compression speed (mm/s), col 2 = damper force (N)
FD_TABLE(1,1) SPLINE ! axle 1, left side
 -1050, -645
 -520, -335
 -260, -202
 -130, -130
 -50, -75
 0, 0
 50, 61
 130, 102
 260, 135
 520, 202
 1050, 372
ENDTABLE
FD_GAIN(1,1)        1 ! [D] Multiplied with calculated value to get damper force
FD_OFFSET(1,1)      0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(1,1) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(1,1) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

! Col 1 = compression speed (mm/s), col 2 = damper force (N)
FD_TABLE(1,2) SPLINE ! axle 1, right side
 -1050, -645
 -520, -335
 -260, -202
 -130, -130
 -50, -75
 0, 0
 50, 61
 130, 102
 260, 135
 520, 202
 1050, 372
ENDTABLE
FD_GAIN(1,2)        1 ! [D] Multiplied with calculated value to get damper force
FD_OFFSET(1,2)      0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(1,2) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(1,2) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

! Col 1 = compression speed (mm/s), col 2 = damper force (N)
FD_TABLE(2,1) SPLINE ! axle 2, left side
 -1050, -645
 -520, -335
 -260, -202
 -130, -130
 -50, -75
 0, 0
 50, 61
 130, 102
 260, 135
 520, 202
 1050, 372
ENDTABLE
FD_GAIN(2,1)        1 ! [D] Multiplied with calculated value to get damper force
FD_OFFSET(2,1)      0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(2,1) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(2,1) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

! Col 1 = compression speed (mm/s), col 2 = damper force (N)
FD_TABLE(2,2) SPLINE ! axle 2, right side
 -1050, -645
 -520, -335
 -260, -202
 -130, -130
 -50, -75
 0, 0
 50, 61
 130, 102
 260, 135
 520, 202
 1050, 372
ENDTABLE
FD_GAIN(2,2)        1 ! [D] Multiplied with calculated value to get damper force
FD_OFFSET(2,2)      0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(2,2) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(2,2) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

! FS_COMP: Compression (upper) envelope of suspension spring force (1 side). Spring
! force can be a nonlinear CARPET function of static spring force and spring
! compression or a function of spring compression (CONSTANT, COEFFICIENT, or TABLE)
! combined with a function FS_COMP_FSTATIC of static spring force (CONSTANT,
! COEFFICIENT, or TABLE). Spring force from the calculation can be adjusted with
! FS_COMP_GAIN and FS_COMP_OFFSET. Spring compression used in the calculation can be
! adjusted with CMP_SCALE_FS_COMP and CMP_START_FS_COMP. Static spring force used in
! the calculation can be adjusted with FSTATIC_SCALE_FS_COMP and
! FSTATIC_START_FS_COMP. An inverse version of this function is used internally. This
! configurable function supports 4 datasets; if indices shown below are not used,
! e.g., (1,2), the current values of the indices IAXLE and ISIDE are used to identify
! the dataset when reading data.

FS_COMP_COEFFICIENT(1,1) 80 ! Spring force per unit spring compression (N/mm), axle
                            ! 1, left side
FS_COMP_GAIN(1,1)   1 ! [D] Multiplied with calculated value to get spring force
FS_COMP_OFFSET(1,1) 20 ; N ! Added (after gain) to get spring force
CMP_START_FS_COMP(1,1) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_COMP(1,1) 1 ! [D] Divided into (spring compression - CMP_START_FS_COMP)
FS_COMP_COMBINE(1,1) MULTIPLY ! [D] How to combine the two components
FS_COMP_FSTATIC_CONSTANT(1,1) 1 ; - ! [D] Spring force component due to static
                                ! spring force, axle 1, left side

FS_COMP_COEFFICIENT(1,2) 80 ! Spring force per unit spring compression (N/mm), axle
                            ! 1, right side
FS_COMP_GAIN(1,2)   1 ! [D] Multiplied with calculated value to get spring force
FS_COMP_OFFSET(1,2) 20 ; N ! Added (after gain) to get spring force
CMP_START_FS_COMP(1,2) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_COMP(1,2) 1 ! [D] Divided into (spring compression - CMP_START_FS_COMP)
FS_COMP_COMBINE(1,2) MULTIPLY ! [D] How to combine the two components
FS_COMP_FSTATIC_CONSTANT(1,2) 1 ; - ! [D] Spring force component due to static
                                ! spring force, axle 1, right side

FS_COMP_COEFFICIENT(2,1) 155 ! Spring force per unit spring compression (N/mm), axle
                             ! 2, left side
FS_COMP_GAIN(2,1)   1 ! [D] Multiplied with calculated value to get spring force
FS_COMP_OFFSET(2,1) 20 ; N ! Added (after gain) to get spring force
CMP_START_FS_COMP(2,1) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_COMP(2,1) 1 ! [D] Divided into (spring compression - CMP_START_FS_COMP)
FS_COMP_COMBINE(2,1) MULTIPLY ! [D] How to combine the two components
FS_COMP_FSTATIC_CONSTANT(2,1) 1 ; - ! [D] Spring force component due to static
                                ! spring force, axle 2, left side

FS_COMP_COEFFICIENT(2,2) 155 ! Spring force per unit spring compression (N/mm), axle
                             ! 2, right side
FS_COMP_GAIN(2,2)   1 ! [D] Multiplied with calculated value to get spring force
FS_COMP_OFFSET(2,2) 20 ; N ! Added (after gain) to get spring force
CMP_START_FS_COMP(2,2) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_COMP(2,2) 1 ! [D] Divided into (spring compression - CMP_START_FS_COMP)
FS_COMP_COMBINE(2,2) MULTIPLY ! [D] How to combine the two components
FS_COMP_FSTATIC_CONSTANT(2,2) 1 ; - ! [D] Spring force component due to static
                                ! spring force, axle 2, right side

! FS_EXT: Extension (lower) envelope of suspension spring force (1 side). Spring
! force can be a nonlinear CARPET function of static spring force and spring
! compression or a function of spring compression (CONSTANT, COEFFICIENT, or TABLE)
! combined with a function FS_EXT_FSTATIC of static spring force (CONSTANT,
! COEFFICIENT, or TABLE). Spring force from the calculation can be adjusted with
! FS_EXT_GAIN and FS_EXT_OFFSET. Spring compression used in the calculation can be
! adjusted with CMP_SCALE_FS_EXT and CMP_START_FS_EXT. Static spring force used in
! the calculation can be adjusted with FSTATIC_SCALE_FS_EXT and FSTATIC_START_FS_EXT.
! An inverse version of this function is used internally. This configurable function
! supports 4 datasets; if indices shown below are not used, e.g., (1,2), the current
! values of the indices IAXLE and ISIDE are used to identify the dataset when reading
! data.

FS_EXT_COEFFICIENT(1,1) 80 ! Spring force per unit spring compression (N/mm), axle
                           ! 1, left side
FS_EXT_GAIN(1,1)    1 ! [D] Multiplied with calculated value to get spring force
FS_EXT_OFFSET(1,1) -20 ; N ! Added (after gain) to get spring force
CMP_START_FS_EXT(1,1) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_EXT(1,1) 1 ! [D] Divided into (spring compression - CMP_START_FS_EXT)
FS_EXT_COMBINE(1,1) MULTIPLY ! [D] How to combine the two components
FS_EXT_FSTATIC_CONSTANT(1,1) 1 ; - ! [D] Spring force component due to static spring
                               ! force, axle 1, left side

FS_EXT_COEFFICIENT(1,2) 80 ! Spring force per unit spring compression (N/mm), axle
                           ! 1, right side
FS_EXT_GAIN(1,2)    1 ! [D] Multiplied with calculated value to get spring force
FS_EXT_OFFSET(1,2) -20 ; N ! Added (after gain) to get spring force
CMP_START_FS_EXT(1,2) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_EXT(1,2) 1 ! [D] Divided into (spring compression - CMP_START_FS_EXT)
FS_EXT_COMBINE(1,2) MULTIPLY ! [D] How to combine the two components
FS_EXT_FSTATIC_CONSTANT(1,2) 1 ; - ! [D] Spring force component due to static spring
                               ! force, axle 1, right side

FS_EXT_COEFFICIENT(2,1) 155 ! Spring force per unit spring compression (N/mm), axle
                            ! 2, left side
FS_EXT_GAIN(2,1)    1 ! [D] Multiplied with calculated value to get spring force
FS_EXT_OFFSET(2,1) -20 ; N ! Added (after gain) to get spring force
CMP_START_FS_EXT(2,1) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_EXT(2,1) 1 ! [D] Divided into (spring compression - CMP_START_FS_EXT)
FS_EXT_COMBINE(2,1) MULTIPLY ! [D] How to combine the two components
FS_EXT_FSTATIC_CONSTANT(2,1) 1 ; - ! [D] Spring force component due to static spring
                               ! force, axle 2, left side

FS_EXT_COEFFICIENT(2,2) 155 ! Spring force per unit spring compression (N/mm), axle
                            ! 2, right side
FS_EXT_GAIN(2,2)    1 ! [D] Multiplied with calculated value to get spring force
FS_EXT_OFFSET(2,2) -20 ; N ! Added (after gain) to get spring force
CMP_START_FS_EXT(2,2) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_EXT(2,2) 1 ! [D] Divided into (spring compression - CMP_START_FS_EXT)
FS_EXT_COMBINE(2,2) MULTIPLY ! [D] How to combine the two components
FS_EXT_FSTATIC_CONSTANT(2,2) 1 ; - ! [D] Spring force component due to static spring
                               ! force, axle 2, right side

! FUEL_RATE: Fuel consumption rate. Fuel rate can be a nonlinear CARPET function of
! throttle position and engine speed or a function of engine speed (CONSTANT or
! TABLE) multiplied by a function FUEL_RATE_THROTTLE of throttle position (CONSTANT,
! COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined at runtime.
! Fuel rate from the calculation can be adjusted with FUEL_RATE_GAIN and
! FUEL_RATE_OFFSET. Engine speed used in the calculation can be adjusted with
! SPIN_SCALE_FUEL_RATE and SPIN_START_FUEL_RATE. Throttle position used in the
! calculation can be adjusted with THROTTLE_SCALE_FUEL_RATE and
! THROTTLE_START_FUEL_RATE.

FUEL_RATE_CONSTANT  0 ; kg/s ! [D] Fuel rate component due to engine speed
FUEL_RATE_GAIN      1 ! [D] Multiplied with calculated value to get fuel rate
FUEL_RATE_OFFSET    0 ; kg/s ! [D] Added to get fuel rate
FUEL_RATE_THROTTLE_CONSTANT 1 ; - ! [D] Fuel rate scaling due to throttle position

! FX_AERO_SHAPING: Coefficient CFX for for X component of aerodynamic force. CFX is
! a function of aerodynamic slip angle (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. CFX from the
! calculation can be adjusted with FX_AERO_SHAPING_GAIN and FX_AERO_SHAPING_OFFSET.
! Aerodynamic slip angle used in the calculation can be adjusted with
! SLIP_SCALE_FX_AERO and SLIP_START_FX_AERO.

! Col 1 = aerodynamic slip angle (deg), col 2 = CFX (-)
FX_AERO_SHAPING_TABLE SPLINE_FLAT ! spline interpolation, flat-line extrapolation
 -180, -0.45
 -160, -0.45
 -90, 0
 -20, 0.325
 0, 0.3
 20, 0.325
 90, 0
 160, -0.45
 180, -0.45
ENDTABLE
FX_AERO_SHAPING_GAIN 1 ! [D] Multiplied with calculated value to get CFX
FX_AERO_SHAPING_OFFSET 0 ; - ! [D] Added (after gain) to get CFX
SLIP_START_FX_AERO  0 ; deg ! [D] Subtracted from aerodynamic slip angle
SLIP_SCALE_FX_AERO  1 ! [D] Divided into (aerodynamic slip angle -
                      ! SLIP_START_FX_AERO)

! FX_AERO_SHAPING_2: Coefficient CFX2 for X component of aerodynamic force. CFX2 can
! be a nonlinear CARPET function of ride height and pitch or a function of pitch
! (CONSTANT, COEFFICIENT, or TABLE) combined with a function FX_AERO_SHAPING_Z of
! ride height (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can
! be defined at runtime. CFX2 from the calculation can be adjusted with
! FX_AERO_SHAPING_2_GAIN and FX_AERO_SHAPING_2_OFFSET. Pitch used in the calculation
! can be adjusted with PITCH_SCALE_FX_AERO and PITCH_START_FX_AERO. Ride height used
! in the calculation can be adjusted with Z_SCALE_FX_AERO and Z_START_FX_AERO.

FX_AERO_SHAPING_2_CONSTANT 1 ; - ! [D] CFX2 component due to pitch
FX_AERO_SHAPING_2_GAIN 1 ! [D] Multiplied with calculated value to get CFX2
FX_AERO_SHAPING_2_OFFSET 0 ; - ! [D] Added to get CFX2
FX_AERO_SHAPING_2_COMBINE MULTIPLY ! [D] How to combine the two components
FX_AERO_SHAPING_Z_CONSTANT 1 ; - ! [D] CFX2 component due to ride height

