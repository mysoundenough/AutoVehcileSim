                                ! RACK_DISP_START_DIVE_VIR)

! DOWNSHIFT_TRANS: Transmission speed when downshift occurs. IGEAR specifies the
! lower gear for each table (e.g., IGEAR 2 means downshift from 3 to 2). Transmission
! speed is a function of throttle position (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. Transmission speed from
! the calculation can be adjusted with DOWNSHIFT_TRANS_GAIN and
! DOWNSHIFT_TRANS_OFFSET. Throttle position used in the calculation can be adjusted
! with THROTTLE_SCALE_DOWNSHIFT and THROTTLE_START_DOWNSHIFT. This configurable
! function supports 17 datasets; if indices shown below are not used, e.g., (2), the
! current value of the index IGEAR is used to identify the dataset when reading data.

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
DOWNSHIFT_TRANS_TABLE(1) LINEAR_FLAT ! shifting between gears 1 and 2
 0, 699
 0.4, 699
 0.8, 1240
 1, 1240
ENDTABLE
DOWNSHIFT_TRANS_GAIN(1) 1 ! [D] Multiplied with calculated value to get transmission
                          ! speed
DOWNSHIFT_TRANS_OFFSET(1) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_DOWNSHIFT(1) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_DOWNSHIFT(1) 1 ! [D] Divided into (throttle position -
                              ! THROTTLE_START_DOWNSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
DOWNSHIFT_TRANS_TABLE(2) LINEAR_FLAT ! shifting between gears 2 and 3
 0, 1026
 0.4, 1026
 0.8, 2130
 1, 2130
ENDTABLE
DOWNSHIFT_TRANS_GAIN(2) 1 ! [D] Multiplied with calculated value to get transmission
                          ! speed
DOWNSHIFT_TRANS_OFFSET(2) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_DOWNSHIFT(2) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_DOWNSHIFT(2) 1 ! [D] Divided into (throttle position -
                              ! THROTTLE_START_DOWNSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
DOWNSHIFT_TRANS_TABLE(3) LINEAR_FLAT ! shifting between gears 3 and 4
 0, 1440
 0.4, 1440
 0.8, 3125
 1, 3125
ENDTABLE
DOWNSHIFT_TRANS_GAIN(3) 1 ! [D] Multiplied with calculated value to get transmission
                          ! speed
DOWNSHIFT_TRANS_OFFSET(3) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_DOWNSHIFT(3) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_DOWNSHIFT(3) 1 ! [D] Divided into (throttle position -
                              ! THROTTLE_START_DOWNSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
DOWNSHIFT_TRANS_TABLE(4) LINEAR_FLAT ! shifting between gears 4 and 5
 0, 2020
 0.4, 2020
 0.8, 4388
 1, 4388
ENDTABLE
DOWNSHIFT_TRANS_GAIN(4) 1 ! [D] Multiplied with calculated value to get transmission
                          ! speed
DOWNSHIFT_TRANS_OFFSET(4) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_DOWNSHIFT(4) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_DOWNSHIFT(4) 1 ! [D] Divided into (throttle position -
                              ! THROTTLE_START_DOWNSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
DOWNSHIFT_TRANS_TABLE(5) LINEAR_FLAT ! shifting between gears 5 and 6
 0, 2474
 0.4, 2474
 0.8, 6154
 1, 6154
ENDTABLE
DOWNSHIFT_TRANS_GAIN(5) 1 ! [D] Multiplied with calculated value to get transmission
                          ! speed
DOWNSHIFT_TRANS_OFFSET(5) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_DOWNSHIFT(5) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_DOWNSHIFT(5) 1 ! [D] Divided into (throttle position -
                              ! THROTTLE_START_DOWNSHIFT)

! FD: Suspension damper force (1 side). Damper force is a function of compression
! speed (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be
! defined at runtime. Damper force from the calculation can be adjusted with FD_GAIN
! and FD_OFFSET. Compression speed used in the calculation can be adjusted with
! CMP_R_SCALE_FD and CMP_R_START_FD. This configurable function supports 4 datasets;
! if indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

! Col 1 = compression speed (mm/s), col 2 = damper force (N)
FD_TABLE(1,1) SPLINE ! axle 1, left side
 -1410, -5008
 -720, -3436
 -390, -2324
 -210, -1792
 -90, -1008
 -20, -228
 0, 0
 20, 228
 90, 596
 200, 784
 390, 1100
 760, 1796
 1160, 2560
ENDTABLE
FD_GAIN(1,1)        1 ! [D] Multiplied with calculated value to get damper force
FD_OFFSET(1,1)      0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(1,1) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(1,1) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

! Col 1 = compression speed (mm/s), col 2 = damper force (N)
FD_TABLE(1,2) SPLINE ! axle 1, right side
 -1410, -5008
 -720, -3436
 -390, -2324
 -210, -1792
 -90, -1008
 -20, -228
 0, 0
 20, 228
 90, 596
 200, 784
 390, 1100
 760, 1796
 1160, 2560
ENDTABLE
FD_GAIN(1,2)        1 ! [D] Multiplied with calculated value to get damper force
FD_OFFSET(1,2)      0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(1,2) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(1,2) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

! Col 1 = compression speed (mm/s), col 2 = damper force (N)
FD_TABLE(2,1) SPLINE ! axle 2, left side
 -1410, -5008
 -720, -3436
 -390, -2324
 -210, -1792
 -90, -1008
 -20, -228
 0, 0
 20, 228
 90, 596
 200, 784
 390, 1100
 760, 1796
 1160, 2560
ENDTABLE
FD_GAIN(2,1)        1 ! [D] Multiplied with calculated value to get damper force
FD_OFFSET(2,1)      0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(2,1) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(2,1) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

! Col 1 = compression speed (mm/s), col 2 = damper force (N)
FD_TABLE(2,2) SPLINE ! axle 2, right side
 -1410, -5008
 -720, -3436
 -390, -2324
 -210, -1792
 -90, -1008
 -20, -228
 0, 0
 20, 228
 90, 596
 200, 784
 390, 1100
 760, 1796
 1160, 2560
ENDTABLE
FD_GAIN(2,2)        1 ! [D] Multiplied with calculated value to get damper force
FD_OFFSET(2,2)      0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(2,2) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(2,2) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

! FS_COMP: Compression (upper) envelope of suspension spring force (1 side). Spring
! force can be a nonlinear CARPET function of static spring force and spring
! compression or a function of spring compression (CONSTANT, COEFFICIENT, or TABLE)
! combined with a function FS_COMP_FSTATIC of static spring force (CONSTANT,
! COEFFICIENT, or TABLE). Spring force from the calculation can be adjusted with
! FS_COMP_GAIN and FS_COMP_OFFSET. Spring compression used in the calculation can be
! adjusted with CMP_SCALE_FS_COMP and CMP_START_FS_COMP. Static spring force used in
! the calculation can be adjusted with FSTATIC_SCALE_FS_COMP and
! FSTATIC_START_FS_COMP. An inverse version of this function is used internally. This
! configurable function supports 4 datasets; if indices shown below are not used,
! e.g., (1,2), the current values of the indices IAXLE and ISIDE are used to identify
! the dataset when reading data.

FS_COMP_COEFFICIENT(1,1) 153 ! Spring force per unit spring compression (N/mm), axle
                             ! 1, left side
FS_COMP_GAIN(1,1)   1 ! [D] Multiplied with calculated value to get spring force
FS_COMP_OFFSET(1,1) 20 ; N ! Added (after gain) to get spring force
CMP_START_FS_COMP(1,1) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_COMP(1,1) 1 ! [D] Divided into (spring compression - CMP_START_FS_COMP)
FS_COMP_COMBINE(1,1) MULTIPLY ! [D] How to combine the two components
FS_COMP_FSTATIC_CONSTANT(1,1) 1 ; - ! [D] Spring force component due to static
                                ! spring force, axle 1, left side

FS_COMP_COEFFICIENT(1,2) 153 ! Spring force per unit spring compression (N/mm), axle
                             ! 1, right side
FS_COMP_GAIN(1,2)   1 ! [D] Multiplied with calculated value to get spring force
FS_COMP_OFFSET(1,2) 20 ; N ! Added (after gain) to get spring force
CMP_START_FS_COMP(1,2) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_COMP(1,2) 1 ! [D] Divided into (spring compression - CMP_START_FS_COMP)
FS_COMP_COMBINE(1,2) MULTIPLY ! [D] How to combine the two components
FS_COMP_FSTATIC_CONSTANT(1,2) 1 ; - ! [D] Spring force component due to static
                                ! spring force, axle 1, right side

FS_COMP_COEFFICIENT(2,1) 82 ! Spring force per unit spring compression (N/mm), axle
                            ! 2, left side
FS_COMP_GAIN(2,1)   1 ! [D] Multiplied with calculated value to get spring force
FS_COMP_OFFSET(2,1) 20 ; N ! Added (after gain) to get spring force
CMP_START_FS_COMP(2,1) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_COMP(2,1) 1 ! [D] Divided into (spring compression - CMP_START_FS_COMP)
FS_COMP_COMBINE(2,1) MULTIPLY ! [D] How to combine the two components
FS_COMP_FSTATIC_CONSTANT(2,1) 1 ; - ! [D] Spring force component due to static
                                ! spring force, axle 2, left side

FS_COMP_COEFFICIENT(2,2) 82 ! Spring force per unit spring compression (N/mm), axle
                            ! 2, right side
FS_COMP_GAIN(2,2)   1 ! [D] Multiplied with calculated value to get spring force
FS_COMP_OFFSET(2,2) 20 ; N ! Added (after gain) to get spring force
CMP_START_FS_COMP(2,2) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_COMP(2,2) 1 ! [D] Divided into (spring compression - CMP_START_FS_COMP)
FS_COMP_COMBINE(2,2) MULTIPLY ! [D] How to combine the two components
FS_COMP_FSTATIC_CONSTANT(2,2) 1 ; - ! [D] Spring force component due to static
                                ! spring force, axle 2, right side

! FS_EXT: Extension (lower) envelope of suspension spring force (1 side). Spring
! force can be a nonlinear CARPET function of static spring force and spring
! compression or a function of spring compression (CONSTANT, COEFFICIENT, or TABLE)
! combined with a function FS_EXT_FSTATIC of static spring force (CONSTANT,
! COEFFICIENT, or TABLE). Spring force from the calculation can be adjusted with
! FS_EXT_GAIN and FS_EXT_OFFSET. Spring compression used in the calculation can be
! adjusted with CMP_SCALE_FS_EXT and CMP_START_FS_EXT. Static spring force used in
! the calculation can be adjusted with FSTATIC_SCALE_FS_EXT and FSTATIC_START_FS_EXT.
! An inverse version of this function is used internally. This configurable function
! supports 4 datasets; if indices shown below are not used, e.g., (1,2), the current
! values of the indices IAXLE and ISIDE are used to identify the dataset when reading
! data.

FS_EXT_COEFFICIENT(1,1) 153 ! Spring force per unit spring compression (N/mm), axle
                            ! 1, left side
FS_EXT_GAIN(1,1)    1 ! [D] Multiplied with calculated value to get spring force
FS_EXT_OFFSET(1,1) -20 ; N ! Added (after gain) to get spring force
CMP_START_FS_EXT(1,1) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_EXT(1,1) 1 ! [D] Divided into (spring compression - CMP_START_FS_EXT)
FS_EXT_COMBINE(1,1) MULTIPLY ! [D] How to combine the two components
FS_EXT_FSTATIC_CONSTANT(1,1) 1 ; - ! [D] Spring force component due to static spring
                               ! force, axle 1, left side

FS_EXT_COEFFICIENT(1,2) 153 ! Spring force per unit spring compression (N/mm), axle
                            ! 1, right side
FS_EXT_GAIN(1,2)    1 ! [D] Multiplied with calculated value to get spring force
FS_EXT_OFFSET(1,2) -20 ; N ! Added (after gain) to get spring force
CMP_START_FS_EXT(1,2) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_EXT(1,2) 1 ! [D] Divided into (spring compression - CMP_START_FS_EXT)
FS_EXT_COMBINE(1,2) MULTIPLY ! [D] How to combine the two components
FS_EXT_FSTATIC_CONSTANT(1,2) 1 ; - ! [D] Spring force component due to static spring
                               ! force, axle 1, right side

FS_EXT_COEFFICIENT(2,1) 82 ! Spring force per unit spring compression (N/mm), axle
                           ! 2, left side
FS_EXT_GAIN(2,1)    1 ! [D] Multiplied with calculated value to get spring force
FS_EXT_OFFSET(2,1) -20 ; N ! Added (after gain) to get spring force
CMP_START_FS_EXT(2,1) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_EXT(2,1) 1 ! [D] Divided into (spring compression - CMP_START_FS_EXT)
FS_EXT_COMBINE(2,1) MULTIPLY ! [D] How to combine the two components
FS_EXT_FSTATIC_CONSTANT(2,1) 1 ; - ! [D] Spring force component due to static spring
                               ! force, axle 2, left side

FS_EXT_COEFFICIENT(2,2) 82 ! Spring force per unit spring compression (N/mm), axle
                           ! 2, right side
FS_EXT_GAIN(2,2)    1 ! [D] Multiplied with calculated value to get spring force
FS_EXT_OFFSET(2,2) -20 ; N ! Added (after gain) to get spring force
CMP_START_FS_EXT(2,2) 0 ; mm ! [D] Subtracted from spring compression
CMP_SCALE_FS_EXT(2,2) 1 ! [D] Divided into (spring compression - CMP_START_FS_EXT)
FS_EXT_COMBINE(2,2) MULTIPLY ! [D] How to combine the two components
FS_EXT_FSTATIC_CONSTANT(2,2) 1 ; - ! [D] Spring force component due to static spring
                               ! force, axle 2, right side

! FUEL_RATE: Fuel consumption rate. Fuel rate can be a nonlinear CARPET function of
