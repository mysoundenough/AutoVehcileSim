! CMP_RSTOP: Rebound stop deflection. Rebound stop deflection can be a nonlinear
! CARPET function of jounce at wheel (other side) and jounce at wheel or a function
! of jounce at wheel (CONSTANT, COEFFICIENT, or TABLE). Rebound stop deflection from
! the calculation can be adjusted with CMP_RSTOP_GAIN and CMP_RSTOP_OFFSET. Jounce at
! wheel used in the calculation can be adjusted with JNC_SCALE_CMP_RSTOP and
! JNC_START_CMP_RSTOP. Jounce at wheel (other side) used in the calculation can be
! adjusted with JNC2_SCALE_CMP_RSTOP and JNC2_START_CMP_RSTOP. The derivative of this
! function is used internally. This configurable function supports 4 datasets; if
! indices shown below are not used, e.g., (1,2), the current values of the indices
! IAXLE and ISIDE are used to identify the dataset when reading data.

CMP_RSTOP_COEFFICIENT(2,1) 0.797 ! Rebound stop deflection per unit jounce at wheel
                                 ! (mm/mm), axle 2, left side
CMP_RSTOP_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get rebound stop
                      ! deflection
CMP_RSTOP_OFFSET(2,1) 0 ; mm ! [D] Added (after gain) to get rebound stop deflection
JNC_START_CMP_RSTOP(2,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_RSTOP(2,1) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_RSTOP)

CMP_RSTOP_COEFFICIENT(2,2) 0.797 ! Rebound stop deflection per unit jounce at wheel
                                 ! (mm/mm), axle 2, right side
CMP_RSTOP_GAIN(2,2) 1 ! [D] Multiplied with calculated value to get rebound stop
                      ! deflection
CMP_RSTOP_OFFSET(2,2) 0 ; mm ! [D] Added (after gain) to get rebound stop deflection
JNC_START_CMP_RSTOP(2,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_RSTOP(2,2) 1 ! [D] Divided into (jounce at wheel -
                           ! JNC_START_CMP_RSTOP)

