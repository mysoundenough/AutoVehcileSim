DZ_OBJECT 0
IOBJECT_INCREMENT
IOBJECT 1
SET_DESCRIPTION OBJECT_NAME 1 Driver Preview Point
OPT_SPEED_OBJ 0
 INSTALL_DM_OUTPUTS ! Need outputs from the driver model
EQ_INIT ROAD_ID_OBJ(1) = CURRENT_ROAD_ID ! now
EQ_OUT X_Obj_1 = x_dm_1 ! Calculate every time step
EQ_OUT Y_Obj_1 = y_dm_1
PATH_ID_OBJ 0
ROAD_ID_OBJ 0
OPT_RECYCLE_OBJ 0
H_OBJ = 0 ! Default for blank field
WRITE_ADD_REFERENCE_FRAME_OBJECT
ADD_REFERENCE_FRAME object_1j
SET_EULER_ANGLES YAW_PITCH_ROLL
SET_X_NAME X_Obj_1
