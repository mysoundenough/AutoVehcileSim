JNC_START_TOE(1,1)  0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_TOE(1,1)  1 ! [D] Divided into (jounce - JNC_START_TOE)
TOE_COMBINE(1,1) ADD ! How to combine the two components
SET_UNITS SUSP_TOE_JNC_OTHER_SIDE_TABLE(1,1) deg ;
SUSP_TOE_JNC_OTHER_SIDE_CONSTANT(1,1) 0 ; deg ! Toe component due to jounce (other
                                        ! side), axle 1, left side

