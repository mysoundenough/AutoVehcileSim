LTARG_GAIN(1)       1 ! Multiplied with calculated value to get lateral offset
LTARG_OFFSET(1)     0 ; m ! [D] Added (after gain) to get lateral offset
SSTART_LTARG(1)     0 ; m ! [D] Subtracted from station
SSCALE_LTARG(1)     1 ! [D] Divided into (station - SSTART_LTARG)

! L_CONTACT_X: Tire/ground contact length. Tire contact length is a function of tire
! compression (CONSTANT or TABLE). Alternatively, a custom equation can be defined at
! runtime. Tire contact length from the calculation can be adjusted with
! L_CONTACT_X_GAIN and L_CONTACT_X_OFFSET. Tire compression used in the calculation
! can be adjusted with CMP_SCALE_L_CONTACT_X. This configurable function supports 4
! datasets; if indices shown below are not used, e.g., (1,2), the current values of
! the indices IAXLE and ISIDE are used to identify the dataset when reading data.

L_CONTACT_X_CONSTANT(1,1) 80 ; mm ! Tire contact length, axle 1, left side
L_CONTACT_X_GAIN(1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                        ! length
L_CONTACT_X_OFFSET(1,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(1,2) 80 ; mm ! Tire contact length, axle 1, right side
L_CONTACT_X_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                        ! length
L_CONTACT_X_OFFSET(1,2) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(2,1) 80 ; mm ! Tire contact length, axle 2, left side
L_CONTACT_X_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get tire contact
                        ! length
L_CONTACT_X_OFFSET(2,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(2,2) 80 ; mm ! Tire contact length, axle 2, right side
L_CONTACT_X_GAIN(2,2) 1 ! [D] Multiplied with calculated value to get tire contact
                        ! length
L_CONTACT_X_OFFSET(2,2) 0 ; mm ! [D] Added to get tire contact length

! L_CONTACT_Y: Tire/ground contact width. Tire contact width is a function of tire
! compression (CONSTANT or TABLE). Alternatively, a custom equation can be defined at
! runtime. Tire contact width from the calculation can be adjusted with
! L_CONTACT_Y_GAIN and L_CONTACT_Y_OFFSET. Tire compression used in the calculation
! can be adjusted with CMP_SCALE_L_CONTACT_Y. This configurable function supports 4
! datasets; if indices shown below are not used, e.g., (1,2), the current values of
! the indices IAXLE and ISIDE are used to identify the dataset when reading data.

L_CONTACT_Y_CONSTANT(1,1) 235 ; mm ! Tire contact width, axle 1, left side
L_CONTACT_Y_GAIN(1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                        ! width
L_CONTACT_Y_OFFSET(1,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(1,2) 235 ; mm ! Tire contact width, axle 1, right side
L_CONTACT_Y_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                        ! width
L_CONTACT_Y_OFFSET(1,2) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(2,1) 235 ; mm ! Tire contact width, axle 2, left side
L_CONTACT_Y_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get tire contact
                        ! width
L_CONTACT_Y_OFFSET(2,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(2,2) 235 ; mm ! Tire contact width, axle 2, right side
L_CONTACT_Y_GAIN(2,2) 1 ! [D] Multiplied with calculated value to get tire contact
                        ! width
L_CONTACT_Y_OFFSET(2,2) 0 ; mm ! [D] Added to get tire contact width

! L_RELAX_X: Tire longitudinal relaxation length as a function of vertical load (Fz)
! and lagged slip ratio (Kappa). L_Relax_X can be a nonlinear CARPET function of Fz
! and Lagged Kappa or a function of Lagged Kappa (CONSTANT or TABLE) combined with a
! function L_RELAX_X_FZ of Fz (CONSTANT or TABLE). Alternatively, a custom equation
! can be defined at runtime. L_Relax_X from the calculation can be adjusted with
! L_RELAX_X_GAIN and L_RELAX_X_OFFSET. Lagged Kappa used in the calculation can be
! adjusted with LAGGED_KAPPA_SCALE_L_RELAX_X. Fz used in the calculation can be
! adjusted with FZ_SCALE_L_RELAX_X. This configurable function supports 4 datasets;
