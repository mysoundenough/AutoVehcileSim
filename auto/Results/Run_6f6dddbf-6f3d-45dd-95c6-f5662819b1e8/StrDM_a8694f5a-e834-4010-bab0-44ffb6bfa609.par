PARSFILE
#FullDataName Control: Steering by the Closed-loop Driver Model`MyDoubleLaneChange`Vehicle Dynamics Tests
SET_ILTARG_FOR_ID 0
set_description LTARG_ID MyDoubleLaneChange
INSTALL_DM_PATH_FOLLOWER
#CheckBox4 1    
OPT_DM 3
