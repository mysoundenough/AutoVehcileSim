!------------------------------------------------------------------------------------
! EXTERNAL TIRE MODULE API
!------------------------------------------------------------------------------------
EXTERNAL_TIRE_MODULE_DLL D:\product_dev\trunk\Image\CarSim\Core\CarSim_Prog\Programs\solvers\\tmrw.dll64
INSTALL_EXTERNAL_TIRE_API ! Command to load the specified external module

! VS Terramechanics: Rigid Wheel 2024.1
! Revision 222209, March 18, 2024

! VS Tire Tester mode is off

! STI_TYPARR active: axle 1, left side ! For info on STI_TYPARR values, see Help >
                                       ! Tires > Terramechanics Models
! Lugged tire detected
! Estimated sinkage used for initialization: 15.2 mm

! STI_TYPARR active: axle 1, right side 
! Lugged tire detected
! Estimated sinkage used for initialization: 15.2 mm

! STI_TYPARR active: axle 2, left side 
! Lugged tire detected
! Estimated sinkage used for initialization: 20.1 mm

! STI_TYPARR active: axle 2, right side 
! Lugged tire detected
! Estimated sinkage used for initialization: 20.1 mm

!------------------------------------------------------------------------------------
! NEW VARIABLES DEFINED AT RUN TIME
!------------------------------------------------------------------------------------
DEFINE_PARAMETER MAX_BRAKE_TORQUE = -50; N-m ; Max engine braking torque for audio
DEFINE_PARAMETER MAX_TORQUE = 265; N-m ; Max engine torque for audio

DEFINE_OUTPUT v_mod2 = 0.0305387; - ; Audio control (power off) 
DEFINE_OUTPUT v_mod1 = 0; - ; Audio control (power on) 

!------------------------------------------------------------------------------------
! EQUATIONS OUT (AFTER DYNAMICS)
!------------------------------------------------------------------------------------
EQ_OUT V_MOD2 = IF(M_ENGOUT > 0, 0, POW(ABS(M_ENGOUT/MAX_BRAKE_TORQUE), 0.5));
EQ_OUT V_MOD1 = IF(M_ENGOUT > 0, POW(ABS(M_ENGOUT/MAX_TORQUE), 0.5), 0);

