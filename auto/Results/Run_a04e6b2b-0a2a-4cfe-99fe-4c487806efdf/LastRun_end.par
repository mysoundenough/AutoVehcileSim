CI_FY_COEFFICIENT(1,1) 0 ! Inclination displacement per unit force (deg/N), axle 1,
                         ! left side
CI_FY_OFFSET(1,1)   0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(1,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(1,1)  1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(1,2) 0 ! Inclination displacement per unit force (deg/N), axle 1,
                         ! right side
CI_FY_OFFSET(1,2)   0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(1,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(1,2)  1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(2,1) 0 ! Inclination displacement per unit force (deg/N), axle 2,
                         ! left side
CI_FY_OFFSET(2,1)   0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(2,1)  0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(2,1)  1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(2,2) 0 ! Inclination displacement per unit force (deg/N), axle 2,
                         ! right side
CI_FY_OFFSET(2,2)   0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(2,2)  0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(2,2)  1 ! [D] Divided into (force - F_START_CI_FY)

! CI_MZ: Compliance: inclination of wheel due to in- and out-phase Mz. Inclination
! displacement can be a nonlinear CARPET function of moment (other side) and moment
! or a function of moment (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom
