                       ! movement inward of unsteered wheel
SUSP_LAT_OFFSET(1,1,1) 0 ; mm ! [D] Added (after gain) to get Lateral movement
                         ! inward of unsteered wheel
JNC_START_SUSP_LAT(1,1,1) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_SUSP_LAT(1,1,1) 1 ! [D] Divided into (jounce - JNC_START_SUSP_LAT)
SUSP_LAT_COMBINE(1,1,1) ADD ! How to combine the two components
SET_UNITS SUSP_LAT_JNC_OTHER_SIDE_TABLE(1,1,1) mm ;
