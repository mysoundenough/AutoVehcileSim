Z_PROFILE_GAIN(2)   1 ! [D] Multiplied with calculated value to get elevation
                      ! increment
Z_PROFILE_OFFSET(2) 0 ; mm ! [D] Added (after gain) to get elevation increment
SSTART_Z_PROFILE(2) 0 ; m ! [D] Subtracted from distance travelled
SSCALE_Z_PROFILE(2) 1 ! [D] Divided into (distance travelled - SSTART_Z_PROFILE)

!------------------------------------------------------------------------------------
! NEW VARIABLES DEFINED AT RUN TIME
!------------------------------------------------------------------------------------
DEFINE_PARAMETER WRITESTART = 50; - ;
DEFINE_PARAMETER WRITESTOP = 73; - ;

!------------------------------------------------------------------------------------
! EQUATIONS IN (BEFORE CONTROLS)
!------------------------------------------------------------------------------------
EQ_IN PBK_CON_CONSTANT = IF(T > 32, 0, 3e+06);
EQ_IN SPEED_TARGET_CONSTANT(1) = IF(T > 32, 9.72222, 0);
EQ_IN OPT_WRITE = IF((T >= WRITESTART) & (T < WRITESTOP), 1, 0);

!------------------------------------------------------------------------------------
! STATE VARIABLES (NEEDED FOR RESTART)
!------------------------------------------------------------------------------------
