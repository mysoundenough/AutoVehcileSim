F_JNC_STOP_OFFSET(1,2,2) 0 ; N ! [D] Added (after gain) to get force
CMP_START_F_JNC_STOP(1,2,2) 0 ; mm ! [D] Subtracted from suspension travel at jounce
                              ! stop
CMP_SCALE_F_JNC_STOP(1,2,2) 1 ! [D] Divided into (suspension travel at jounce stop -
                              ! CMP_START_F_JNC_STOP)

! Col 1 = suspension travel at jounce stop (mm), col 2 = force (N)
