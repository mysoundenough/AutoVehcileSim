                                           ! jounce (other side), unit 1, axle 1,
                                           ! right side

! SUSP_DIVE_AXLE: Suspension dive (measured at zero steer). Suspension dive can be a
! nonlinear CARPET function of roll and jounce or a function of jounce (CONSTANT,
! COEFFICIENT, or TABLE) combined with a function SUSP_DIVE_AXLE_ROLL of roll
! (CONSTANT, COEFFICIENT, or TABLE). Suspension dive from the calculation can be
! adjusted with SUSP_DIVE_AXLE_GAIN and SUSP_DIVE_AXLE_OFFSET. Jounce used in the
! calculation can be adjusted with JNC_SCALE_SUSP_DIVE_AXLE and
! JNC_START_SUSP_DIVE_AXLE. Roll used in the calculation can be adjusted with
! ROLL_SCALE_SUSP_DIVE_AXLE and ROLL_START_SUSP_DIVE_AXLE. The derivative of this
! function is used internally. This configurable function supports 4 datasets; if
! indices shown below are not used, e.g., (1,2), the current values of the indices
! IUNIT and IAXLE are used to identify the dataset when reading data.

SUSP_DIVE_AXLE_COEFFICIENT(1,2) 0 ! Suspension dive per unit jounce (deg/mm), unit
                                  ! 1, axle 2
SUSP_DIVE_AXLE_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get suspension
                           ! dive
SUSP_DIVE_AXLE_OFFSET(1,2) 0 ; deg ! [D] Added (after gain) to get suspension dive
JNC_START_SUSP_DIVE_AXLE(1,2) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_SUSP_DIVE_AXLE(1,2) 1 ! [D] Divided into (jounce -
                                ! JNC_START_SUSP_DIVE_AXLE)
SUSP_DIVE_AXLE_COMBINE(1,2) MULTIPLY ! [D] How to combine the two components
SUSP_DIVE_AXLE_ROLL_CONSTANT(1,2) 1 ; - ! [D] Suspension dive component due to roll,
                                    ! unit 1, axle 2

SUSP_DIVE_AXLE_COEFFICIENT(2,1) 0 ! Suspension dive per unit jounce (deg/mm), unit
                                  ! 2, axle 1
SUSP_DIVE_AXLE_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get suspension
                           ! dive
SUSP_DIVE_AXLE_OFFSET(2,1) 0 ; deg ! [D] Added (after gain) to get suspension dive
JNC_START_SUSP_DIVE_AXLE(2,1) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_SUSP_DIVE_AXLE(2,1) 1 ! [D] Divided into (jounce -
                                ! JNC_START_SUSP_DIVE_AXLE)
SUSP_DIVE_AXLE_COMBINE(2,1) MULTIPLY ! [D] How to combine the two components
SUSP_DIVE_AXLE_ROLL_CONSTANT(2,1) 1 ; - ! [D] Suspension dive component due to roll,
                                    ! unit 2, axle 1

SUSP_DIVE_AXLE_COEFFICIENT(2,2) 0 ! Suspension dive per unit jounce (deg/mm), unit
                                  ! 2, axle 2
SUSP_DIVE_AXLE_GAIN(2,2) 1 ! [D] Multiplied with calculated value to get suspension
                           ! dive
SUSP_DIVE_AXLE_OFFSET(2,2) 0 ; deg ! [D] Added (after gain) to get suspension dive
JNC_START_SUSP_DIVE_AXLE(2,2) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_SUSP_DIVE_AXLE(2,2) 1 ! [D] Divided into (jounce -
                                ! JNC_START_SUSP_DIVE_AXLE)
SUSP_DIVE_AXLE_COMBINE(2,2) MULTIPLY ! [D] How to combine the two components
SUSP_DIVE_AXLE_ROLL_CONSTANT(2,2) 1 ; - ! [D] Suspension dive component due to roll,
                                    ! unit 2, axle 2

! SUSP_LAT: Suspension Lateral movement inward of unsteered wheel (measured at zero
! steer). Lateral movement inward of unsteered wheel can be a nonlinear CARPET
! function of jounce (other side) and jounce or a function of jounce (CONSTANT,
! COEFFICIENT, or TABLE) combined with a function SUSP_LAT_JNC_OTHER_SIDE of jounce
! (other side) (CONSTANT, COEFFICIENT, or TABLE). Lateral movement inward of
! unsteered wheel from the calculation can be adjusted with SUSP_LAT_GAIN and
! SUSP_LAT_OFFSET. Jounce used in the calculation can be adjusted with
! JNC_SCALE_SUSP_LAT and JNC_START_SUSP_LAT. Jounce (other side) used in the
! calculation can be adjusted with JNC2_SCALE_SUSP_LAT and JNC2_START_SUSP_LAT. The
! derivative of this function is used internally. This configurable function supports
! 8 datasets; if indices shown below are not used, e.g., (1,1,2), the current values
! of the indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when
! reading data.

! Col 1 = jounce (mm), col 2 = Lateral movement inward of unsteered wheel (mm)
