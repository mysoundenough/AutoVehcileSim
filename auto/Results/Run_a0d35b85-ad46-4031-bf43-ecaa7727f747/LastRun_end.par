!------------------------------------------------------------------------------------
! ABS CONTROLLER
!------------------------------------------------------------------------------------
INSTALL_ABS_CONTROLLER ! VS Command to install the built-in ABS controller

OPT_ABS_CTRL(1,1)   2 ! ABS control option, unit 1, axle 1: 0 -> No ABS, 1-> Single
                      ! control channel for axle, 2 -> Independent control channels
                      ! for each wheel
ABS_SLIP_ON(1,1) 0.15 ; - ! ABS: allow braking for slip below this limit
ABS_SLIP_OFF(1,1) 0.2 ; - ! ABS: release brake for slip above this limit
ABS_VMIN(1,1)       3 ; km/h ! Disable ABS for speed below this limit

OPT_ABS_CTRL(1,2)   2 ! ABS control option, unit 1, axle 2
ABS_SLIP_ON(1,2)  0.1 ; - ! ABS: allow braking for slip below this limit
ABS_SLIP_OFF(1,2) 0.5 ; - ! ABS: release brake for slip above this limit
ABS_VMIN(1,2)       3 ; km/h ! Disable ABS for speed below this limit

OPT_ABS_CTRL(2,1)   0 ! ABS control option, unit 2, axle 1

OPT_ABS_CTRL(2,2)   0 ! ABS control option, unit 2, axle 2

!------------------------------------------------------------------------------------
! CONFIGURABLE FUNCTIONS
!------------------------------------------------------------------------------------

! CAMBER: Suspension camber (measured at zero steer). Camber can be a nonlinear
! CARPET function of jounce (other side) and jounce or a function of jounce
! (CONSTANT, COEFFICIENT, or TABLE) combined with a function
! SUSP_CAMBER_JNC_OTHER_SIDE of jounce (other side) (CONSTANT, COEFFICIENT, or
! TABLE). Camber from the calculation can be adjusted with CAMBER_GAIN and
! CAMBER_OFFSET. Jounce used in the calculation can be adjusted with JNC_SCALE_CAMBER
! and JNC_START_CAMBER. Jounce (other side) used in the calculation can be adjusted
! with JNC2_SCALE_CAMBER and JNC2_START_CAMBER. The derivative of this function is
! used internally. This configurable function supports 8 datasets; if indices shown
! below are not used, e.g., (1,1,2), the current values of the indices IUNIT, IAXLE,
! and ISIDE are used to identify the dataset when reading data.

! Col 1 = jounce (mm), col 2 = camber (deg)
CAMBER_TABLE(1,1,1) SPLINE ! unit 1, axle 1, left side
 -70, 1.08171
 -60, 0.996827
 -50, 0.88789
 -40, 0.755642
 -30, 0.600569
 -20, 0.422934
 -10, 0.222791
 0, 0
 10, -0.245764
 20, -0.515012
 30, -0.808436
 40, -1.12692
 50, -1.47156
 60, -1.84365
 70, -2.24474
ENDTABLE
CAMBER_GAIN(1,1,1)  1 ! [D] Multiplied with calculated value to get camber
CAMBER_OFFSET(1,1,1) 0 ; deg ! [D] Added (after gain) to get camber
JNC_START_CAMBER(1,1,1) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_CAMBER(1,1,1) 1 ! [D] Divided into (jounce - JNC_START_CAMBER)
CAMBER_COMBINE(1,1,1) ADD ! How to combine the two components
SET_UNITS SUSP_CAMBER_JNC_OTHER_SIDE_TABLE(1,1,1) deg ;
SUSP_CAMBER_JNC_OTHER_SIDE_CONSTANT(1,1,1) 0 ; deg ! Camber component due to jounce
                                             ! (other side), unit 1, axle 1, left
                                             ! side

! Col 1 = jounce (mm), col 2 = camber (deg)
CAMBER_TABLE(1,1,2) SPLINE ! unit 1, axle 1, right side
 -70, 1.08171
 -60, 0.996827
 -50, 0.88789
 -40, 0.755642
 -30, 0.600569
 -20, 0.422934
 -10, 0.222791
 0, 0
 10, -0.245764
 20, -0.515012
 30, -0.808436
 40, -1.12692
 50, -1.47156
 60, -1.84365
 70, -2.24474
ENDTABLE
CAMBER_GAIN(1,1,2)  1 ! [D] Multiplied with calculated value to get camber
CAMBER_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get camber
JNC_START_CAMBER(1,1,2) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_CAMBER(1,1,2) 1 ! [D] Divided into (jounce - JNC_START_CAMBER)
CAMBER_COMBINE(1,1,2) ADD ! How to combine the two components
SET_UNITS SUSP_CAMBER_JNC_OTHER_SIDE_TABLE(1,1,2) deg ;
SUSP_CAMBER_JNC_OTHER_SIDE_CONSTANT(1,1,2) 0 ; deg ! Camber component due to jounce
                                             ! (other side), unit 1, axle 1, right
                                             ! side

! CC_FX: Compliance: wheel camber due to in- and out-phase Fx. Camber displacement
! can be a nonlinear CARPET function of force (other side) and force or a function of
! force (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be
! defined at runtime. Camber displacement from the calculation can be adjusted with
! CC_FX_GAIN and CC_FX_OFFSET. Force used in the calculation can be adjusted with
! F_SCALE_CC_FX and F_START_CC_FX. Force (other side) used in the calculation can be
! adjusted with F2_SCALE_CC_FX and F2_START_CC_FX. This configurable function
! supports 8 datasets; if indices shown below are not used, e.g., (1,1,2), the
! current values of the indices IUNIT, IAXLE, and ISIDE are used to identify the
! dataset when reading data.

CC_FX_COEFFICIENT(1,1,1) 0 ! Camber displacement per unit force (deg/N), unit 1,
                           ! axle 1, left side
CC_FX_OFFSET(1,1,1) 0 ; deg ! [D] Added (after gain) to get camber displacement
F_START_CC_FX(1,1,1) 0 ; N ! [D] Subtracted from force
F_SCALE_CC_FX(1,1,1) 1 ! [D] Divided into (force - F_START_CC_FX)

CC_FX_COEFFICIENT(1,1,2) 0 ! Camber displacement per unit force (deg/N), unit 1,
                           ! axle 1, right side
CC_FX_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get camber displacement
F_START_CC_FX(1,1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_CC_FX(1,1,2) 1 ! [D] Divided into (force - F_START_CC_FX)

CC_FX_COEFFICIENT(1,2,1) 0 ! Camber displacement per unit force (deg/N), unit 1,
                           ! axle 2, left side
CC_FX_OFFSET(1,2,1) 0 ; deg ! [D] Added (after gain) to get camber displacement
F_START_CC_FX(1,2,1) 0 ; N ! [D] Subtracted from force
F_SCALE_CC_FX(1,2,1) 1 ! [D] Divided into (force - F_START_CC_FX)

CC_FX_COEFFICIENT(1,2,2) 0 ! Camber displacement per unit force (deg/N), unit 1,
                           ! axle 2, right side
CC_FX_OFFSET(1,2,2) 0 ; deg ! [D] Added (after gain) to get camber displacement
F_START_CC_FX(1,2,2) 0 ; N ! [D] Subtracted from force
F_SCALE_CC_FX(1,2,2) 1 ! [D] Divided into (force - F_START_CC_FX)

! CD_MY: Compliance: suspension dive due to in- and out-phase My. Dive displacement
! can be a nonlinear CARPET function of moment (other side) and moment or a function
! of moment (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can
! be defined at runtime. Dive displacement from the calculation can be adjusted with
! CD_MY_GAIN and CD_MY_OFFSET. Moment used in the calculation can be adjusted with
! M_SCALE_CD_MY and M_START_CD_MY. Moment (other side) used in the calculation can be
! adjusted with M2_SCALE_CD_MY and M2_START_CD_MY. This configurable function
! supports 8 datasets; if indices shown below are not used, e.g., (1,1,2), the
! current values of the indices IUNIT, IAXLE, and ISIDE are used to identify the
! dataset when reading data.

CD_MY_COEFFICIENT(1,1,1) 0 ! Dive displacement per unit moment (deg/N-m), unit 1,
                           ! axle 1, left side
CD_MY_OFFSET(1,1,1) 0 ; deg ! [D] Added (after gain) to get dive displacement
M_START_CD_MY(1,1,1) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CD_MY(1,1,1) 1 ! [D] Divided into (moment - M_START_CD_MY)

CD_MY_COEFFICIENT(1,1,2) 0 ! Dive displacement per unit moment (deg/N-m), unit 1,
                           ! axle 1, right side
CD_MY_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get dive displacement
M_START_CD_MY(1,1,2) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CD_MY(1,1,2) 1 ! [D] Divided into (moment - M_START_CD_MY)

! CI_FY: Compliance: inclination of wheel due in- and out-phase Fy. Inclination
! displacement can be a nonlinear CARPET function of force (other side) and force or
! a function of force (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom
! equation can be defined at runtime. Inclination displacement from the calculation
! can be adjusted with CI_FY_GAIN and CI_FY_OFFSET. Force used in the calculation can
! be adjusted with F_SCALE_CI_FY and F_START_CI_FY. Force (other side) used in the
! calculation can be adjusted with F2_SCALE_CI_FY and F2_START_CI_FY. This
! configurable function supports 8 datasets; if indices shown below are not used,
! e.g., (1,1,2), the current values of the indices IUNIT, IAXLE, and ISIDE are used
! to identify the dataset when reading data.

CI_FY_COEFFICIENT(1,1,1) 0 ! Inclination displacement per unit force (deg/N), unit
                           ! 1, axle 1, left side
CI_FY_OFFSET(1,1,1) 0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(1,1,1) 0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(1,1,1) 1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(1,1,2) 0 ! Inclination displacement per unit force (deg/N), unit
                           ! 1, axle 1, right side
CI_FY_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(1,1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(1,1,2) 1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(1,2,1) 0 ! Inclination displacement per unit force (deg/N), unit
                           ! 1, axle 2, left side
CI_FY_OFFSET(1,2,1) 0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(1,2,1) 0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(1,2,1) 1 ! [D] Divided into (force - F_START_CI_FY)

CI_FY_COEFFICIENT(1,2,2) 0 ! Inclination displacement per unit force (deg/N), unit
                           ! 1, axle 2, right side
CI_FY_OFFSET(1,2,2) 0 ; deg ! [D] Added (after gain) to get inclination displacement
F_START_CI_FY(1,2,2) 0 ; N ! [D] Subtracted from force
F_SCALE_CI_FY(1,2,2) 1 ! [D] Divided into (force - F_START_CI_FY)

! CI_MZ: Compliance: inclination of wheel due to in- and out-phase Mz. Inclination
! displacement can be a nonlinear CARPET function of moment (other side) and moment
! or a function of moment (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom
! equation can be defined at runtime. Inclination displacement from the calculation
! can be adjusted with CI_MZ_GAIN and CI_MZ_OFFSET. Moment used in the calculation
! can be adjusted with M_SCALE_CI_MZ and M_START_CI_MZ. Moment (other side) used in
! the calculation can be adjusted with M2_SCALE_CI_MZ and M2_START_CI_MZ. This
! configurable function supports 8 datasets; if indices shown below are not used,
! e.g., (1,1,2), the current values of the indices IUNIT, IAXLE, and ISIDE are used
! to identify the dataset when reading data.

CI_MZ_COEFFICIENT(1,1,1) 0 ! Inclination displacement per unit moment (deg/N-m),
                           ! unit 1, axle 1, left side
CI_MZ_OFFSET(1,1,1) 0 ; deg ! [D] Added (after gain) to get inclination displacement
M_START_CI_MZ(1,1,1) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CI_MZ(1,1,1) 1 ! [D] Divided into (moment - M_START_CI_MZ)

CI_MZ_COEFFICIENT(1,1,2) 0 ! Inclination displacement per unit moment (deg/N-m),
                           ! unit 1, axle 1, right side
CI_MZ_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get inclination displacement
M_START_CI_MZ(1,1,2) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CI_MZ(1,1,2) 1 ! [D] Divided into (moment - M_START_CI_MZ)

CI_MZ_COEFFICIENT(1,2,1) 0 ! Inclination displacement per unit moment (deg/N-m),
                           ! unit 1, axle 2, left side
CI_MZ_OFFSET(1,2,1) 0 ; deg ! [D] Added (after gain) to get inclination displacement
M_START_CI_MZ(1,2,1) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CI_MZ(1,2,1) 1 ! [D] Divided into (moment - M_START_CI_MZ)

CI_MZ_COEFFICIENT(1,2,2) 0 ! Inclination displacement per unit moment (deg/N-m),
                           ! unit 1, axle 2, right side
CI_MZ_OFFSET(1,2,2) 0 ; deg ! [D] Added (after gain) to get inclination displacement
M_START_CI_MZ(1,2,2) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CI_MZ(1,2,2) 1 ! [D] Divided into (moment - M_START_CI_MZ)

! CLUTCH_CONTROL_DIFF: Differential clutch control input based on total torque
! applied to both output shafts. Normalized clutch input is a function of torque
! (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined
! at runtime. Normalized clutch input from the calculation can be adjusted with
! CLUTCH_CONTROL_DIFF_GAIN and CLUTCH_CONTROL_DIFF_OFFSET. Torque used in the
! calculation can be adjusted with M_SCALE_CL_CON_DIFF and M_START_CL_CON_DIFF. This
! configurable function supports 3 datasets; if indices shown below are not used,
! e.g., (2), the current value of the index IDIFF is used to identify the dataset
! when reading data.

CLUTCH_CONTROL_DIFF_CONSTANT(1) 1 ; - ! [D] Normalized clutch input, front diff
CLUTCH_CONTROL_DIFF_GAIN(1) 1 ! [D] Multiplied with calculated value to get
                              ! normalized clutch input
CLUTCH_CONTROL_DIFF_OFFSET(1) 0 ; - ! [D] Added to get normalized clutch input

CLUTCH_CONTROL_DIFF_CONSTANT(2) 1 ; - ! [D] Normalized clutch input, rear diff
CLUTCH_CONTROL_DIFF_GAIN(2) 1 ! [D] Multiplied with calculated value to get
                              ! normalized clutch input
CLUTCH_CONTROL_DIFF_OFFSET(2) 0 ; - ! [D] Added to get normalized clutch input

CLUTCH_CONTROL_DIFF_CONSTANT(3) 1 ; - ! [D] Normalized clutch input, transfer case
CLUTCH_CONTROL_DIFF_GAIN(3) 1 ! [D] Multiplied with calculated value to get
                              ! normalized clutch input
CLUTCH_CONTROL_DIFF_OFFSET(3) 0 ; - ! [D] Added to get normalized clutch input

! CLUTCH_TORQUE_DIFF: Available torque for differential clutch. Available torque is
! a function of normalized clutch input (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. Available torque from
! the calculation can be adjusted with CLUTCH_TORQUE_DIFF_GAIN and
! CLUTCH_TORQUE_DIFF_OFFSET. Normalized clutch input used in the calculation can be
! adjusted with CON_SCALE_CL_TORQ_DIFF and CON_START_CL_TORQ_DIFF. This configurable
! function supports 3 datasets; if indices shown below are not used, e.g., (2), the
! current value of the index IDIFF is used to identify the dataset when reading data.

CLUTCH_TORQUE_DIFF_CONSTANT(1) 0 ; N-m ! [D] Available torque, front diff
CLUTCH_TORQUE_DIFF_OFFSET(1) 0 ; N-m ! [D] Added to get available torque

CLUTCH_TORQUE_DIFF_CONSTANT(2) 0 ; N-m ! [D] Available torque, rear diff
CLUTCH_TORQUE_DIFF_OFFSET(2) 0 ; N-m ! [D] Added to get available torque

CLUTCH_TORQUE_DIFF_CONSTANT(3) 0 ; N-m ! [D] Available torque, transfer case
CLUTCH_TORQUE_DIFF_OFFSET(3) 0 ; N-m ! [D] Added to get available torque

! CMP_DAMP: Damper compression. Damper compression can be a nonlinear CARPET
! function of jounce at wheel (other side) and jounce at wheel or a function of
! jounce at wheel (CONSTANT, COEFFICIENT, or TABLE). Damper compression from the
! calculation can be adjusted with CMP_DAMP_GAIN and CMP_DAMP_OFFSET. Jounce at wheel
! used in the calculation can be adjusted with JNC_SCALE_CMP_DAMP and
! JNC_START_CMP_DAMP. Jounce at wheel (other side) used in the calculation can be
! adjusted with JNC2_SCALE_CMP_DAMP and JNC2_START_CMP_DAMP. The derivative of this
! function is used internally. This configurable function supports 8 datasets; if
! indices shown below are not used, e.g., (1,1,2), the current values of the indices
! IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading data.

CMP_DAMP_COEFFICIENT(1,1,1) 0.614 ! Damper compression per unit jounce at wheel
                                  ! (mm/mm), unit 1, axle 1, left side
CMP_DAMP_GAIN(1,1,1) 1 ! [D] Multiplied with calculated value to get damper
                       ! compression
CMP_DAMP_OFFSET(1,1,1) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(1,1,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(1,1,1) 1 ! [D] Divided into (jounce at wheel -
                            ! JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(1,1,2) 0.614 ! Damper compression per unit jounce at wheel
                                  ! (mm/mm), unit 1, axle 1, right side
CMP_DAMP_GAIN(1,1,2) 1 ! [D] Multiplied with calculated value to get damper
                       ! compression
CMP_DAMP_OFFSET(1,1,2) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(1,1,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(1,1,2) 1 ! [D] Divided into (jounce at wheel -
                            ! JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(1,2,1) 1 ! Damper compression per unit jounce at wheel (mm/mm),
                              ! unit 1, axle 2, left side
CMP_DAMP_GAIN(1,2,1) 1 ! [D] Multiplied with calculated value to get damper
                       ! compression
CMP_DAMP_OFFSET(1,2,1) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(1,2,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(1,2,1) 1 ! [D] Divided into (jounce at wheel -
                            ! JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(1,2,2) 1 ! Damper compression per unit jounce at wheel (mm/mm),
                              ! unit 1, axle 2, right side
CMP_DAMP_GAIN(1,2,2) 1 ! [D] Multiplied with calculated value to get damper
                       ! compression
CMP_DAMP_OFFSET(1,2,2) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(1,2,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(1,2,2) 1 ! [D] Divided into (jounce at wheel -
                            ! JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(2,1,1) 1 ! Damper compression per unit jounce at wheel (mm/mm),
                              ! unit 2, axle 1, left side
CMP_DAMP_GAIN(2,1,1) 1 ! [D] Multiplied with calculated value to get damper
                       ! compression
CMP_DAMP_OFFSET(2,1,1) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(2,1,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(2,1,1) 1 ! [D] Divided into (jounce at wheel -
                            ! JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(2,1,2) 1 ! Damper compression per unit jounce at wheel (mm/mm),
                              ! unit 2, axle 1, right side
CMP_DAMP_GAIN(2,1,2) 1 ! [D] Multiplied with calculated value to get damper
                       ! compression
CMP_DAMP_OFFSET(2,1,2) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(2,1,2) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(2,1,2) 1 ! [D] Divided into (jounce at wheel -
                            ! JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(2,2,1) 1 ! Damper compression per unit jounce at wheel (mm/mm),
                              ! unit 2, axle 2, left side
CMP_DAMP_GAIN(2,2,1) 1 ! [D] Multiplied with calculated value to get damper
                       ! compression
CMP_DAMP_OFFSET(2,2,1) 0 ; mm ! [D] Added (after gain) to get damper compression
JNC_START_CMP_DAMP(2,2,1) 0 ; mm ! [D] Subtracted from jounce at wheel
JNC_SCALE_CMP_DAMP(2,2,1) 1 ! [D] Divided into (jounce at wheel -
                            ! JNC_START_CMP_DAMP)

CMP_DAMP_COEFFICIENT(2,2,2) 1 ! Damper compression per unit jounce at wheel (mm/mm),
                              ! unit 2, axle 2, right side
