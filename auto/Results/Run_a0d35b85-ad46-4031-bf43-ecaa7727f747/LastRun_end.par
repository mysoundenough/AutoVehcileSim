F_REB_STOP_OFFSET(1,1,2) 0 ; N ! [D] Added (after gain) to get force
CMP_START_F_REB_STOP(1,1,2) 0 ; mm ! [D] Subtracted from suspension travel at
                              ! rebound stop
CMP_SCALE_F_REB_STOP(1,1,2) 1 ! [D] Divided into (suspension travel at rebound stop
                              ! - CMP_START_F_REB_STOP)

