                        ! dive
SUSP_DIVE_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get suspension dive
JNC_START_SUSP_DIVE(1,1,2) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_SUSP_DIVE(1,1,2) 1 ! [D] Divided into (jounce - JNC_START_SUSP_DIVE)
