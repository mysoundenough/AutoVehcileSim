! CS_FY: Compliance: steer due to in- and out-phase Fy. Steer displacement can be a
! nonlinear CARPET function of force (other side) and force or a function of force
! (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined
! at runtime. Steer displacement from the calculation can be adjusted with CS_FY_GAIN
! and CS_FY_OFFSET. Force used in the calculation can be adjusted with F_SCALE_CS_FY
! and F_START_CS_FY. Force (other side) used in the calculation can be adjusted with
! F2_SCALE_CS_FY and F2_START_CS_FY. This configurable function supports 8 datasets;
! if indices shown below are not used, e.g., (1,1,2), the current values of the
! indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading data.

CS_FY_COEFFICIENT(1,1,1) -1.5e-07 ! Steer displacement per unit force (deg/N), unit
                                  ! 1, axle 1, left side
CS_FY_GAIN(1,1,1)   1 ! [D] Multiplied with calculated value to get Steer
                      ! displacement
CS_FY_OFFSET(1,1,1) 0 ; deg ! [D] Added (after gain) to get Steer displacement
F_START_CS_FY(1,1,1) 0 ; N ! [D] Subtracted from force
F_SCALE_CS_FY(1,1,1) 1 ! [D] Divided into (force - F_START_CS_FY)

CS_FY_COEFFICIENT(1,1,2) -1.5e-07 ! Steer displacement per unit force (deg/N), unit
                                  ! 1, axle 1, right side
CS_FY_GAIN(1,1,2)   1 ! [D] Multiplied with calculated value to get Steer
                      ! displacement
CS_FY_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get Steer displacement
F_START_CS_FY(1,1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_CS_FY(1,1,2) 1 ! [D] Divided into (force - F_START_CS_FY)

CS_FY_COEFFICIENT(1,2,1) -5.6e-06 ! Steer displacement per unit force (deg/N), unit
                                  ! 1, axle 2, left side
CS_FY_GAIN(1,2,1)   1 ! [D] Multiplied with calculated value to get Steer
                      ! displacement
CS_FY_OFFSET(1,2,1) 0 ; deg ! [D] Added (after gain) to get Steer displacement
F_START_CS_FY(1,2,1) 0 ; N ! [D] Subtracted from force
F_SCALE_CS_FY(1,2,1) 1 ! [D] Divided into (force - F_START_CS_FY)

CS_FY_COEFFICIENT(1,2,2) -5.6e-06 ! Steer displacement per unit force (deg/N), unit
                                  ! 1, axle 2, right side
CS_FY_GAIN(1,2,2)   1 ! [D] Multiplied with calculated value to get Steer
                      ! displacement
CS_FY_OFFSET(1,2,2) 0 ; deg ! [D] Added (after gain) to get Steer displacement
F_START_CS_FY(1,2,2) 0 ; N ! [D] Subtracted from force
F_SCALE_CS_FY(1,2,2) 1 ! [D] Divided into (force - F_START_CS_FY)

! CS_MZ: Compliance: steer due to in- and out-phase Mz. Steer displacement can be a
! nonlinear CARPET function of moment and moment or a function of moment (CONSTANT,
! COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined at runtime.
! Steer displacement from the calculation can be adjusted with CS_MZ_GAIN and
! CS_MZ_OFFSET. Moment used in the calculation can be adjusted with M_SCALE_CS_MZ and
! M_START_CS_MZ. Moment used in the calculation can be adjusted with M2_SCALE_CS_MZ
! and M2_START_CS_MZ. This configurable function supports 8 datasets; if indices
! shown below are not used, e.g., (1,1,2), the current values of the indices IUNIT,
! IAXLE, and ISIDE are used to identify the dataset when reading data.

CS_MZ_COEFFICIENT(1,1,1) 1.9e-05 ! Steer displacement per unit moment (deg/N-m),
                                 ! unit 1, axle 1, left side
CS_MZ_GAIN(1,1,1)   1 ! [D] Multiplied with calculated value to get steer
                      ! displacement
CS_MZ_OFFSET(1,1,1) 0 ; deg ! [D] Added (after gain) to get steer displacement
M_START_CS_MZ(1,1,1) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CS_MZ(1,1,1) 1 ! [D] Divided into (moment - M_START_CS_MZ)

CS_MZ_COEFFICIENT(1,1,2) 1.9e-05 ! Steer displacement per unit moment (deg/N-m),
                                 ! unit 1, axle 1, right side
CS_MZ_GAIN(1,1,2)   1 ! [D] Multiplied with calculated value to get steer
                      ! displacement
CS_MZ_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get steer displacement
M_START_CS_MZ(1,1,2) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CS_MZ(1,1,2) 1 ! [D] Divided into (moment - M_START_CS_MZ)

CS_MZ_COEFFICIENT(1,2,1) 0.00095 ! Steer displacement per unit moment (deg/N-m),
                                 ! unit 1, axle 2, left side
CS_MZ_GAIN(1,2,1)   1 ! [D] Multiplied with calculated value to get steer
                      ! displacement
CS_MZ_OFFSET(1,2,1) 0 ; deg ! [D] Added (after gain) to get steer displacement
M_START_CS_MZ(1,2,1) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CS_MZ(1,2,1) 1 ! [D] Divided into (moment - M_START_CS_MZ)

CS_MZ_COEFFICIENT(1,2,2) 0.00095 ! Steer displacement per unit moment (deg/N-m),
                                 ! unit 1, axle 2, right side
CS_MZ_GAIN(1,2,2)   1 ! [D] Multiplied with calculated value to get steer
                      ! displacement
CS_MZ_OFFSET(1,2,2) 0 ; deg ! [D] Added (after gain) to get steer displacement
M_START_CS_MZ(1,2,2) 0 ; N-m ! [D] Subtracted from moment
M_SCALE_CS_MZ(1,2,2) 1 ! [D] Divided into (moment - M_START_CS_MZ)

! CT_FX: Compliance: wheel toe due to in- and out-phase Fx. Toe displacement can be
! a nonlinear CARPET function of force (other side) and force or a function of force
! (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined
! at runtime. Toe displacement from the calculation can be adjusted with CT_FX_GAIN
! and CT_FX_OFFSET. Force used in the calculation can be adjusted with F_SCALE_CT_FX
! and F_START_CT_FX. Force (other side) used in the calculation can be adjusted with
! F2_SCALE_CT_FX and F2_START_CT_FX. This configurable function supports 8 datasets;
! if indices shown below are not used, e.g., (1,1,2), the current values of the
! indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading data.

CT_FX_COEFFICIENT(1,1,1) 4.3e-07 ! Toe displacement per unit force (deg/N), unit 1,
                                 ! axle 1, left side
CT_FX_GAIN(1,1,1)   1 ! [D] Multiplied with calculated value to get toe displacement
CT_FX_OFFSET(1,1,1) 0 ; deg ! [D] Added (after gain) to get toe displacement
F_START_CT_FX(1,1,1) 0 ; N ! [D] Subtracted from force
F_SCALE_CT_FX(1,1,1) 1 ! [D] Divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(1,1,2) 4.3e-07 ! Toe displacement per unit force (deg/N), unit 1,
                                 ! axle 1, right side
CT_FX_GAIN(1,1,2)   1 ! [D] Multiplied with calculated value to get toe displacement
CT_FX_OFFSET(1,1,2) 0 ; deg ! [D] Added (after gain) to get toe displacement
F_START_CT_FX(1,1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_CT_FX(1,1,2) 1 ! [D] Divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(1,2,1) 0 ! Toe displacement per unit force (deg/N), unit 1, axle
                           ! 2, left side
CT_FX_OFFSET(1,2,1) 0 ; deg ! [D] Added (after gain) to get toe displacement
F_START_CT_FX(1,2,1) 0 ; N ! [D] Subtracted from force
F_SCALE_CT_FX(1,2,1) 1 ! [D] Divided into (force - F_START_CT_FX)

CT_FX_COEFFICIENT(1,2,2) 0 ! Toe displacement per unit force (deg/N), unit 1, axle
                           ! 2, right side
CT_FX_OFFSET(1,2,2) 0 ; deg ! [D] Added (after gain) to get toe displacement
F_START_CT_FX(1,2,2) 0 ; N ! [D] Subtracted from force
F_SCALE_CT_FX(1,2,2) 1 ! [D] Divided into (force - F_START_CT_FX)

! C_LAT: Compliance: lateral displacement of wheel due to in- and out-phase Fy .
! Lateral displacement can be a nonlinear CARPET function of force (other side) and
! force or a function of force (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a
! custom equation can be defined at runtime. Lateral displacement from the
! calculation can be adjusted with C_LAT_GAIN and C_LAT_OFFSET. Force used in the
! calculation can be adjusted with F_SCALE_C_LAT and F_START_C_LAT. Force (other
! side) used in the calculation can be adjusted with F2_SCALE_C_LAT and
! F2_START_C_LAT. This configurable function supports 8 datasets; if indices shown
! below are not used, e.g., (1,1,2), the current values of the indices IUNIT, IAXLE,
! and ISIDE are used to identify the dataset when reading data.

C_LAT_COEFFICIENT(1,1,1) 4.1e-05 ! Lateral displacement per unit force (mm/N), unit
                                 ! 1, axle 1, left side
C_LAT_GAIN(1,1,1)   1 ! [D] Multiplied with calculated value to get lateral
                      ! displacement
C_LAT_OFFSET(1,1,1) 0 ; mm ! [D] Added (after gain) to get lateral displacement
F_START_C_LAT(1,1,1) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT(1,1,1) 1 ! [D] Divided into (force - F_START_C_LAT)

C_LAT_COEFFICIENT(1,1,2) 4.1e-05 ! Lateral displacement per unit force (mm/N), unit
                                 ! 1, axle 1, right side
C_LAT_GAIN(1,1,2)   1 ! [D] Multiplied with calculated value to get lateral
                      ! displacement
C_LAT_OFFSET(1,1,2) 0 ; mm ! [D] Added (after gain) to get lateral displacement
F_START_C_LAT(1,1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT(1,1,2) 1 ! [D] Divided into (force - F_START_C_LAT)

! C_LAT_AXLE: Compliance: axle lateral leftward deflection due to total Fy.
! C_LAT_AXLE displacement is a function of force (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. C_LAT_AXLE displacement
! from the calculation can be adjusted with C_LAT_AXLE_GAIN and C_LAT_AXLE_OFFSET.
! Force used in the calculation can be adjusted with F_SCALE_C_LAT_AXLE and
! F_START_C_LAT_AXLE. This configurable function supports 4 datasets; if indices
! shown below are not used, e.g., (1,2), the current values of the indices IUNIT and
! IAXLE are used to identify the dataset when reading data.

C_LAT_AXLE_COEFFICIENT(1,2) 3.8e-05 ! C_LAT_AXLE displacement per unit force (mm/N),
                                    ! unit 1, axle 2
C_LAT_AXLE_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get C_LAT_AXLE
                       ! displacement
C_LAT_AXLE_OFFSET(1,2) 0 ; mm ! [D] Added (after gain) to get C_LAT_AXLE
                         ! displacement
F_START_C_LAT_AXLE(1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT_AXLE(1,2) 1 ! [D] Divided into (force - F_START_C_LAT_AXLE)

C_LAT_AXLE_COEFFICIENT(2,1) 0 ! C_LAT_AXLE displacement per unit force (mm/N), unit
                              ! 2, axle 1
C_LAT_AXLE_OFFSET(2,1) 0 ; mm ! [D] Added (after gain) to get C_LAT_AXLE
                         ! displacement
F_START_C_LAT_AXLE(2,1) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT_AXLE(2,1) 1 ! [D] Divided into (force - F_START_C_LAT_AXLE)

C_LAT_AXLE_COEFFICIENT(2,2) 0 ! C_LAT_AXLE displacement per unit force (mm/N), unit
                              ! 2, axle 2
C_LAT_AXLE_OFFSET(2,2) 0 ; mm ! [D] Added (after gain) to get C_LAT_AXLE
                         ! displacement
F_START_C_LAT_AXLE(2,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LAT_AXLE(2,2) 1 ! [D] Divided into (force - F_START_C_LAT_AXLE)

! C_LONG: Compliance: wheel longitudinal displacement due to in- and out-phase Fx. X
! displacement can be a nonlinear CARPET function of force (other side) and force or
! a function of force (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom
! equation can be defined at runtime. X displacement from the calculation can be
! adjusted with C_LONG_GAIN and C_LONG_OFFSET. Force used in the calculation can be
! adjusted with F_SCALE_C_LONG and F_START_C_LONG. Force (other side) used in the
! calculation can be adjusted with F2_SCALE_C_LONG and F2_START_C_LONG. This
! configurable function supports 8 datasets; if indices shown below are not used,
! e.g., (1,1,2), the current values of the indices IUNIT, IAXLE, and ISIDE are used
! to identify the dataset when reading data.

C_LONG_COEFFICIENT(1,1,1) 5e-05 ! X displacement per unit force (mm/N), unit 1, axle
                                ! 1, left side
C_LONG_GAIN(1,1,1)  1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(1,1,1) 0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(1,1,1) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(1,1,1) 1 ! [D] Divided into (force - F_START_C_LONG)

C_LONG_COEFFICIENT(1,1,2) 5e-05 ! X displacement per unit force (mm/N), unit 1, axle
                                ! 1, right side
C_LONG_GAIN(1,1,2)  1 ! [D] Multiplied with calculated value to get X displacement
C_LONG_OFFSET(1,1,2) 0 ; mm ! [D] Added (after gain) to get X displacement
F_START_C_LONG(1,1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG(1,1,2) 1 ! [D] Divided into (force - F_START_C_LONG)

! C_LONG_AXLE: Compliance: axle longitudinal deflection due to total Fx. C_LONG_AXLE
! displacement is a function of force (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. C_LONG_AXLE
! displacement from the calculation can be adjusted with C_LONG_AXLE_GAIN and
! C_LONG_AXLE_OFFSET. Force used in the calculation can be adjusted with
! F_SCALE_C_LONG_AXLE and F_START_C_LONG_AXLE. This configurable function supports 4
! datasets; if indices shown below are not used, e.g., (1,2), the current values of
! the indices IUNIT and IAXLE are used to identify the dataset when reading data.

C_LONG_AXLE_COEFFICIENT(1,2) 7e-05 ! C_LONG_AXLE displacement per unit force (mm/N),
                                   ! unit 1, axle 2
C_LONG_AXLE_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get C_LONG_AXLE
                        ! displacement
C_LONG_AXLE_OFFSET(1,2) 0 ; mm ! [D] Added (after gain) to get C_LONG_AXLE
                          ! displacement
F_START_C_LONG_AXLE(1,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG_AXLE(1,2) 1 ! [D] Divided into (force - F_START_C_LONG_AXLE)

C_LONG_AXLE_COEFFICIENT(2,1) 0 ! C_LONG_AXLE displacement per unit force (mm/N),
                               ! unit 2, axle 1
C_LONG_AXLE_OFFSET(2,1) 0 ; mm ! [D] Added (after gain) to get C_LONG_AXLE
                          ! displacement
F_START_C_LONG_AXLE(2,1) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG_AXLE(2,1) 1 ! [D] Divided into (force - F_START_C_LONG_AXLE)

C_LONG_AXLE_COEFFICIENT(2,2) 0 ! C_LONG_AXLE displacement per unit force (mm/N),
                               ! unit 2, axle 2
C_LONG_AXLE_OFFSET(2,2) 0 ; mm ! [D] Added (after gain) to get C_LONG_AXLE
                          ! displacement
F_START_C_LONG_AXLE(2,2) 0 ; N ! [D] Subtracted from force
F_SCALE_C_LONG_AXLE(2,2) 1 ! [D] Divided into (force - F_START_C_LONG_AXLE)

! DOWNSHIFT_TRANS: Transmission speed when downshift occurs. IGEAR specifies the
! lower gear for each table (e.g., IGEAR 2 means downshift from 3 to 2). Transmission
! speed is a function of throttle position (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. Transmission speed from
! the calculation can be adjusted with DOWNSHIFT_TRANS_GAIN and
! DOWNSHIFT_TRANS_OFFSET. Throttle position used in the calculation can be adjusted
! with THROTTLE_SCALE_DOWNSHIFT and THROTTLE_START_DOWNSHIFT. This configurable
! function supports 17 datasets; if indices shown below are not used, e.g., (2), the
! current value of the index IGEAR is used to identify the dataset when reading data.

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
DOWNSHIFT_TRANS_TABLE(1) LINEAR_FLAT ! shifting between gears 1 and 2
 0, 298
 0.2, 298
 0.8, 1150
 1, 1150
ENDTABLE
DOWNSHIFT_TRANS_GAIN(1) 1 ! [D] Multiplied with calculated value to get transmission
                          ! speed
DOWNSHIFT_TRANS_OFFSET(1) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_DOWNSHIFT(1) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_DOWNSHIFT(1) 1 ! [D] Divided into (throttle position -
                              ! THROTTLE_START_DOWNSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
