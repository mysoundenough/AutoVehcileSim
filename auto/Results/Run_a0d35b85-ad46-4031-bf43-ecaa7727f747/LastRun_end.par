F_JNC_STOP_OFFSET(2,1,2) 0 ; N ! [D] Added (after gain) to get force
CMP_START_F_JNC_STOP(2,1,2) 0 ; mm ! [D] Subtracted from suspension travel at jounce
                              ! stop
