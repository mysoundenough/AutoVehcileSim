JNC_DESIGN(2,1,2)   0 ; mm ! Jounce when center of wheel R3 is at H_WC [I]
L_TRACK(2,1)     2425 ; mm ! Track width, wheel-center to wheel-center, axle 3 [I]
LX_AXLE(2,1)     5895 ; mm ! X dist. axle 3 is behind the sprung-mass origin [I]
M_US_AXLE(2,1)     55 ; kg ! Unsteered mass for axle 3 [I]
M_US_STR(2,1,1)     0 ; kg ! Steered mass for wheel L3 [I]
M_US_STR(2,1,2)     0 ; kg ! Steered mass for wheel R3 [I]
