! LTARG: Target lateral offset (+ -> left, - -> right). This offset is combined with
! a reference path to produce a modified path for steering control, moving objects,
! lane definition, etc. Lateral offset is a function of station (CONSTANT,
! COEFFICIENT, or TABLE). Lateral offset from the calculation can be adjusted with
! LTARG_GAIN and LTARG_OFFSET. Station used in the calculation can be adjusted with
! SSCALE_LTARG and SSTART_LTARG. The derivative of this function is used internally.
! This configurable function supports 500 datasets; if indices shown below are not
! used, e.g., (2), the current value of the index ILTARG is used to identify the
! dataset when reading data.

LTARG_ID(1)         1  ! 0.4 sec. Single Preview
LTARG_CONSTANT(1)   0 ; m ! Lateral offset
LTARG_OFFSET(1)     0 ; m ! [D] Added to get lateral offset

! L_CONTACT_X: Tire/ground contact length. Tire contact length is a function of tire
! compression (CONSTANT or TABLE). Alternatively, a custom equation can be defined at
! runtime. Tire contact length from the calculation can be adjusted with
! L_CONTACT_X_GAIN and L_CONTACT_X_OFFSET. Tire compression used in the calculation
! can be adjusted with CMP_SCALE_L_CONTACT_X. This configurable function supports 8
! datasets; if indices shown below are not used, e.g., (1,1,2), the current values of
! the indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading
! data.

L_CONTACT_X_CONSTANT(1,1,1) 85 ; mm ! Tire contact length, unit 1, axle 1, left side
L_CONTACT_X_GAIN(1,1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(1,1,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(1,1,2) 85 ; mm ! Tire contact length, unit 1, axle 1, right
                               ! side
L_CONTACT_X_GAIN(1,1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(1,1,2) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(1,2,1) 85 ; mm ! Tire contact length, unit 1, axle 2, left side
L_CONTACT_X_GAIN(1,2,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(1,2,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(1,2,2) 85 ; mm ! Tire contact length, unit 1, axle 2, right
                               ! side
L_CONTACT_X_GAIN(1,2,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(1,2,2) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(2,1,1) 150 ; mm ! Tire contact length, unit 2, axle 1, left
                                ! side
L_CONTACT_X_GAIN(2,1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(2,1,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(2,1,2) 150 ; mm ! Tire contact length, unit 2, axle 1, right
                                ! side
L_CONTACT_X_GAIN(2,1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(2,1,2) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(2,2,1) 150 ; mm ! Tire contact length, unit 2, axle 2, left
                                ! side
L_CONTACT_X_GAIN(2,2,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(2,2,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(2,2,2) 150 ; mm ! Tire contact length, unit 2, axle 2, right
                                ! side
L_CONTACT_X_GAIN(2,2,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(2,2,2) 0 ; mm ! [D] Added to get tire contact length

! L_CONTACT_Y: Tire/ground contact width. Tire contact width is a function of tire
! compression (CONSTANT or TABLE). Alternatively, a custom equation can be defined at
! runtime. Tire contact width from the calculation can be adjusted with
! L_CONTACT_Y_GAIN and L_CONTACT_Y_OFFSET. Tire compression used in the calculation
! can be adjusted with CMP_SCALE_L_CONTACT_Y. This configurable function supports 8
! datasets; if indices shown below are not used, e.g., (1,1,2), the current values of
! the indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading
! data.

L_CONTACT_Y_CONSTANT(1,1,1) 265 ; mm ! Tire contact width, unit 1, axle 1, left side
L_CONTACT_Y_GAIN(1,1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(1,1,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(1,1,2) 265 ; mm ! Tire contact width, unit 1, axle 1, right
                                ! side
L_CONTACT_Y_GAIN(1,1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(1,1,2) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(1,2,1) 265 ; mm ! Tire contact width, unit 1, axle 2, left side
L_CONTACT_Y_GAIN(1,2,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(1,2,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(1,2,2) 265 ; mm ! Tire contact width, unit 1, axle 2, right
                                ! side
L_CONTACT_Y_GAIN(1,2,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(1,2,2) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(2,1,1) 235 ; mm ! Tire contact width, unit 2, axle 1, left side
L_CONTACT_Y_GAIN(2,1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(2,1,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(2,1,2) 235 ; mm ! Tire contact width, unit 2, axle 1, right
                                ! side
L_CONTACT_Y_GAIN(2,1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(2,1,2) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(2,2,1) 235 ; mm ! Tire contact width, unit 2, axle 2, left side
L_CONTACT_Y_GAIN(2,2,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(2,2,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(2,2,2) 235 ; mm ! Tire contact width, unit 2, axle 2, right
                                ! side
L_CONTACT_Y_GAIN(2,2,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(2,2,2) 0 ; mm ! [D] Added to get tire contact width

! L_RELAX_X: Tire longitudinal relaxation length as a function of vertical load (Fz)
! and lagged slip ratio (Kappa). L_Relax_X can be a nonlinear CARPET function of Fz
! and Lagged Kappa or a function of Lagged Kappa (CONSTANT or TABLE) combined with a
! function L_RELAX_X_FZ of Fz (CONSTANT or TABLE). Alternatively, a custom equation
! can be defined at runtime. L_Relax_X from the calculation can be adjusted with
! L_RELAX_X_GAIN and L_RELAX_X_OFFSET. Lagged Kappa used in the calculation can be
! adjusted with LAGGED_KAPPA_SCALE_L_RELAX_X. Fz used in the calculation can be
! adjusted with FZ_SCALE_L_RELAX_X. This configurable function supports 8 datasets;
! if indices shown below are not used, e.g., (1,1,2), the current values of the
! indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading data.
