FD_OFFSET(1,1,1)    0 ; N ! [D] Added (after gain) to get damper force
CMP_R_START_FD(1,1,1) 0 ; mm/s ! [D] Subtracted from compression speed
CMP_R_SCALE_FD(1,1,1) 1 ! [D] Divided into (compression speed - CMP_R_START_FD)

