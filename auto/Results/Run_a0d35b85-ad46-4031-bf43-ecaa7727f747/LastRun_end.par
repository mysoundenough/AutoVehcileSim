CMP_START_F_JNC_STOP(1,2,1) 0 ; mm ! [D] Subtracted from suspension travel at jounce
                              ! stop
CMP_SCALE_F_JNC_STOP(1,2,1) 1 ! [D] Divided into (suspension travel at jounce stop -
