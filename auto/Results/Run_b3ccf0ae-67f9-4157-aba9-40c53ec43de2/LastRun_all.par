ENTER_PARSFILE Generic\VS_commands\GenVS_6b92c0b5-79ff-406d-8d50-ee114adc33e5.par
#FullDataName Generic VS Commands`Measured Aero Coeff. (Incl. Trailer)`Virtual Wind Tunnel
define_output Cd_VWT = -Fx_Air/(AREA_AERO(1)*D_AIR*Vwind^2/2); -; Drag coefficient
define_output Cs_VWT = -Fy_Air/(AREA_AERO(1)*D_AIR*Vwind^2/2); -; Side coefficient
define_output Cl_VWT = Fz_Air/(AREA_AERO(1)*D_AIR*Vwind^2/2); -; Lift coefficient
define_output Cr_VWT = Mx_Air/(AREA_AERO(1)*L_REF_AERO(1)*D_AIR*Vwind^2/2); -; Roll coefficient
define_output Cp_VWT = -My_Air/(AREA_AERO(1)*L_REF_AERO(1)*D_AIR*Vwind^2/2); -; Pitch coefficient
define_output Cy_VWT = -Mz_Air/(AREA_AERO(1)*L_REF_AERO(1)*D_AIR*Vwind^2/2); -; Yaw coefficient
define_output Cd_Input = FX_AERO_SHAPING(0, BetaAir, 1); -; Drag coefficient
define_output Cs_Input = FY_AERO_SHAPING(0, BetaAir, 1); -; Side coefficient
define_output Cl_Input = FZ_AERO_SHAPING(0, BetaAir, 1); -; Lift coefficient
define_output Cr_Input = MX_AERO_SHAPING(0, BetaAir, 1); -; Roll coefficient
define_output Cp_Input = MY_AERO_SHAPING(0, BetaAir, 1); -; Pitch coefficient
define_output Cy_Input = Mz_AERO_SHAPING(0, BetaAir, 1); -; Yaw coefficient
define_output Cd_VWT_2 = -Fx_Air_2/(AREA_AERO(2)*D_AIR*Vwind^2/2); -; Drag coefficient
define_output Cs_VWT_2 = -Fy_Air_2/(AREA_AERO(2)*D_AIR*Vwind^2/2); -; Side coefficient
define_output Cl_VWT_2 = Fz_Air_2/(AREA_AERO(2)*D_AIR*Vwind^2/2); -; Lift coefficient
define_output Cr_VWT_2 = Mx_Air_2/(AREA_AERO(2)*L_REF_AERO(2)*D_AIR*Vwind^2/2); -; Roll coefficient
define_output Cp_VWT_2 = -My_Air_2/(AREA_AERO(2)*L_REF_AERO(2)*D_AIR*Vwind^2/2); -; Pitch coefficient
define_output Cy_VWT_2 = -Mz_Air_2/(AREA_AERO(2)*L_REF_AERO(2)*D_AIR*Vwind^2/2); -; Yaw coefficient
define_output Cd_Input_2 = FX_AERO_SHAPING(0, BetaAir2, 2); -; Drag coefficient
define_output Cs_Input_2 = FY_AERO_SHAPING(0, BetaAir2, 2); -; Side coefficient
define_output Cl_Input_2 = FZ_AERO_SHAPING(0, BetaAir2, 2); -; Lift coefficient
define_output Cr_Input_2 = MX_AERO_SHAPING(0, BetaAir2, 2); -; Roll coefficient
define_output Cp_Input_2 = MY_AERO_SHAPING(0, BetaAir2, 2); -; Pitch coefficient
define_output Cy_Input_2 = Mz_AERO_SHAPING(0, BetaAir2, 2); -; Yaw coefficient
define_variable px_g; mm
define_variable py_g; mm
define_variable pz_g; mm
eq_out px_g = X_S2-X_S1; mm
eq_out py_g = Y_S2-Y_S1; mm
eq_out pz_g = Z_S2-Z_S1; mm
define_variable px; mm
define_variable py; mm
define_variable pz; mm
eq_out px = px_g*cos(Pitch)*cos(Yaw) + py_g*sin(Yaw)*cos(Pitch) - pz_g*sin(Pitch);
eq_out py = px_g*(sin(Pitch)*sin(Roll_E)*cos(Yaw) - sin(Yaw)*cos(Roll_E)) + py_g*(sin(Pitch)*sin(Roll_E)*sin(Yaw) + cos(Roll_E)*cos(Yaw)) + pz_g*sin(Roll_E)*cos(Pitch);
eq_out pz = px_g*(sin(Pitch)*cos(Roll_E)*cos(Yaw) + sin(Roll_E)*sin(Yaw)) + py_g*(sin(Pitch)*sin(Yaw)*cos(Roll_E) - sin(Roll_E)*cos(Yaw)) + pz_g*cos(Pitch)*cos(Roll_E);
define_variable fx_trailer; N
define_variable fy_trailer; N
define_variable fz_trailer; N
eq_out fx_trailer = Fx_Air_2*(sin(Pitch)*sin(Pitch_2) + cos(Pitch)*cos(Pitch_2)*cos(Yaw - Yaw_2)) + Fy_Air_2*(-sin(Pitch)*sin(Roll_E_2)*cos(Pitch_2) + sin(Pitch_2)*sin(Roll_E_2)*cos(Pitch)*cos(Yaw - Yaw_2) + sin(Yaw - Yaw_2)*cos(Pitch)*cos(Roll_E_2)) + Fz_Air_2*(-sin(Pitch)*cos(Pitch_2)*cos(Roll_E_2) + sin(Pitch_2)*cos(Pitch)*cos(Roll_E_2)*cos(Yaw - Yaw_2) - sin(Roll_E_2)*sin(Yaw - Yaw_2)*cos(Pitch));
eq_out fy_trailer = Fx_Air_2*(sin(Pitch)*sin(Roll_E)*cos(Pitch_2)*cos(Yaw - Yaw_2) - sin(Pitch_2)*sin(Roll_E)*cos(Pitch) - sin(Yaw - Yaw_2)*cos(Pitch_2)*cos(Roll_E)) + Fy_Air_2*(sin(Pitch)*sin(Pitch_2)*sin(Roll_E)*sin(Roll_E_2)*cos(Yaw - Yaw_2) + sin(Pitch)*sin(Roll_E)*sin(Yaw - Yaw_2)*cos(Roll_E_2) - sin(Pitch_2)*sin(Roll_E_2)*sin(Yaw - Yaw_2)*cos(Roll_E) + sin(Roll_E)*sin(Roll_E_2)*cos(Pitch)*cos(Pitch_2) + cos(Roll_E)*cos(Roll_E_2)*cos(Yaw - Yaw_2)) + Fz_Air_2*(sin(Pitch)*sin(Pitch_2)*sin(Roll_E)*cos(Roll_E_2)*cos(Yaw - Yaw_2) - sin(Pitch)*sin(Roll_E)*sin(Roll_E_2)*sin(Yaw - Yaw_2) - sin(Pitch_2)*sin(Yaw - Yaw_2)*cos(Roll_E)*cos(Roll_E_2) + sin(Roll_E)*cos(Pitch)*cos(Pitch_2)*cos(Roll_E_2) - sin(Roll_E_2)*cos(Roll_E)*cos(Yaw - Yaw_2));
eq_out fz_trailer = Fx_Air_2*(sin(Pitch)*cos(Pitch_2)*cos(Roll_E)*cos(Yaw - Yaw_2) - sin(Pitch_2)*cos(Pitch)*cos(Roll_E) + sin(Roll_E)*sin(Yaw - Yaw_2)*cos(Pitch_2)) + Fy_Air_2*(sin(Pitch)*sin(Pitch_2)*sin(Roll_E_2)*cos(Roll_E)*cos(Yaw - Yaw_2) + sin(Pitch)*sin(Yaw - Yaw_2)*cos(Roll_E)*cos(Roll_E_2) + sin(Pitch_2)*sin(Roll_E)*sin(Roll_E_2)*sin(Yaw - Yaw_2) - sin(Roll_E)*cos(Roll_E_2)*cos(Yaw - Yaw_2) + sin(Roll_E_2)*cos(Pitch)*cos(Pitch_2)*cos(Roll_E)) + Fz_Air_2*(sin(Pitch)*sin(Pitch_2)*cos(Roll_E)*cos(Roll_E_2)*cos(Yaw - Yaw_2) - sin(Pitch)*sin(Roll_E_2)*sin(Yaw - Yaw_2)*cos(Roll_E) + sin(Pitch_2)*sin(Roll_E)*sin(Yaw - Yaw_2)*cos(Roll_E_2) + sin(Roll_E)*sin(Roll_E_2)*cos(Yaw - Yaw_2) + cos(Pitch)*cos(Pitch_2)*cos(Roll_E)*cos(Roll_E_2));
define_variable mx_trailer; N-m
define_variable my_trailer; N-m
define_variable mz_trailer; N-m
eq_out mx_trailer = Mx_Air_2*(sin(Pitch)*sin(Pitch_2) + cos(Pitch)*cos(Pitch_2)*cos(Yaw - Yaw_2)) + My_Air_2*(-sin(Pitch)*sin(Roll_E_2)*cos(Pitch_2) + sin(Pitch_2)*sin(Roll_E_2)*cos(Pitch)*cos(Yaw - Yaw_2) + sin(Yaw - Yaw_2)*cos(Pitch)*cos(Roll_E_2)) + Mz_Air_2*(-sin(Pitch)*cos(Pitch_2)*cos(Roll_E_2) + sin(Pitch_2)*cos(Pitch)*cos(Roll_E_2)*cos(Yaw - Yaw_2) - sin(Roll_E_2)*sin(Yaw - Yaw_2)*cos(Pitch));
eq_out my_trailer = Mx_Air_2*(sin(Pitch)*sin(Roll_E)*cos(Pitch_2)*cos(Yaw - Yaw_2) - sin(Pitch_2)*sin(Roll_E)*cos(Pitch) - sin(Yaw - Yaw_2)*cos(Pitch_2)*cos(Roll_E)) + My_Air_2*(sin(Pitch)*sin(Pitch_2)*sin(Roll_E)*sin(Roll_E_2)*cos(Yaw - Yaw_2) + sin(Pitch)*sin(Roll_E)*sin(Yaw - Yaw_2)*cos(Roll_E_2) - sin(Pitch_2)*sin(Roll_E_2)*sin(Yaw - Yaw_2)*cos(Roll_E) + sin(Roll_E)*sin(Roll_E_2)*cos(Pitch)*cos(Pitch_2) + cos(Roll_E)*cos(Roll_E_2)*cos(Yaw - Yaw_2)) + Mz_Air_2*(sin(Pitch)*sin(Pitch_2)*sin(Roll_E)*cos(Roll_E_2)*cos(Yaw - Yaw_2) - sin(Pitch)*sin(Roll_E)*sin(Roll_E_2)*sin(Yaw - Yaw_2) - sin(Pitch_2)*sin(Yaw - Yaw_2)*cos(Roll_E)*cos(Roll_E_2) + sin(Roll_E)*cos(Pitch)*cos(Pitch_2)*cos(Roll_E_2) - sin(Roll_E_2)*cos(Roll_E)*cos(Yaw - Yaw_2));
eq_out mz_trailer = Mx_Air_2*(sin(Pitch)*cos(Pitch_2)*cos(Roll_E)*cos(Yaw - Yaw_2) - sin(Pitch_2)*cos(Pitch)*cos(Roll_E) + sin(Roll_E)*sin(Yaw - Yaw_2)*cos(Pitch_2)) + My_Air_2*(sin(Pitch)*sin(Pitch_2)*sin(Roll_E_2)*cos(Roll_E)*cos(Yaw - Yaw_2) + sin(Pitch)*sin(Yaw - Yaw_2)*cos(Roll_E)*cos(Roll_E_2) + sin(Pitch_2)*sin(Roll_E)*sin(Roll_E_2)*sin(Yaw - Yaw_2) - sin(Roll_E)*cos(Roll_E_2)*cos(Yaw - Yaw_2) + sin(Roll_E_2)*cos(Pitch)*cos(Pitch_2)*cos(Roll_E)) + Mz_Air_2*(sin(Pitch)*sin(Pitch_2)*cos(Roll_E)*cos(Roll_E_2)*cos(Yaw - Yaw_2) - sin(Pitch)*sin(Roll_E_2)*sin(Yaw - Yaw_2)*cos(Roll_E) + sin(Pitch_2)*sin(Roll_E)*sin(Yaw - Yaw_2)*cos(Roll_E_2) + sin(Roll_E)*sin(Roll_E_2)*cos(Yaw - Yaw_2) + cos(Pitch)*cos(Pitch_2)*cos(Roll_E)*cos(Roll_E_2));
define_variable fx_total; N
define_variable fy_total; N
define_variable fz_total; N
eq_out fx_total = Fx_Air + fx_trailer;
eq_out fy_total = Fy_Air + fy_trailer;
eq_out fz_total = Fz_Air + fz_trailer;
define_variable mx_total; N
define_variable my_total; N
define_variable mz_total; N
eq_out mx_total = Mx_Air + mx_trailer - pz*fy_trailer + py*fz_trailer;
eq_out my_total = My_Air + my_trailer + pz*fx_trailer - px*fz_trailer;
eq_out mz_total = Mz_Air + mz_trailer - py*fx_trailer + px*fy_trailer;
define_output Cd_Total = -fx_total/(AREA_AERO(1)*D_AIR*Vwind^2/2); -; Drag coefficient
define_output Cs_Total = -fy_total/(AREA_AERO(1)*D_AIR*Vwind^2/2); -; Side coefficient
define_output Cl_Total = fz_total/(AREA_AERO(1)*D_AIR*Vwind^2/2); -; Lift coefficient
define_output Cr_Total = mx_total/(AREA_AERO(1)*L_REF_AERO(1)*D_AIR*Vwind^2/2); -; Roll coefficient
define_output Cp_Total = -my_total/(AREA_AERO(1)*L_REF_AERO(1)*D_AIR*Vwind^2/2); -; Pitch coefficient
define_output Cy_Total = -mz_total/(AREA_AERO(1)*L_REF_AERO(1)*D_AIR*Vwind^2/2); -; Yaw coefficient
ENTER_PARSFILE Plot\Setup\Plot_fa0b5796-0893-462c-bb0f-66be8427b69e.par
