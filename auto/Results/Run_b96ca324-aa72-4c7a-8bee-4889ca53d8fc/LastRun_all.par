Z_PROFILE_CONSTANT(2) 0 ; mm ! [D] Elevation increment
Z_PROFILE_OFFSET(2) 0 ; mm ! [D] Added to get elevation increment
DEFINE_PARAMETER Z_TABLE_PAR = 100; mm ; Location of K&C table reference
DEFINE_PARAMETER K_FIXTURE_XY = 100000; N/mm ; Stiffness of chassis clamps
DEFINE_PARAMETER C_FIXTURE_XY = 100; N-s/mm ; Damping of chassis clamps
DEFINE_PARAMETER K_FIXTURE_Z = 100000; N/mm ; Stiffness of chassis clamps
DEFINE_PARAMETER C_FIXTURE_Z = 100; N-s/mm ; Damping of chassis clamps
DEFINE_PARAMETER H_WC_GAIN = 0.01; - ; Control gain for ground
DEFINE_PARAMETER H_TOL = 1e-09; mm ; Tolerance on wheel center location
DEFINE_PARAMETER GND_Z_AT_DESIGN_L1 = 0.0237969; m ; Ground Z at design load
DEFINE_PARAMETER GND_Z_AT_DESIGN_R1 = 0.0237969; m ; Ground Z at design load
DEFINE_PARAMETER GND_Z_AT_DESIGN_L2 = 0.00270609; m ; Ground Z at design load
DEFINE_PARAMETER GND_Z_AT_DESIGN_R2 = 0.00270609; m ; Ground Z at design load
DEFINE_OUTPUT x_kc = -1.433; m ; Location of K&C table reference
DEFINE_OUTPUT y_kc = 0; m ; Location of K&C table reference
DEFINE_OUTPUT z_kc = 0.1; m ; Location of K&C table reference
DEFINE_OUTPUT roll_kc = 0; deg ; Location of K&C table reference
DEFINE_OUTPUT pitch_kc = 0; deg ; Location of K&C table reference
DEFINE_OUTPUT yaw_kc = 0; deg ; Location of K&C table reference
DEFINE_OUTPUT x_clamp_l1 = 6.80696e-13; mm ; Clamp location
DEFINE_OUTPUT y_clamp_l1 = 775; mm ; Clamp location
DEFINE_OUTPUT z_clamp_l1 = -2.83362e-05; mm ; Clamp location
DEFINE_OUTPUT vx_clamp_l1 = -7.02702e-14; m/s ; Clamp deflection rate
DEFINE_OUTPUT vy_clamp_l1 = 8.3362e-19; m/s ; Clamp deflection rate
DEFINE_OUTPUT vz_clamp_l1 = -5.31787e-14; m/s ; Clamp deflection rate
DEFINE_OUTPUT x_clamp_r1 = 6.80697e-13; mm ; Clamp location
DEFINE_OUTPUT y_clamp_r1 = -775; mm ; Clamp location
DEFINE_OUTPUT z_clamp_r1 = -2.83362e-05; mm ; Clamp location
DEFINE_OUTPUT vx_clamp_r1 = -7.02701e-14; m/s ; Clamp deflection rate
DEFINE_OUTPUT vy_clamp_r1 = 8.3362e-19; m/s ; Clamp deflection rate
DEFINE_OUTPUT vz_clamp_r1 = -5.31809e-14; m/s ; Clamp deflection rate
DEFINE_OUTPUT x_clamp_l2 = -2866; mm ; Clamp location
DEFINE_OUTPUT y_clamp_l2 = 775; mm ; Clamp location
DEFINE_OUTPUT z_clamp_l2 = 8.37154e-07; mm ; Clamp location
DEFINE_OUTPUT vx_clamp_l2 = -7.02702e-14; m/s ; Clamp deflection rate
DEFINE_OUTPUT vy_clamp_l2 = 5.88179e-19; m/s ; Clamp deflection rate
DEFINE_OUTPUT vz_clamp_l2 = 8.8935e-14; m/s ; Clamp deflection rate
DEFINE_OUTPUT x_clamp_r2 = -2866; mm ; Clamp location
DEFINE_OUTPUT y_clamp_r2 = -775; mm ; Clamp location
DEFINE_OUTPUT z_clamp_r2 = 8.37154e-07; mm ; Clamp location
DEFINE_OUTPUT vx_clamp_r2 = -7.02701e-14; m/s ; Clamp deflection rate
DEFINE_OUTPUT vy_clamp_r2 = 5.88179e-19; m/s ; Clamp deflection rate
DEFINE_OUTPUT vz_clamp_r2 = 8.89328e-14; m/s ; Clamp deflection rate
DEFINE_OUTPUT err_l1 = 9.92706e-10; mm ; Wheel center position error L1
DEFINE_OUTPUT err_r1 = 9.9265e-10; mm ; Wheel center position error R1
DEFINE_OUTPUT err_l2 = 2.22045e-12; mm ; Wheel center position error L2
DEFINE_OUTPUT err_r2 = 2.22045e-12; mm ; Wheel center position error R2
EQ_IN IMP_FX_RP_1 = -K_FIXTURE_XY*X_CLAMP_L1 + -C_FIXTURE_XY*VX_CLAMP_L1;
EQ_IN IMP_FY_RP_1 = -K_FIXTURE_XY*(Y_CLAMP_L1 -(L_TRACK(1)/2)) + -C_FIXTURE_XY*VY_CLAMP_L1;
EQ_IN IMP_FX_RP_2 = -K_FIXTURE_XY*X_CLAMP_R1 + -C_FIXTURE_XY*VX_CLAMP_R1;
EQ_IN IMP_FY_RP_2 = -K_FIXTURE_XY*(Y_CLAMP_R1 + L_TRACK(1)/2) + -C_FIXTURE_XY*VY_CLAMP_R1;
EQ_IN IMP_FX_RP_3 = -K_FIXTURE_XY*(X_CLAMP_L2 + LX_AXLE(2)) + -C_FIXTURE_XY*VX_CLAMP_L2;
EQ_IN IMP_FY_RP_3 = -K_FIXTURE_XY*(Y_CLAMP_L2 -(L_TRACK(2)/2)) + -C_FIXTURE_XY*VY_CLAMP_L2;
EQ_IN IMP_FX_RP_4 = -K_FIXTURE_XY*(X_CLAMP_R2 + LX_AXLE(2)) + -C_FIXTURE_XY*VX_CLAMP_R2;
EQ_IN IMP_FY_RP_4 = -K_FIXTURE_XY*(Y_CLAMP_R2 + L_TRACK(2)/2) + -C_FIXTURE_XY*VY_CLAMP_R2;
EQ_IN IMP_FZ_RP_1 = -K_FIXTURE_Z*Z_CLAMP_L1 + -C_FIXTURE_Z*VZ_CLAMP_L1;
EQ_IN IMP_FZ_RP_2 = -K_FIXTURE_Z*Z_CLAMP_R1 + -C_FIXTURE_Z*VZ_CLAMP_R1;
EQ_IN IMP_FZ_RP_3 = -K_FIXTURE_Z*Z_CLAMP_L2 + -C_FIXTURE_Z*VZ_CLAMP_L2;
EQ_IN IMP_FZ_RP_4 = -K_FIXTURE_Z*Z_CLAMP_R2 + -C_FIXTURE_Z*VZ_CLAMP_R2;
EQ_OUT X_KC = -LX_AXLE(2)/2;
EQ_OUT Z_KC = Z_TABLE_PAR;
EQ_OUT X_CLAMP_L1 = X_RP1;
EQ_OUT Y_CLAMP_L1 = Y_RP1;
EQ_OUT Z_CLAMP_L1 = Z_RP1;
EQ_OUT VX_CLAMP_L1 = VX_S1;
EQ_OUT VY_CLAMP_L1 = VY_S1;
EQ_OUT VZ_CLAMP_L1 = VZ_S1;
EQ_OUT X_CLAMP_R1 = X_RP2;
EQ_OUT Y_CLAMP_R1 = Y_RP2;
EQ_OUT Z_CLAMP_R1 = Z_RP2;
EQ_OUT VX_CLAMP_R1 = VX_S2;
EQ_OUT VY_CLAMP_R1 = VY_S2;
EQ_OUT VZ_CLAMP_R1 = VZ_S2;
EQ_OUT X_CLAMP_L2 = X_RP3;
EQ_OUT Y_CLAMP_L2 = Y_RP3;
EQ_OUT Z_CLAMP_L2 = Z_RP3;
EQ_OUT VX_CLAMP_L2 = VX_S3;
EQ_OUT VY_CLAMP_L2 = VY_S3;
EQ_OUT VZ_CLAMP_L2 = VZ_S3;
EQ_OUT X_CLAMP_R2 = X_RP4;
EQ_OUT Y_CLAMP_R2 = Y_RP4;
EQ_OUT Z_CLAMP_R2 = Z_RP4;
EQ_OUT VX_CLAMP_R2 = VX_S4;
EQ_OUT VY_CLAMP_R2 = VY_S4;
EQ_OUT VZ_CLAMP_R2 = VZ_S4;
EQ_OUT ERR_L1 = ABS(H_WC(1,1) -Z_L1);
EQ_OUT ERR_R1 = ABS(H_WC(1,2) -Z_R1);
EQ_OUT ERR_L2 = ABS(H_WC(2,1) -Z_L2);
EQ_OUT ERR_R2 = ABS(H_WC(2,2) -Z_R2);
SV_ABS_ON_OFF_L1    1 ; - ! ABS state: 1 -> apply brake, 0 -> release, wheel L1
SV_ABS_ON_OFF_L2    1 ; - ! ABS state: 1 -> apply brake, 0 -> release, wheel L2
SV_ABS_ON_OFF_R1    1 ; - ! ABS state: 1 -> apply brake, 0 -> release, wheel L1
SV_ABS_ON_OFF_R2    1 ; - ! ABS state: 1 -> apply brake, 0 -> release, wheel L2
SV_AERO_ROAD_ID_1   1 ; - ! Road surface ID for tracked aero road point
SV_AERO_ROAD_STA_1 -1.433156571 ; m ! Road path station for tracked aero road point
SV_AVX 8.11100444e-17 ; deg/s ! ODE: Body-X roll rate of sprung-mass {AVx}
SV_AVY 2.841073111e-12 ; deg/s ! ODE: Body-Y pitch rate of sprung-mass {AVy}
SV_AVY_L1 3.606556114e-13 ; rpm ! ODE: Spin of wheel L1 {AVy_L1}
SV_AVY_L1_OLD 3.606556114e-13 ; rpm ! Spin of wheel L1 (previous time step)
SV_AVY_L2 -6.129863014e-14 ; rpm ! ODE: Spin of wheel L2 {AVy_L2}
SV_AVY_L2_OLD -6.129863014e-14 ; rpm ! Spin of wheel L2 (previous time step)
SV_AVY_R1 3.606262314e-13 ; rpm ! ODE: Spin of wheel R1 {AVy_R1}
SV_AVY_R1_OLD 3.606262314e-13 ; rpm ! Spin of wheel R1 (previous time step)
SV_AVY_R2 -6.130872635e-14 ; rpm ! ODE: Spin of wheel R2 {AVy_R2}
SV_AVY_R2_OLD -6.130872635e-14 ; rpm ! Spin of wheel R2 (previous time step)
SV_AVZ 4.906737164e-18 ; deg/s ! ODE: Body-Z yaw rate of sprung-mass {AVz}
SV_AV_COL_CONTROL   0 ; deg/s ! ODE: Steering wheel angular rate
SV_AV_SW            0 ; deg/s ! ODE: Steering wheel angular rate {StrAV_SW}
SV_AX_SC            0 ; g ! SC acceleration command when OPT_SC = 5
SV_A_CONTROL        0 ; deg ! ODE: Str whl angle from driver model in torque control
SV_BETA   179.9992832 ; deg ! Sideslip (ISO)
SV_BETA_RD 179.9992832 ; deg ! Sideslip using road axes
SV_CMP_S_L1 41.29466182 ; mm ! Compression of ride spring L1
SV_CMP_S_L2 39.80942078 ; mm ! Compression of ride spring L2
SV_CMP_S_R1 41.29466182 ; mm ! Compression of ride spring R1
SV_CMP_S_R2 39.80942078 ; mm ! Compression of ride spring R2
SV_CONTACT_ID_L1    1 ; - ! Road surface ID for tire contact {RdID_L1}
SV_CONTACT_ID_L2    1 ; - ! Road surface ID for tire contact {RdID_L2}
SV_CONTACT_ID_R1    1 ; - ! Road surface ID for tire contact {RdID_R1}
SV_CONTACT_ID_R2    1 ; - ! Road surface ID for tire contact {RdID_R2}
SV_CONTACT_STA_L1 0.04500000415 ; m ! Road path station for tire contact {S_Rd_L1}
SV_CONTACT_STA_L2 -2.820999997 ; m ! Road path station for tire contact {S_Rd_L2}
SV_CONTACT_STA_R1 0.04500000415 ; m ! Road path station for tire contact {S_Rd_R1}
SV_CONTACT_STA_R2 -2.820999997 ; m ! Road path station for tire contact {S_Rd_R2}
SV_DZDX_GND         0 ; - ! dZ/dX of ground at vehicle aero ref. pt (saved)
SV_DZDX_L1          0 ; - ! Ground X slope under tire L1 (saved)
SV_DZDX_L2          0 ; - ! Ground X slope under tire L2 (saved)
SV_DZDX_R1          0 ; - ! Ground X slope under tire R1 (saved)
SV_DZDX_R2          0 ; - ! Ground X slope under tire R2 (saved)
SV_DZDY_GND         0 ; - ! dZ/dY of ground at vehicle aero ref. pt (saved)
SV_DZDY_L1          0 ; - ! Ground Y slope under tire L1  (saved)
SV_DZDY_L2          0 ; - ! Ground Y slope under tire L2  (saved)
SV_DZDY_R1          0 ; - ! Ground Y slope under tire R1  (saved)
