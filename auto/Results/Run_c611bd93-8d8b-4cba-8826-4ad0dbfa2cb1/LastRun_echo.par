 20, -0.085893
 30, -0.129828
 40, -0.174396
 50, -0.21954
 60, -0.265153
 70, -0.311062
ENDTABLE
SUSP_DIVE_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get suspension dive
SUSP_DIVE_OFFSET(1,2) 0 ; deg ! [D] Added (after gain) to get suspension dive
JNC_START_SUSP_DIVE(1,2) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_SUSP_DIVE(1,2) 1 ! [D] Divided into (jounce - JNC_START_SUSP_DIVE)
SUSP_DIVE_COMBINE(1,2) ADD ! How to combine the two components
SET_UNITS SUSP_DIVE_JNC_OTHER_SIDE_TABLE(1,2) deg ;
SUSP_DIVE_JNC_OTHER_SIDE_CONSTANT(1,2) 0 ; deg ! Suspension dive component due to
                                         ! jounce (other side), axle 1, right side

SUSP_DIVE_COEFFICIENT(2,1) 0 ! Suspension dive per unit jounce (deg/mm), axle 2,
                             ! left side
SUSP_DIVE_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get suspension dive
SUSP_DIVE_OFFSET(2,1) 0 ; deg ! [D] Added (after gain) to get suspension dive
JNC_START_SUSP_DIVE(2,1) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_SUSP_DIVE(2,1) 1 ! [D] Divided into (jounce - JNC_START_SUSP_DIVE)
SUSP_DIVE_COMBINE(2,1) MULTIPLY ! [D] How to combine the two components
SUSP_DIVE_JNC_OTHER_SIDE_CONSTANT(2,1) 1 ; - ! [D] Suspension dive component due to
                                         ! jounce (other side), axle 2, left side

SUSP_DIVE_COEFFICIENT(2,2) 0 ! Suspension dive per unit jounce (deg/mm), axle 2,
                             ! right side
SUSP_DIVE_GAIN(2,2) 1 ! [D] Multiplied with calculated value to get suspension dive
SUSP_DIVE_OFFSET(2,2) 0 ; deg ! [D] Added (after gain) to get suspension dive
JNC_START_SUSP_DIVE(2,2) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_SUSP_DIVE(2,2) 1 ! [D] Divided into (jounce - JNC_START_SUSP_DIVE)
SUSP_DIVE_COMBINE(2,2) MULTIPLY ! [D] How to combine the two components
SUSP_DIVE_JNC_OTHER_SIDE_CONSTANT(2,2) 1 ; - ! [D] Suspension dive component due to
                                         ! jounce (other side), axle 2, right side

! SUSP_LAT: Suspension Lateral movement inward of unsteered wheel (measured at zero
! steer). Lateral movement inward of unsteered wheel can be a nonlinear CARPET
! function of jounce (other side) and jounce or a function of jounce (CONSTANT,
! COEFFICIENT, or TABLE) combined with a function SUSP_LAT_JNC_OTHER_SIDE of jounce
! (other side) (CONSTANT, COEFFICIENT, or TABLE). Lateral movement inward of
! unsteered wheel from the calculation can be adjusted with SUSP_LAT_GAIN and
! SUSP_LAT_OFFSET. Jounce used in the calculation can be adjusted with
! JNC_SCALE_SUSP_LAT and JNC_START_SUSP_LAT. Jounce (other side) used in the
! calculation can be adjusted with JNC2_SCALE_SUSP_LAT and JNC2_START_SUSP_LAT. The
! derivative of this function is used internally. This configurable function supports
! 4 datasets; if indices shown below are not used, e.g., (1,2), the current values of
! the indices IAXLE and ISIDE are used to identify the dataset when reading data.

! Col 1 = jounce (mm), col 2 = Lateral movement inward of unsteered wheel (mm)
