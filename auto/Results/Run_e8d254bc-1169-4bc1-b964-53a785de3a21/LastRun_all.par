WRITE_SENSOR_DETECT
Title Pickup Hauler - Car 1: DLC <Multiple Vehicles, Parallel Solvers>
CATEGORY Multiple Vehicles, Parallel Solvers
DATASET_TITLE Pickup Hauler - Car 1: DLC
SPEED_TARGET_CONSTANT 0
eq_in pbk_con_constant if(t>32, 0, 3000000)
eq_in speed_target_constant if(t>32, 50/3.6, 0)
define_parameter WriteStart = 50;
define_parameter WriteStop = 65;
