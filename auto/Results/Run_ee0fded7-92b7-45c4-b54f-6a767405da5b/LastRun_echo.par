                        ! steer
STEER_KIN_OFFSET(1,2,2) 0 ; deg ! [D] Added (after gain) to get road wheel steer

! STEER_SW: Open loop steering wheel angle as a function of time. Steering wheel
! angle is a function of time (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a
! custom equation can be defined at runtime. Steering wheel angle from the
! calculation can be adjusted with STEER_SW_GAIN and STEER_SW_OFFSET. Time used in
! the calculation can be adjusted with TSCALE_STEER and TSTART_STEER.

STEER_SW_CONSTANT   0 ; deg ! Steering wheel angle
STEER_SW_OFFSET     0 ; deg ! [D] Added to get steering wheel angle

! SUSP_AXLE_ROLL_STEER: Suspension roll steer. Steer can be a nonlinear CARPET
! function of jounce and roll or a function of roll (CONSTANT, COEFFICIENT, or TABLE)
! combined with a function SUSP_AXLE_JNC_STEER of jounce (CONSTANT, COEFFICIENT, or
! TABLE). Steer from the calculation can be adjusted with SUSP_AXLE_ROLL_STEER_GAIN
! and SUSP_AXLE_ROLL_STEER_OFFSET. Roll used in the calculation can be adjusted with
! ROLL_SCALE_AXLE_STEER and ROLL_START_AXLE_STEER. Jounce used in the calculation can
! be adjusted with JNC_SCALE_AXLE_STEER and JNC_START_AXLE_STEER. The derivative of
! this function is used internally. This configurable function supports 3 datasets;
! if indices shown below are not used, e.g., (1,2), the current values of the indices
! IUNIT and IAXLE are used to identify the dataset when reading data.

! Col 1 = roll (deg), col 2 = steer (deg)
SUSP_AXLE_ROLL_STEER_TABLE(1,2) SPLINE ! unit 1, axle 2
 -10, -1
 0, 0
 10, 2
ENDTABLE
SUSP_AXLE_ROLL_STEER_GAIN(1,2) 1 ! [D] Multiplied with calculated value to get steer
SUSP_AXLE_ROLL_STEER_OFFSET(1,2) 0 ; deg ! [D] Added (after gain) to get steer
ROLL_START_AXLE_STEER(1,2) 0 ; deg ! [D] Subtracted from roll
ROLL_SCALE_AXLE_STEER(1,2) 1 ! [D] Divided into (roll - ROLL_START_AXLE_STEER)
SUSP_AXLE_ROLL_STEER_COMBINE(1,2) MULTIPLY ! How to combine the two components
SUSP_AXLE_JNC_STEER_CONSTANT(1,2) 1 ; - ! Steer component due to jounce, unit 1,
                                    ! axle 2

SUSP_AXLE_ROLL_STEER_COEFFICIENT(2,1) -0.1 ! Steer per unit roll (deg/deg), unit 2,
                                           ! axle 1
SUSP_AXLE_ROLL_STEER_GAIN(2,1) 1 ! [D] Multiplied with calculated value to get steer
SUSP_AXLE_ROLL_STEER_OFFSET(2,1) 0 ; deg ! [D] Added (after gain) to get steer
ROLL_START_AXLE_STEER(2,1) 0 ; deg ! [D] Subtracted from roll
ROLL_SCALE_AXLE_STEER(2,1) 1 ! [D] Divided into (roll - ROLL_START_AXLE_STEER)
SUSP_AXLE_ROLL_STEER_COMBINE(2,1) MULTIPLY ! [D] How to combine the two components
SUSP_AXLE_JNC_STEER_CONSTANT(2,1) 1 ; - ! [D] Steer component due to jounce, unit 2,
                                    ! axle 1

