! THROTTLE_ENGINE: Normalized open-loop throttle request. Normalized throttle
! request is a function of time (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a
! custom equation can be defined at runtime. Normalized throttle request from the
! calculation can be adjusted with THROTTLE_ENGINE_GAIN and THROTTLE_ENGINE_OFFSET.
! Time used in the calculation can be adjusted with TSCALE_THROTTLE and
! TSTART_THROTTLE.

THROTTLE_ENGINE_CONSTANT 0.5 ; - ! Normalized throttle request
THROTTLE_ENGINE_GAIN 1 ! [D] Multiplied with calculated value to get normalized
                       ! throttle request
THROTTLE_ENGINE_OFFSET 0 ; - ! [D] Added to get normalized throttle request

! TOE: Suspension toe (measured at zero steer). Toe can be a nonlinear CARPET
! function of jounce (other side) and jounce or a function of jounce (CONSTANT,
! COEFFICIENT, or TABLE) combined with a function SUSP_TOE_JNC_OTHER_SIDE of jounce
! (other side) (CONSTANT, COEFFICIENT, or TABLE). Toe from the calculation can be
! adjusted with TOE_GAIN and TOE_OFFSET. Jounce used in the calculation can be
! adjusted with JNC_SCALE_TOE and JNC_START_TOE. Jounce (other side) used in the
! calculation can be adjusted with JNC2_SCALE_TOE and JNC2_START_TOE. The derivative
! of this function is used internally. This configurable function supports 6
! datasets; if indices shown below are not used, e.g., (1,1,2), the current values of
! the indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading
! data.

! Col 1 = jounce (mm), col 2 = toe (deg)
TOE_TABLE(1,1,1) SPLINE ! unit 1, axle 1, left side
 -70, 0.292407
 -60, 0.237822
 -50, 0.187561
 -40, 0.141604
 -30, 0.099916
 -20, 0.062452
 -10, 0.029164
 0, 0
 10, -0.025093
 20, -0.046165
 30, -0.063264
 40, -0.076429
 50, -0.085696
 60, -0.091086
 70, -0.09261
ENDTABLE
TOE_GAIN(1,1,1)     1 ! [D] Multiplied with calculated value to get toe
TOE_OFFSET(1,1,1)   0 ; deg ! [D] Added (after gain) to get toe
JNC_START_TOE(1,1,1) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_TOE(1,1,1) 1 ! [D] Divided into (jounce - JNC_START_TOE)
TOE_COMBINE(1,1,1) ADD ! How to combine the two components
SET_UNITS SUSP_TOE_JNC_OTHER_SIDE_TABLE(1,1,1) deg ;
SUSP_TOE_JNC_OTHER_SIDE_CONSTANT(1,1,1) 0 ; deg ! Toe component due to jounce (other
                                          ! side), unit 1, axle 1, left side

! Col 1 = jounce (mm), col 2 = toe (deg)
TOE_TABLE(1,1,2) SPLINE ! unit 1, axle 1, right side
 -70, 0.292407
 -60, 0.237822
 -50, 0.187561
 -40, 0.141604
 -30, 0.099916
 -20, 0.062452
 -10, 0.029164
 0, 0
 10, -0.025093
 20, -0.046165
 30, -0.063264
 40, -0.076429
 50, -0.085696
 60, -0.091086
 70, -0.09261
ENDTABLE
TOE_GAIN(1,1,2)     1 ! [D] Multiplied with calculated value to get toe
TOE_OFFSET(1,1,2)   0 ; deg ! [D] Added (after gain) to get toe
JNC_START_TOE(1,1,2) 0 ; mm ! [D] Subtracted from jounce
JNC_SCALE_TOE(1,1,2) 1 ! [D] Divided into (jounce - JNC_START_TOE)
TOE_COMBINE(1,1,2) ADD ! How to combine the two components
SET_UNITS SUSP_TOE_JNC_OTHER_SIDE_TABLE(1,1,2) deg ;
SUSP_TOE_JNC_OTHER_SIDE_CONSTANT(1,1,2) 0 ; deg ! Toe component due to jounce (other
                                          ! side), unit 1, axle 1, right side

! UPSHIFT_TRANS: Transmission speed when upshift occurs. IGEAR specifies the lower
! gear for each table (e.g., IGEAR 2 means upshift from 2 to 3). Transmission speed
! is a function of throttle position (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. Transmission speed from
! the calculation can be adjusted with UPSHIFT_TRANS_GAIN and UPSHIFT_TRANS_OFFSET.
! Throttle position used in the calculation can be adjusted with
! THROTTLE_SCALE_UPSHIFT and THROTTLE_START_UPSHIFT. This configurable function
! supports 17 datasets; if indices shown below are not used, e.g., (2), the current
! value of the index IGEAR is used to identify the dataset when reading data.

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
UPSHIFT_TRANS_TABLE(1) LINEAR_FLAT ! shifting between gears 1 and 2
 0, 331
 0.2, 331
 0.8, 1277
 1, 1277
ENDTABLE
UPSHIFT_TRANS_GAIN(1) 1 ! [D] Multiplied with calculated value to get transmission
                        ! speed
UPSHIFT_TRANS_OFFSET(1) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_UPSHIFT(1) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_UPSHIFT(1) 1 ! [D] Divided into (throttle position -
                            ! THROTTLE_START_UPSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
UPSHIFT_TRANS_TABLE(2) LINEAR_FLAT ! shifting between gears 2 and 3
 0, 426
 0.2, 426
 0.8, 2188
 1, 2188
ENDTABLE
UPSHIFT_TRANS_GAIN(2) 1 ! [D] Multiplied with calculated value to get transmission
                        ! speed
UPSHIFT_TRANS_OFFSET(2) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_UPSHIFT(2) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_UPSHIFT(2) 1 ! [D] Divided into (throttle position -
                            ! THROTTLE_START_UPSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
UPSHIFT_TRANS_TABLE(3) LINEAR_FLAT ! shifting between gears 3 and 4
 0, 600
 0.2, 600
 0.8, 2809
 1, 2809
ENDTABLE
UPSHIFT_TRANS_GAIN(3) 1 ! [D] Multiplied with calculated value to get transmission
                        ! speed
UPSHIFT_TRANS_OFFSET(3) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_UPSHIFT(3) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_UPSHIFT(3) 1 ! [D] Divided into (throttle position -
                            ! THROTTLE_START_UPSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
UPSHIFT_TRANS_TABLE(4) LINEAR_FLAT ! shifting between gears 4 and 5
 0, 845
 0.2, 845
 0.8, 3960
 1, 3960
ENDTABLE
UPSHIFT_TRANS_GAIN(4) 1 ! [D] Multiplied with calculated value to get transmission
                        ! speed
UPSHIFT_TRANS_OFFSET(4) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_UPSHIFT(4) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_UPSHIFT(4) 1 ! [D] Divided into (throttle position -
                            ! THROTTLE_START_UPSHIFT)

! Col 1 = throttle position (-), col 2 = transmission speed (rpm)
UPSHIFT_TRANS_TABLE(5) LINEAR_FLAT ! shifting between gears 5 and 6
 0, 984
 0.2, 984
 0.8, 5577
 1, 5577
ENDTABLE
UPSHIFT_TRANS_GAIN(5) 1 ! [D] Multiplied with calculated value to get transmission
                        ! speed
UPSHIFT_TRANS_OFFSET(5) 0 ; rpm ! [D] Added (after gain) to get transmission speed
THROTTLE_START_UPSHIFT(5) 0 ; - ! [D] Subtracted from throttle position
THROTTLE_SCALE_UPSHIFT(5) 1 ! [D] Divided into (throttle position -
                            ! THROTTLE_START_UPSHIFT)

! WIND_HEADING: Wind heading (yaw) relative to global X. When vehicle yaw is zero,
! then 0 deg -> tailwind, 90 deg -> from right, 180 deg -> headwind. Heading can be a
! nonlinear CARPET function of station and time or a function of time (CONSTANT,
! COEFFICIENT, or TABLE) combined with a function WIND_HEADING_S of station
! (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be defined
! at runtime. Heading from the calculation can be adjusted with WIND_HEADING_GAIN and
! WIND_HEADING_OFFSET. Time used in the calculation can be adjusted with
! TSCALE_WIND_HD and TSTART_WIND_HD. Station used in the calculation can be adjusted
! with SSCALE_WIND_HD and SSTART_WIND_HD.

WIND_HEADING_CONSTANT 0 ; deg ! [D] Heading component due to time
WIND_HEADING_GAIN   1 ! [D] Multiplied with calculated value to get heading
WIND_HEADING_OFFSET 0 ; deg ! [D] Added to get heading
WIND_HEADING_COMBINE MULTIPLY ! [D] How to combine the two components
WIND_HEADING_S_CONSTANT 1 ; - ! [D] Heading component due to station

! WIND_SPEED: Absolute wind speed. Wind speed can be a nonlinear CARPET function of
! station and time or a function of time (CONSTANT, COEFFICIENT, or TABLE) combined
! with a function WIND_SPEED_S of station (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. Wind speed from the
! calculation can be adjusted with WIND_SPEED_GAIN and WIND_SPEED_OFFSET. Time used
! in the calculation can be adjusted with TSCALE_WIND and TSTART_WIND. Station used
! in the calculation can be adjusted with SSCALE_WIND and SSTART_WIND.

WIND_SPEED_CONSTANT 0 ; km/h ! [D] Wind speed component due to time
WIND_SPEED_GAIN     1 ! [D] Multiplied with calculated value to get wind speed
WIND_SPEED_OFFSET   0 ; km/h ! [D] Added to get wind speed
WIND_SPEED_COMBINE MULTIPLY ! [D] How to combine the two components
WIND_SPEED_S_CONSTANT 1 ; - ! [D] Wind speed component due to station

! Z_PROFILE: "Wandering profile" (roughness input). Elevation increment is a
! function of distance travelled (CONSTANT or TABLE). Elevation increment from the
! calculation can be adjusted with Z_PROFILE_GAIN and Z_PROFILE_OFFSET. Distance
! travelled used in the calculation can be adjusted with SSCALE_Z_PROFILE and
! SSTART_Z_PROFILE. The derivative of this function is used internally. This
! configurable function supports 2 datasets; if indices shown below are not used,
! e.g., (2), the current value of the index ISIDE is used to identify the dataset
! when reading data.

Z_PROFILE_CONSTANT(1) 0 ; mm ! [D] Elevation increment
Z_PROFILE_OFFSET(1) 0 ; mm ! [D] Added to get elevation increment

Z_PROFILE_CONSTANT(2) 0 ; mm ! [D] Elevation increment
Z_PROFILE_OFFSET(2) 0 ; mm ! [D] Added to get elevation increment

!------------------------------------------------------------------------------------
! NEW VARIABLES DEFINED AT RUN TIME
!------------------------------------------------------------------------------------
DEFINE_PARAMETER WRITE_ALL = 0; - ;
DEFINE_PARAMETER INIT_DONE = 0; - ;
DEFINE_PARAMETER SLOW_STEER_DONE = 0; - ;
DEFINE_PARAMETER SWA_REF = 0; deg ; SWA for 0.3 g's
DEFINE_PARAMETER SWA_SIGN = 1; - ;
DEFINE_PARAMETER VTEST_MAX = 50; mi/h ; Max test velocity
DEFINE_PARAMETER VTEST = 50; mi/h ;
DEFINE_PARAMETER VINC = 1; mi/h ;
DEFINE_PARAMETER ROLL_RATE_CHECK = 1.5; deg/s ;
DEFINE_PARAMETER VLIMIT_L = 0; mi/h ;
DEFINE_PARAMETER VLIMIT_R = 0; mi/h ;
DEFINE_PARAMETER TM_LEN_REF = 0.06; m ; Reference length for tire mark rectangles
DEFINE_PARAMETER TM_SCALE = 0.1; - ; Tire mark darkness scale

DEFINE_VARIABLE FZ_TOT = 43982.8; N ; Vehicle mass multiplied by G

DEFINE_OUTPUT FZ_L = 19209.4; - ; FZ_L 
DEFINE_OUTPUT FZ_R = 19209.4; - ; FZ_R 
DEFINE_OUTPUT VYaw_L1 = 180.017; deg ; Tire mark L1 yaw 
DEFINE_OUTPUT TmLen_L1 = 0; m ; Tire mark L1  length 
DEFINE_OUTPUT TmDarkL1 = 0; - ; Tire mark L1 darkness 
DEFINE_OUTPUT VYaw_L2 = 180; deg ; Tire mark L2 yaw 
DEFINE_OUTPUT TmLen_L2 = 0; m ; Tire mark L2  length 
DEFINE_OUTPUT TmDarkL2 = 0; - ; Tire mark L2 darkness 
DEFINE_OUTPUT VYaw_L3 = 180; deg ; Tire mark L3 yaw 
DEFINE_OUTPUT TmLen_L3 = 0; m ; Tire mark L3  length 
DEFINE_OUTPUT TmDarkL3 = 0; - ; Tire mark L3 darkness 
DEFINE_OUTPUT VYaw_R1 = 179.983; deg ; Tire mark R1 yaw 
DEFINE_OUTPUT TmLen_R1 = 0; m ; Tire mark R1  length 
DEFINE_OUTPUT TmDarkR1 = 0; - ; Tire mark R1 darkness 
DEFINE_OUTPUT VYaw_R2 = 180; deg ; Tire mark R2 yaw 
DEFINE_OUTPUT TmLen_R2 = 0; m ; Tire mark R2  length 
DEFINE_OUTPUT TmDarkR2 = 0; - ; Tire mark R2 darkness 
DEFINE_OUTPUT VYaw_R3 = 180; deg ; Tire mark R3 yaw 
DEFINE_OUTPUT TmLen_R3 = 0; m ; Tire mark R3  length 
DEFINE_OUTPUT TmDarkR3 = 0; - ; Tire mark R3 darkness 

!------------------------------------------------------------------------------------
! INITIALIZATION EQUATIONS (APPLIED JUST AFTER INITIALIZATION)
!------------------------------------------------------------------------------------
EQ_INIT FZ_TOT = (M_TL(1) + M_TL(2))*G;

!------------------------------------------------------------------------------------
! EQUATIONS OUT (AFTER DYNAMICS)
!------------------------------------------------------------------------------------
EQ_OUT FZ_L = FZ_L1 + FZ_L2;
EQ_OUT FZ_R = FZ_R1 + FZ_R2;
EQ_OUT VYAW_L1 = IF(VXCENL1 > 0, YAW_L1 + ALPHA_L1, PI + YAW_L1 -ALPHA_L1);
EQ_OUT TMLEN_L1 = SQRT(VYTC_L1^2 + VXCENL1^2)*TM_LEN_REF;
EQ_OUT TMDARKL1 = MIN(1, TM_SCALE*FZ_L1/FZ_TOT*SQRT((VXCENL1 -VX_L1)^2 + VYTC_L1^2));
EQ_OUT VYAW_L2 = IF(VXCENL2 > 0, YAW_L2 + ALPHA_L2, PI + YAW_L2 -ALPHA_L2);
EQ_OUT TMLEN_L2 = SQRT(VYTC_L2^2 + VXCENL2^2)*TM_LEN_REF;
EQ_OUT TMDARKL2 = MIN(1, TM_SCALE*FZ_L2/FZ_TOT*SQRT((VXCENL2 -VX_L2)^2 + VYTC_L2^2));
EQ_OUT VYAW_L3 = IF(VXCENL3 > 0, YAW_L3 + ALPHA_L3, PI + YAW_L3 -ALPHA_L3);
EQ_OUT TMLEN_L3 = SQRT(VYTC_L3^2 + VXCENL3^2)*TM_LEN_REF;
EQ_OUT TMDARKL3 = MIN(1, TM_SCALE*FZ_L3/FZ_TOT*SQRT((VXCENL3 -VX_L3)^2 + VYTC_L3^2));
EQ_OUT VYAW_R1 = IF(VXCENR1 > 0, YAW_R1 + ALPHA_R1, PI + YAW_R1 -ALPHA_R1);
EQ_OUT TMLEN_R1 = SQRT(VYTC_R1^2 + VXCENR1^2)*TM_LEN_REF;
EQ_OUT TMDARKR1 = MIN(1, TM_SCALE*FZ_R1/FZ_TOT*SQRT((VXCENR1 -VX_R1)^2 + VYTC_R1^2));
EQ_OUT VYAW_R2 = IF(VXCENR2 > 0, YAW_R2 + ALPHA_R2, PI + YAW_R2 -ALPHA_R2);
EQ_OUT TMLEN_R2 = SQRT(VYTC_R2^2 + VXCENR2^2)*TM_LEN_REF;
EQ_OUT TMDARKR2 = MIN(1, TM_SCALE*FZ_R2/FZ_TOT*SQRT((VXCENR2 -VX_R2)^2 + VYTC_R2^2));
EQ_OUT VYAW_R3 = IF(VXCENR3 > 0, YAW_R3 + ALPHA_R3, PI + YAW_R3 -ALPHA_R3);
EQ_OUT TMLEN_R3 = SQRT(VYTC_R3^2 + VXCENR3^2)*TM_LEN_REF;
EQ_OUT TMDARKR3 = MIN(1, TM_SCALE*FZ_R3/FZ_TOT*SQRT((VXCENR3 -VX_R3)^2 + VYTC_R3^2));

!------------------------------------------------------------------------------------
! EVENTS
!------------------------------------------------------------------------------------
! Each event is defined with a formula and an optional pathname for a parsfile to
! read if the specified formula is not zero. If no pathname is specified and the
! specified formula is not zero, then the run stops.
SET_EVENT_ID 0
DEFINE_EVENT VX > 22.2222; Events\Events_f0085771-0c61-4aad-be3a-1843ce02cd1f.par ! ID 0
DEFINE_EVENT INIT_DONE; Events\Events_491832b9-0178-41d1-9090-683cf90e1c82.par ! ID 0
DEFINE_EVENT SLOW_STEER_DONE; Events\Events_709edbcc-6812-4629-9d36-16dedb024adc.par ! ID 0


END
