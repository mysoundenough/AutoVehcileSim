! L_CONTACT_X: Tire/ground contact length. Tire contact length is a function of tire
! compression (CONSTANT or TABLE). Alternatively, a custom equation can be defined at
! runtime. Tire contact length from the calculation can be adjusted with
! L_CONTACT_X_GAIN and L_CONTACT_X_OFFSET. Tire compression used in the calculation
! can be adjusted with CMP_SCALE_L_CONTACT_X. This configurable function supports 6
! datasets; if indices shown below are not used, e.g., (1,1,2), the current values of
! the indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading
! data.

L_CONTACT_X_CONSTANT(1,1,1) 85 ; mm ! Tire contact length, unit 1, axle 1, left side
L_CONTACT_X_GAIN(1,1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(1,1,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(1,1,2) 85 ; mm ! Tire contact length, unit 1, axle 1, right
                               ! side
L_CONTACT_X_GAIN(1,1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(1,1,2) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(1,2,1) 85 ; mm ! Tire contact length, unit 1, axle 2, left side
L_CONTACT_X_GAIN(1,2,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(1,2,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(1,2,2) 85 ; mm ! Tire contact length, unit 1, axle 2, right
                               ! side
L_CONTACT_X_GAIN(1,2,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(1,2,2) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(2,1,1) 70 ; mm ! Tire contact length, unit 2, axle 1, left side
L_CONTACT_X_GAIN(2,1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(2,1,1) 0 ; mm ! [D] Added to get tire contact length

L_CONTACT_X_CONSTANT(2,1,2) 70 ; mm ! Tire contact length, unit 2, axle 1, right
                               ! side
L_CONTACT_X_GAIN(2,1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! length
L_CONTACT_X_OFFSET(2,1,2) 0 ; mm ! [D] Added to get tire contact length

! L_CONTACT_Y: Tire/ground contact width. Tire contact width is a function of tire
! compression (CONSTANT or TABLE). Alternatively, a custom equation can be defined at
! runtime. Tire contact width from the calculation can be adjusted with
! L_CONTACT_Y_GAIN and L_CONTACT_Y_OFFSET. Tire compression used in the calculation
! can be adjusted with CMP_SCALE_L_CONTACT_Y. This configurable function supports 6
! datasets; if indices shown below are not used, e.g., (1,1,2), the current values of
! the indices IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading
! data.

L_CONTACT_Y_CONSTANT(1,1,1) 265 ; mm ! Tire contact width, unit 1, axle 1, left side
L_CONTACT_Y_GAIN(1,1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(1,1,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(1,1,2) 265 ; mm ! Tire contact width, unit 1, axle 1, right
                                ! side
L_CONTACT_Y_GAIN(1,1,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(1,1,2) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(1,2,1) 265 ; mm ! Tire contact width, unit 1, axle 2, left side
L_CONTACT_Y_GAIN(1,2,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(1,2,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(1,2,2) 265 ; mm ! Tire contact width, unit 1, axle 2, right
                                ! side
L_CONTACT_Y_GAIN(1,2,2) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(1,2,2) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(2,1,1) 175 ; mm ! Tire contact width, unit 2, axle 1, left side
L_CONTACT_Y_GAIN(2,1,1) 1 ! [D] Multiplied with calculated value to get tire contact
                          ! width
L_CONTACT_Y_OFFSET(2,1,1) 0 ; mm ! [D] Added to get tire contact width

L_CONTACT_Y_CONSTANT(2,1,2) 175 ; mm ! Tire contact width, unit 2, axle 1, right
