FY_TIRE_GAIN(2,1,2) 1 ! [D] Multiplied with calculated value to get Fy
FY_TIRE_OFFSET(2,1,2) 0 ; N ! [D] Added (after gain) to get Fy
ALPHA_START_FY_TIRE(2,1,2) 0 ; deg ! [D] Subtracted from Alpha
ALPHA_SCALE_FY_TIRE(2,1,2) 1 ! [D] Divided into (Alpha - ALPHA_START_FY_TIRE)
FZ_START_FY_TIRE(2,1,2) 0 ; N ! [D] Subtracted from Fz
FZ_SCALE_FY_TIRE(2,1,2) 1 ! [D] Divided into (Fz - FZ_START_FY_TIRE)

! FZ_AERO_SHAPING: Coefficient CFZ for for Z component of aerodynamic force. CFZ is
! a function of aerodynamic slip angle (CONSTANT, COEFFICIENT, or TABLE).
! Alternatively, a custom equation can be defined at runtime. CFZ from the
! calculation can be adjusted with FZ_AERO_SHAPING_GAIN and FZ_AERO_SHAPING_OFFSET.
! Aerodynamic slip angle used in the calculation can be adjusted with
! SLIP_SCALE_FZ_AERO and SLIP_START_FZ_AERO. This configurable function supports 2
! datasets; if indices shown below are not used, e.g., (2), the current value of the
! index IUNIT is used to identify the dataset when reading data.

! Col 1 = aerodynamic slip angle (deg), col 2 = CFZ (-)
FZ_AERO_SHAPING_TABLE(1) SPLINE_FLAT ! spline interpolation, flat-line extrapolation
 -180, 0.4
 -135, 0.45
 -90, 0.35
 -20, 0.185
 0, 0.18
 20, 0.185
 90, 0.35
 135, 0.45
 180, 0.4
ENDTABLE
FZ_AERO_SHAPING_GAIN(1) 1 ! [D] Multiplied with calculated value to get CFZ
FZ_AERO_SHAPING_OFFSET(1) 0 ; - ! [D] Added (after gain) to get CFZ
SLIP_START_FZ_AERO(1) 0 ; deg ! [D] Subtracted from aerodynamic slip angle
SLIP_SCALE_FZ_AERO(1) 1 ! [D] Divided into (aerodynamic slip angle -
                        ! SLIP_START_FZ_AERO)

FZ_AERO_SHAPING_CONSTANT(2) 0 ; - ! CFZ
FZ_AERO_SHAPING_OFFSET(2) 0 ; - ! [D] Added to get CFZ

! FZ_AERO_SHAPING_2: Coefficient CFZ2 for Z component of aerodynamic force. CFZ2 can
! be a nonlinear CARPET function of ride height and pitch or a function of pitch
! (CONSTANT, COEFFICIENT, or TABLE) combined with a function FZ_AERO_SHAPING_Z of
! ride height (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can
! be defined at runtime. CFZ2 from the calculation can be adjusted with
! FZ_AERO_SHAPING_2_GAIN and FZ_AERO_SHAPING_2_OFFSET. Pitch used in the calculation
! can be adjusted with PITCH_SCALE_FZ_AERO and PITCH_START_FZ_AERO. Ride height used
! in the calculation can be adjusted with Z_SCALE_FZ_AERO and Z_START_FZ_AERO.

FZ_AERO_SHAPING_2_CONSTANT 1 ; - ! [D] CFZ2 component due to pitch
FZ_AERO_SHAPING_2_GAIN 1 ! [D] Multiplied with calculated value to get CFZ2
FZ_AERO_SHAPING_2_OFFSET 0 ; - ! [D] Added to get CFZ2
FZ_AERO_SHAPING_2_COMBINE MULTIPLY ! [D] How to combine the two components
FZ_AERO_SHAPING_Z_CONSTANT 1 ; - ! [D] CFZ2 component due to ride height

! FZ_TIRE: Tire vertical force. Vertical force is a function of tire compression
! (COEFFICIENT or TABLE). Vertical force from the calculation can be adjusted with
! FZ_TIRE_GAIN and FZ_TIRE_OFFSET. Tire compression used in the calculation can be
! adjusted with CMP_SCALE_FZ_TIRE and CMP_START_FZ_TIRE. An inverse version of this
! function is used internally. This configurable function supports 6 datasets; if
! indices shown below are not used, e.g., (1,1,2), the current values of the indices
! IUNIT, IAXLE, and ISIDE are used to identify the dataset when reading data.

FZ_TIRE_COEFFICIENT(1,1,1) 502 ! Vertical force per unit tire compression (N/mm),
                               ! unit 1, axle 1, left side
FZ_TIRE_GAIN(1,1,1) 1 ! [D] Multiplied with calculated value to get vertical force
FZ_TIRE_OFFSET(1,1,1) 0 ; N ! [D] Added (after gain) to get vertical force
CMP_START_FZ_TIRE(1,1,1) 0 ; mm ! [D] Subtracted from tire compression
CMP_SCALE_FZ_TIRE(1,1,1) 1 ! [D] Divided into (tire compression - CMP_START_FZ_TIRE)

FZ_TIRE_COEFFICIENT(1,1,2) 502 ! Vertical force per unit tire compression (N/mm),
                               ! unit 1, axle 1, right side
FZ_TIRE_GAIN(1,1,2) 1 ! [D] Multiplied with calculated value to get vertical force
FZ_TIRE_OFFSET(1,1,2) 0 ; N ! [D] Added (after gain) to get vertical force
CMP_START_FZ_TIRE(1,1,2) 0 ; mm ! [D] Subtracted from tire compression
CMP_SCALE_FZ_TIRE(1,1,2) 1 ! [D] Divided into (tire compression - CMP_START_FZ_TIRE)

FZ_TIRE_COEFFICIENT(1,2,1) 502 ! Vertical force per unit tire compression (N/mm),
                               ! unit 1, axle 2, left side
FZ_TIRE_GAIN(1,2,1) 1 ! [D] Multiplied with calculated value to get vertical force
FZ_TIRE_OFFSET(1,2,1) 0 ; N ! [D] Added (after gain) to get vertical force
CMP_START_FZ_TIRE(1,2,1) 0 ; mm ! [D] Subtracted from tire compression
CMP_SCALE_FZ_TIRE(1,2,1) 1 ! [D] Divided into (tire compression - CMP_START_FZ_TIRE)

FZ_TIRE_COEFFICIENT(1,2,2) 502 ! Vertical force per unit tire compression (N/mm),
                               ! unit 1, axle 2, right side
FZ_TIRE_GAIN(1,2,2) 1 ! [D] Multiplied with calculated value to get vertical force
FZ_TIRE_OFFSET(1,2,2) 0 ; N ! [D] Added (after gain) to get vertical force
CMP_START_FZ_TIRE(1,2,2) 0 ; mm ! [D] Subtracted from tire compression
CMP_SCALE_FZ_TIRE(1,2,2) 1 ! [D] Divided into (tire compression - CMP_START_FZ_TIRE)

FZ_TIRE_COEFFICIENT(2,1,1) 230 ! Vertical force per unit tire compression (N/mm),
                               ! unit 2, axle 1, left side
FZ_TIRE_GAIN(2,1,1) 1 ! [D] Multiplied with calculated value to get vertical force
FZ_TIRE_OFFSET(2,1,1) 0 ; N ! [D] Added (after gain) to get vertical force
CMP_START_FZ_TIRE(2,1,1) 0 ; mm ! [D] Subtracted from tire compression
CMP_SCALE_FZ_TIRE(2,1,1) 1 ! [D] Divided into (tire compression - CMP_START_FZ_TIRE)

FZ_TIRE_COEFFICIENT(2,1,2) 230 ! Vertical force per unit tire compression (N/mm),
                               ! unit 2, axle 1, right side
FZ_TIRE_GAIN(2,1,2) 1 ! [D] Multiplied with calculated value to get vertical force
FZ_TIRE_OFFSET(2,1,2) 0 ; N ! [D] Added (after gain) to get vertical force
CMP_START_FZ_TIRE(2,1,2) 0 ; mm ! [D] Subtracted from tire compression
CMP_SCALE_FZ_TIRE(2,1,2) 1 ! [D] Divided into (tire compression - CMP_START_FZ_TIRE)

! F_JNC_STOP: Jounce stop force. Force is a function of suspension travel at jounce
! stop (CONSTANT, COEFFICIENT, or TABLE). Alternatively, a custom equation can be
! defined at runtime. Force from the calculation can be adjusted with F_JNC_STOP_GAIN
! and F_JNC_STOP_OFFSET. Suspension travel at jounce stop used in the calculation can
! be adjusted with CMP_SCALE_F_JNC_STOP and CMP_START_F_JNC_STOP. This configurable
! function supports 6 datasets; if indices shown below are not used, e.g., (1,1,2),
! the current values of the indices IUNIT, IAXLE, and ISIDE are used to identify the
! dataset when reading data.

! Col 1 = suspension travel at jounce stop (mm), col 2 = force (N)
F_JNC_STOP_TABLE(1,1,1) LINEAR ! unit 1, axle 1, left side
 148, 0
 149, 0
 150, 10000
ENDTABLE
F_JNC_STOP_GAIN(1,1,1) 1 ! [D] Multiplied with calculated value to get force
F_JNC_STOP_OFFSET(1,1,1) 0 ; N ! [D] Added (after gain) to get force
CMP_START_F_JNC_STOP(1,1,1) 0 ; mm ! [D] Subtracted from suspension travel at jounce
                              ! stop
CMP_SCALE_F_JNC_STOP(1,1,1) 1 ! [D] Divided into (suspension travel at jounce stop -
                              ! CMP_START_F_JNC_STOP)

