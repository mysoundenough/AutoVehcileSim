HITCH_DMP_Y         0 ; N-m-s/deg ! [D] Pitch damping coefficient, hitch
HITCH_DMP_Z         0 ; N-m-s/deg ! [D] Articulation damping coefficient, hitch
HITCH_FRIC_X        0 ; N-m ! [D] Roll friction, hitch
HITCH_FRIC_Y        0 ; N-m ! [D] Pitch friction, hitch
HITCH_FRIC_Z        0 ; N-m ! [D] Articulation friction, hitch
HITCH_FREQ         40 ; Hz ! [D] Natural frequency of XYZ springs in hitch [I]
HITCH_ZETA        0.1 ; - ! [D] Damping ratio of XYZ dampers in hitch [I]
