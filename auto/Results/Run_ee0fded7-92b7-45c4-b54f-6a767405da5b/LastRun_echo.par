! ISPIN(1,1,2)   5.49 ; kg-m2 ! CALC -- Spin inertia for wheel + tire R1 [I]
! ISPIN_XXZZ(1,1,1) 2.96 ; kg-m2 ! CALC -- IXX/IZZ inertia for wheel + tire L1 [I]
! ISPIN_XXZZ(1,1,2) 2.96 ; kg-m2 ! CALC -- IXX/IZZ inertia for wheel + tire R1 [I]
IW(1,1,1)        2.69 ; kg-m2 ! Spin inertia for wheel L1 [I]
IW(1,1,2)        2.69 ; kg-m2 ! Spin inertia for wheel R1 [I]
IW_XXZZ(1,1,1)   1.36 ; kg-m2 ! IXX/IZZ inertia for wheel L1 [I]
IW_XXZZ(1,1,2)   1.36 ; kg-m2 ! IXX/IZZ inertia for wheel R1 [I]
JNC_DESIGN(1,1,1)   0 ; mm ! Jounce when center of wheel L1 is at the reference
                      ! coordinate H_WC [I]
JNC_DESIGN(1,1,2)   0 ; mm ! Jounce when center of wheel R1 is at H_WC [I]
L_TRACK(1,1)     1550 ; mm ! Track width, wheel-center to wheel-center, axle 1 [I]
