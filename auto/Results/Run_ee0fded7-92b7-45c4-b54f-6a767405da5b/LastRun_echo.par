M_US_IND(1,1,1) 19.04 ; kg ! Unsteered suspension mass for wheel L1 [I]
M_US_IND(1,1,2) 19.04 ; kg ! Unsteered suspension mass for wheel R1 [I]
M_US_STR(1,1,1) 44.46 ; kg ! Steered mass for wheel L1 [I]
M_US_STR(1,1,2) 44.46 ; kg ! Steered mass for wheel R1 [I]
