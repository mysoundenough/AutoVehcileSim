! FZA_L(2,1) 5543.715681 ; N ! CALC -- Static ground load, laden, axle 3
! FZA_UL(2,1) 3831.660862 ; N ! CALC -- Static ground load, unladen, axle 3
! FZ_STATIC(2,1,1) 2771.85784 ; N ! CALC -- Static ground force, laden, wheel L3
! FZ_STATIC(2,1,2) 2771.85784 ; N ! CALC -- Static ground force, laden, wheel R3
