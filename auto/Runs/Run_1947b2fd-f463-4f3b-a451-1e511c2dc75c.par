#BlueLink23 CarSim Run Control`DLC, Preview Speed Control` Driver Model` , Overlay run or ERD file`Run_3c0b0556-bee4-4b58-b62a-723cb72a4e75


*IMAGE_TYPE PASS_THROUGH
*IMAGE_PASS_THROUGH Animator\Vehicles\AniVeh_4ce91de0-b4f4-4075-a4a9-d4fc5b973de3.png
WRITE_SENSOR_DETECT
Title PID Ctrl, Built-in Differentiator <Extended Models>
CATEGORY Extended Models 
DATASET_TITLE PID Ctrl, Built-in Differentiator
#MiscYellow0
IMPORT IMP_THROTTLE_ENGINE ADD
define_parameter Setpoint 48; km/h
eq_in IMP_THROTTLE_ENGINE = PID_CONTROLLER(Vxz_fwd, Setpoint, 1.8, 0.5, 0.2, 1)
IMPORT IMP_STEER_SW REPLACE
DEFINE_OUTPUT Custom_StrAV
EQ_IN IMP_STEER_SW = 0.5* sin(0.5 * T)
EQ_OUT Custom_StrAV = DIFFERENTIATE(STEER_SW)
#ENDMYellow

#RingCtrl8 1
NUM_CACHED_RUNS 1
#RingCtrl9 

#EMBEDDED_NOTES
#A D-Class sedan drives on a test pad while slowly turning the wheel.
#
#This run exists to demonstrate both the generic PID controller and differentiator within VS Commands. The sedan's throttle is controlled with a PID controller to maintain a constant speed of 48 km/h. The steering wheel angle is overriden with an import variable, and a differentiator is used to get the derivative of this user supplied signal.
#END_EMBEDDED_NOTES

