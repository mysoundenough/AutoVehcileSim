Title Two Flat Tires (User-defined 2D Arrays) <Extended Models>
CATEGORY Extended Models 
DATASET_TITLE Two Flat Tires (User-defined 2D Arrays)
#MiscYellow0
define_variable TIRE_PRESSURE(2,2)
eq_init TIRE_PRESSURE(1,2) = 268000
eq_init TIRE_PRESSURE(2,1) = 268000
eq_init TIRE_PRESSURE(1,1) = 268000
eq_init TIRE_PRESSURE(2,2) = 268000

BEGIN_FUNCTION update_tire_pressure(t, begt, endt )
define_local retval = 0 
retval = if(t<begt,268000,(268000-(t*70000)))
retval = if(retval < 30000,30000,retval)
return retval
END_FUNCTION

eq_dyn TIRE_PRESSURE(1,1) = update_tire_pressure(t,1,5)
eq_dyn TIRE_PRESSURE(2,1) = update_tire_pressure(t,1,5)
eq_dyn FZ_TIRE_COEFFICIENT(1,1) = TIRE_PRESSURE(1,1)
eq_dyn FZ_TIRE_COEFFICIENT(1,2) = TIRE_PRESSURE(1,2)
eq_dyn FZ_TIRE_COEFFICIENT(2,1) = TIRE_PRESSURE(2,1)
eq_dyn FZ_TIRE_COEFFICIENT(2,2) = TIRE_PRESSURE(2,2)
#ENDMYellow

#RingCtrl8 1
NUM_CACHED_RUNS 1
#RingCtrl9 

#EMBEDDED_NOTES
#This example simulates two flat tires, which begin to lose pressure after one second.  It makes use of a user-defined two-dimensional
#array.
#
#The result is compared with the baseline example used in the CarSim Quick Start Guide (see Help -> Guides and Tutorials).
#END_EMBEDDED_NOTES

