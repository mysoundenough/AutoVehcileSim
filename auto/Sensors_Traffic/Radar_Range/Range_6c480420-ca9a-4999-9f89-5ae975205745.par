PARSFILE
#FullDataName Sensor Range and Bearing Sensitivity`80-m Range, 2.5-m Bearing`Sensor Range w/ Equations
#CheckBox0 1    

#RingCtrl0 EQUATION
#RadioCtrl0 0    
#RadioCtrl1 0    

#MiscYellow0
RANGE_LIMIT_SENSOR = 80
#ENDMYellow

SENSOR_ANTENNA_RANGE_EQUATION (X*COS(XCOL) < RANGE_LIMIT_SENSOR) & (X*ABS(SIN(XCOL)) < 2.5)
SENSOR_ANTENNA_BEARING_CONSTANT 1
*SCALAR 1
*SCALAR2 1
*EQUATION (X*COS(XCOL) < RANGE_LIMIT_SENSOR) & (X*ABS(SIN(XCOL)) < 2.5)


#EMBEDDED_NOTES
#The parameter RANGE_LIMIT_SENSOR limits the polar distance in order to speed up calculations.
#END_EMBEDDED_NOTES

