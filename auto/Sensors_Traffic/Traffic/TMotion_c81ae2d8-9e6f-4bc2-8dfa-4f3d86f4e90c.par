PARSFILE
#FullDataName Multiple Moving Objects`1 Veh., ACC Euro NCAP: Cut-Out`Traffic Vehicles (Forward)
#RingCtrl0 1
DEFINE_MOVING_OBJECTS 1
#RingCtrl1 2
#RingCtrl2 1
#RingCtrl4 1
#CheckBox0 0    
#CheckBox1 1    
#CheckBox2 1    
#CheckBox25 1    
#CheckBox26 0    
#CheckBox38 1    
#CheckBox39 1    

DZ_OBJECT 0
#MiscYellow0
#!the SPEED_TARGET_ID is set in the ego vehicle speed controller Dataset
#! Lead vehicle
#ENDMYellow

*L CUT_OUT_LTARG_PROF
*LEAD 100
*TRAIL 50
*HIDE 10
*PATH_ID PATH_ID_DM
*ROAD_ID CURRENT_ROAD_ID
*V CUT_OUT_VEH_SPD_PROF

IOBJECT_INCREMENT
symbol_add <<o>> 1
SET_DESCRIPTION OBJECT_NAME 1 Veh., ACC Euro NCAP: Cut-Out
OPT_SPEED_OBJ 2
OPT_DIR_OBJ 1
!the SPEED_TARGET_ID is set in the ego vehicle speed controller Dataset
! Lead vehicle
*L_WB_1 3.2
L_WB_OBJ 3.2
EQ_INIT HEADO_<<o>> = 0
#RingCtrl4 1
PATH_ID_OBJ PATH_ID_DM
ROAD_ID_OBJ CURRENT_ROAD_ID
OPT_RECYCLE_OBJ 0
*SINIT_1 CUT_OUT_VEH_SSTART
EQ_INIT S_OBJ_<<o>> = CUT_OUT_VEH_SSTART
SPEED_ID_OBJ = CUT_OUT_VEH_SPD_PROF
LTARG_ID_OBJ = CUT_OUT_LTARG_PROF
EQ_INIT YawO_<<o>> = PATH_YAW_ID(S_OBJ_<<o>>, PATH_ID_DM, LTARG_ID_OBJ, 1) + HEADO_<<o>>
*COLOR_1 0 0.4 0.8
SET_RUN_COLOR 0 0.4 0.8
*H_TARGET_1 -1.5
H_OBJ -1.5
PARSFILE Animator\Vehicles\AniVeh_ecb4bc00-731a-4eec-9e10-b0fa5a9a76b7.par
#BlueLink0 Animator: Vehicles and Sensor Targets`F-Class, Sedan` F-Class` , 3D Shape for Video`AniVeh_ecb4bc00-731a-4eec-9e10-b0fa5a9a76b7

OPT_SHAPE_OBJ 1
SHAPE_TYPE_OBJ 1
DZ_OBJECT 0
*SIZE_1 5.1
LENGTH_OBJ 5.1
*WIDTH_1 1.9
WIDTH_OBJ 1.9
*LX_FRONT_1 0.8
LX_FRONT_OBJ 0.8
*REFLECT_1 1
MATERIAL_TYPE_OBJ 1
UNSET_RUN_COLOR

#EMBEDDED_NOTES
#Use the current path, road, and LTARG dataset.
#
#The three traffic vehicles move at the same speed as the Ego vehicle, with a lead of 15 m, and a spacing of 20 m.
#END_EMBEDDED_NOTES

LOG_ENTRY Used Dataset: Multiple Moving Objects; { Traffic Vehicles (Forward) } 1 Veh., ACC Euro NCAP: Cut-Out
