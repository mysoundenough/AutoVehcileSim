PARSFILE
#FullDataName Vehicle: Trailer with 1 Axle`1A Rental Trailer (Nonzero Aero)`
#VehCode S
IUNIT_INCREMENT
NAXLES 1
IOBJECT_SAVE
symbol_add  <<unit>> 1
symbol_add  <<axle>> 1
#CheckBox1 0    
#CheckBox2 0    

#RingCtrl0 3
#RingCtrl1 1

* Trailer front suspension
iaxle 1
WRITE_ADD_REFERENCE_FRAME_AXLE

PARSFILE Suspensions\Compliance_SA\CmpSA_a86e13b0-109c-49b7-98c3-5ec5d039839d.par
